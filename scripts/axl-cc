#!/bin/bash
# axl-cc — compile C source to UEFI .efi binary
set -euo pipefail

# `cd -P` resolves symlinks physically — when axl-cc is invoked
# through /bin/axl-cc on a distro where /bin is a symlink to
# /usr/bin (Fedora/Arch/etc., usrmerge), plain `cd` preserves the
# logical /bin path and SDK_DIR resolves to / instead of /usr.
# The result is --version printing "unknown" (and worse, missing
# include/lib lookups) under sudo or any other invocation that
# hits the /bin alias.
SCRIPT_DIR="$(cd -P "$(dirname "$0")" && pwd)"
SDK_DIR="$(dirname "$SCRIPT_DIR")"

# Toolchain locations come from ONE file so this driver, the Makefile and the
# GENERATED axl-config.cmake cannot drift -- the same three-build-path split
# check-flag-parity polices for compile flags. It sits beside this script in a
# source tree and under share/axl/ when installed from a package, so try both
# rather than assuming a layout.
#
# Sourcing is best-effort on purpose: a pure-C build must not fail over a
# missing C++ toolchain manifest. The C++ path below errors if the resolved
# compiler is empty, which is where a missing conf actually matters.
for _axl_conf in "$SCRIPT_DIR/axl-toolchains.conf" \
                 "$SDK_DIR/share/axl/axl-toolchains.conf"; do
    if [[ -r "$_axl_conf" ]]; then
        # shellcheck source=/dev/null
        . "$_axl_conf"
        break
    fi
done

# AXL_TOOLCHAIN -- WHICH toolchain supplies the compiler and binutils. Same
# variant the Makefile takes, same two values, deliberately the same spelling:
# a variant one build path understands and the other ignores is precisely the
# drift `make check-flag-parity` exists to catch, one layer up. Every known
# consumer enters through this script rather than the Makefile, so this is the
# copy that actually faces users.
#
#   axl    (default) the toolchains axl-toolchains.conf names.
#   cross  one you supply, via AXL_<ARCH>_GCC / _GXX / _BINUTILS_PREFIX; the
#          conf defaults are NOT consulted, so an unset locator resolves empty
#          and the existing "compiler not found" diagnostic fires by name.
#
# See the Makefile's block for why the pairing exists (Zephyr, EDK2 and the
# Linux kernel all pair a variant with a locator) and why `llvm` is absent
# rather than a silent no-op.
AXL_TOOLCHAIN="${AXL_TOOLCHAIN:-axl}"
case "$AXL_TOOLCHAIN" in
    axl) ;;
    cross)
        AXL_X64_GCC_DEFAULT=""
        AXL_X64_GXX_DEFAULT=""
        AXL_X64_BINUTILS_PREFIX_DEFAULT=""
        AXL_AA64_GCC_DEFAULT=""
        AXL_AA64_GXX_DEFAULT=""
        AXL_AA64_BINUTILS_PREFIX_DEFAULT=""
        ;;
    *)
        echo "ERROR: AXL_TOOLCHAIN=$AXL_TOOLCHAIN is not a toolchain variant." >&2
        echo "       Use 'axl' (the default: the toolchains" >&2
        echo "       axl-install-toolchain installs), or 'cross' (one you" >&2
        echo "       supply, named by AXL_X64_GCC / AXL_AA64_GCC and the" >&2
        echo "       matching _GXX and _BINUTILS_PREFIX)." >&2
        exit 1
        ;;
esac

# The name to print in --help / --version / diagnostics. axl-c++ `exec`s this
# script, and exec leaves $0 as the SCRIPT's path (a #! interpreter takes argv
# from the kernel, so `exec -a` cannot rename it) — so the alias passes its own
# name through the environment instead. Without this, `axl-c++ --help` printed
# "Usage: axl-cc ...", telling the user to run a different command than the one
# they invoked.
AXL_PROG="${AXL_CC_PROGNAME:-$(basename "$0")}"

ARCH="x64"
TYPE="app"
BUILD="release"
RUNTIME="full"
ENTRY=""
OUTPUT=""
VERBOSE=false
# Drop the .eh_frame KEEP and replace __cxa_throw with a diagnose-and-exit.
# ~18% of a C++ image. See the guard below and src/cxxrt/axl-cxxrt-nothrow.cpp.
NO_EH_FRAME=false
RUN=false
RUN_ARGS=()
SOURCES=()
CFLAGS_EXTRA=()
# -std is tracked PER LANGUAGE rather than in the shared CFLAGS_EXTRA. Those
# extras are expanded AFTER the baked-in flags on both compile lines, so a C
# standard passed by the caller used to land on the g++ line as well:
# `g++ -std=c++23 ... -std=gnu2x` draws "valid for C/ObjC but not for C++",
# which -Werror (also forwarded) turns into a hard error. Measured, both.
#
# C deliberately gets NO default here, unlike C++. The library itself is built
# -std=gnu2x, but that does not propagate to consumers and does not need to:
# the public headers compile clean under -std=gnu17 -Wall -Wextra, and the two
# C23 spellings they do use -- `[[nodiscard]]` and `[[noreturn]]` via
# axl-macros.h -- are honoured by gcc as an extension in the older C modes
# (verified: -Wunused-result fires identically under gnu17 and gnu2x). Pinning
# a standard here would instead RISK breaking consumers, since C23 makes bool /
# true / false / nullptr keywords and redefines `()` in a declaration.
STD_C=()
STD_CXX=(-std=c++23)
# Distinguishes a caller-supplied C++ standard from the default above, so the
# reachability check can complain about the former without ever tripping on
# the latter (every pure-C build carries the default).
STD_CXX_SET=false
LDFLAGS_USER=()
EMBEDS=()
SERVICE_NAME=""
# -x c++ / -x c override — when set, ALL subsequent source files are
# compiled with the corresponding compiler regardless of extension
# (mirrors gcc/g++'s -x flag semantics, though we don't reset on
# -x none).  Empty string = dispatch by extension.
FORCE_LANG=""
# -c: compile-only mode (mirrors gcc -c).  When set, each source
# compiles to its own .o (output controlled by -o or auto-derived);
# the link / objcopy / pe-set-debug steps are skipped.  Lets
# consumers build their own .a libraries that then link via a
# subsequent axl-cc invocation.
COMPILE_ONLY=false
# --hosted: REMOVED (T3), and it fails loudly rather than silently. C++ is
# compiled hosted unconditionally now, which is what the flag used to turn on.
#
# The arm below exists only to DIAGNOSE. Dropping it entirely would leave the
# generic "unknown option: --hosted", which tells a caller the flag is not
# recognised and nothing about why it stopped being; four lines buy the reason.
# It is a diagnostic with an expiry, not a compatibility shim -- nothing
# downstream of it reads a HOSTED variable, because there no longer is one.
ALLOW_UEFI=false
# --allow-host-paths: permit -I/-L into the HOST's /usr tree.
#
# Off by default because a UEFI image has no business reaching host headers or
# libraries: the toolchain supplies newlib's, and anything from /usr is built
# for a different libc, a different ABI and an OS that will not be there. The
# failure is not a link error, it is a struct that disagrees at runtime.
#
# An opt-out exists at all for the same reason --allow-uefi does: when a
# consumer genuinely needs it, that intent belongs ON THE BUILD LINE where a
# reviewer sees it, rather than expressed by quietly defeating a check.
ALLOW_HOST_PATHS=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        --arch)     ARCH="$2"; shift 2 ;;
        --type)     TYPE="$2"; shift 2 ;;
        --entry)    ENTRY="$2"; shift 2 ;;
        --debug)    BUILD="debug"; shift ;;
        --release)  BUILD="release"; shift ;;
        --minimal-runtime) RUNTIME="minimal"; shift ;;
        --embed)    EMBEDS+=("$2"); shift 2 ;;
        --service)  SERVICE_NAME="$2"; shift 2 ;;
        --hosted)
            echo "ERROR: --hosted was removed. C++ is compiled hosted" >&2
            echo "       unconditionally now -- the freestanding C++ mode it" >&2
            echo "       switched off no longer exists, so the flag selects" >&2
            echo "       nothing. Delete it from your build; the output is" >&2
            echo "       unchanged. (docs/AXL-Cxx-Design.md 6a-T3)" >&2
            exit 1 ;;
        --allow-uefi) ALLOW_UEFI=true; shift ;;
        --allow-host-paths) ALLOW_HOST_PATHS=true; shift ;;
        -x)         FORCE_LANG="$2"; shift 2 ;;
        -c)         COMPILE_ONLY=true; shift ;;
        --run)      RUN=true; shift
                    # Remaining args after --run are passed to run-qemu.sh
                    while [[ $# -gt 0 ]]; do
                        RUN_ARGS+=("$1"); shift
                    done ;;
        -o)         OUTPUT="$2"; OUTPUT_USER_SET=true; shift 2 ;;
        --no-eh-frame) NO_EH_FRAME=true; shift ;;
        --verbose|-v) VERBOSE=true; shift ;;
        # Linker passthrough (gcc convention). MUST precede -W* below, or
        # -Wl,... is swallowed as a compile flag. -Wl,a,b -> a b to the ld link.
        -Wl,*)
            _wl="${1#-Wl,}"
            IFS=',' read -ra _wlparts <<< "$_wl"
            LDFLAGS_USER+=("${_wlparts[@]}"); shift ;;
        -Xlinker)
            LDFLAGS_USER+=("$2"); shift 2 ;;
        -I|-D|-include)
            CFLAGS_EXTRA+=("$1" "$2"); shift 2 ;;
        -I*|-D*|-W*|-Wno-*)
            CFLAGS_EXTRA+=("$1"); shift ;;
        -std=*)
            # Route by language so a C standard never reaches g++ (and vice
            # versa). Both C++ spellings are `c++NN` / `gnu++NN`.
            case "${1#-std=}" in
                c++*|gnu++*) STD_CXX=("$1"); STD_CXX_SET=true ;;
                *)           STD_C=("$1") ;;
            esac
            shift ;;
        -f*)
            CFLAGS_EXTRA+=("$1"); shift ;;
        # Compiler flags that take a SEPARATE arg token (dependency-file
        # generation). The single-token -M* forms (-MMD/-MD/-MP/-MM/-M/-MG)
        # need no case — the default-forward below sends them to the compiler.
        -MF|-MT|-MQ)
            CFLAGS_EXTRA+=("$1" "$2"); shift 2 ;;
        --version)
            VER=$(cat "$SDK_DIR/share/axl/version" 2>/dev/null || echo "unknown")
            DATE=$(cat "$SDK_DIR/share/axl/build-date" 2>/dev/null || echo "unknown")
            echo "$AXL_PROG $VER (gcc, built $DATE)"
            exit 0 ;;
        -h|--help)
            # Quoted delimiter: the body is literal — an unquoted <<HELP
            # would run the backticked `ar rcs` in the examples as a
            # command substitution (printing ar's usage instead of ours).
            # @PROG@ is substituted afterwards by sed rather than by the shell,
            # so the invoked name reaches the text without giving up that
            # protection.
            cat <<'HELP' | sed "s|@PROG@|$AXL_PROG|g"
@PROG@ -- compile C or C++ source to UEFI binary (.efi)

Usage: @PROG@ [OPTIONS] source.c [source2.cpp ...] [-o output.efi]
       @PROG@ [OPTIONS] source.c --run [run-qemu args...]

Sources are dispatched per file extension: .c → gcc; .cpp / .cc /
.cxx → g++ (with -fno-exceptions -fno-rtti -std=c++23 baked in).
Mixed C/C++ projects work naturally — pass all sources, @PROG@
picks the right compiler per file.  Use -x c++ to force C++ mode
for files with non-standard extensions.

C++ compilation requires the bare-metal toolchain on BOTH arches
(install via `axl-install-toolchain aa64` / `... x64`).
Set AXL_AA64_GXX / AXL_X64_GXX to override either.  @PROG@
auto-appends the toolchain's libstdc++/libsupc++ and AXL's C++
runtime glue when any C++ reaches the link; pure-C builds skip
both.

Toolchain selection (environment, not flags -- the Makefile takes
the same ones, so a consumer build and an SDK build agree):

  AXL_TOOLCHAIN=axl     Default. The toolchain axl-install-toolchain
                        installs, as named by axl-toolchains.conf.
  AXL_TOOLCHAIN=cross   One you supply. The defaults are NOT
                        consulted, so an unset locator is refused by
                        name instead of silently falling back.
  AXL_<ARCH>_GCC        Where it is: the C compiler,
  AXL_<ARCH>_GXX        the C++ compiler, and
  AXL_<ARCH>_BINUTILS_PREFIX   the ld/ar/objcopy prefix.
                        <ARCH> is X64 or AA64.

The toolchain must target BARE METAL. A *-linux-gnu cross resolves
<string.h> to a hosted libc, which no longer has shims to land on.

Options:
  --arch x64|aa64       Target architecture (default: x64)
  --type app|driver|runtime  Image type (default: app)
  --entry NAME          Custom entry point for drivers
  --debug               Debug build (-Og, DWARF, leak tracking)
  --release             Release build (-Os, DWARF, no leak tracking) [default]
  --minimal-runtime     Link against axl-crt0-minimal.o (no registry,
                        no atexit, no signal notify, no default loop).
                        App-type only. See docs/AXL-Lifecycle.md §10.4.
  --embed PATH[=NAME]   Embed an arbitrary binary blob (driver .efi,
                        CA bundle, static config, anything) into the
                        output. Generates the .incbin sidecar and
                        links it. NAME defaults to the basename of
                        PATH with non-identifier chars replaced by '_'.
                        Symbols emitted: axl_embedded_<NAME>{,_end} —
                        match <axl/axl-embed.h>'s AXL_EMBED_DECLARE.
                        Repeatable.
  --service NAME        Single-source-file AxlService build. Compiles
                        the input twice — once as a driver image
                        (-DAXL_SERVICE_BUILD_DRIVER, output
                        NAME-dxe.efi) and once as an app embedding
                        the driver (output NAME.efi). Pair with the
                        AXL_SERVICE(svc) macro in the source. -o is
                        ignored; output goes to NAME{,-dxe}.efi in
                        the current directory.
  --allow-host-paths    Permit -I/-L into the host's /usr tree, and host
                        headers reached from source. OFF by default: a
                        UEFI image cannot use them -- they describe
                        another libc, another ABI and an OS that will
                        not be there, and the failure is a struct that
                        disagrees at runtime rather than a link error.
                        The SDK's own headers and the toolchain's are
                        never affected, wherever they are installed.
  --allow-uefi          Permit <uefi/axl-uefi.h> in an APPLICATION.
                        Raw UEFI is off by default for apps -- the
                        header refuses to compile without it, so
                        reaching EDK2 takes a deliberate flag that is
                        visible on the build line instead of an
                        #include buried in a source file. Drivers
                        (--type driver) are granted it automatically,
                        since implementing a protocol means using that
                        protocol's types. Prefer an axl_* API; if none
                        covers your case, that gap is worth reporting.

  (C++ containers)      std::vector, std::string, std::map and
                        std::unordered_map need no flag -- the --hosted
                        that used to enable them was removed, and
                        passing it is an error. C sources and libaxl.a
                        stay freestanding, and a mixed image links.
                        All four together cost ~14 KB of image.
  (C++ exceptions)      Exceptions are off by default (-fno-exceptions),
                        so a failed allocation or a bad at() HALTS --
                        see axl::arena_allocator for paths that must
                        not. Pass -fexceptions for real try/catch,
                        which works on both arches: there is no
                        --exceptions flag because -fexceptions is a real
                        gcc flag you pass to the compiler anyway, and
                        @PROG@ derives the exceptions-capable link from
                        it (or from an input object referencing
                        __gxx_personality_v0, so a staged -c-then-link
                        build works too).
                        It is off by default because it is not free: an
                        image using the four containers above goes
                        ~61 KB to ~279 KB on x64. A C image pays
                        nothing either way.
                        Callbacks AXL invokes from its own C frames must
                        still not throw -- AXL_CB_NOEXCEPT makes that a
                        compile error. Catch at your own boundary and
                        return a status.
  (C++ RTTI)            Pass -frtti to enable typeid and dynamic_cast.
                        Off by default: the type_info objects cost image
                        size for every polymorphic class. It needs no
                        extra library since P4 -- every C++ link already
                        carries libstdc++/libsupc++, where the type_info
                        vtables and __dynamic_cast live.
  -x LANG               Force language for subsequent sources: 'c' or
                        'c++'. Default is per-file by extension.
  -c                    Compile only; skip the link / objcopy /
                        pe-set-debug steps.  Each source becomes a
                        single .o.  Lets consumers build their own
                        .a libraries (via `ar rcs`) that subsequent
                        @PROG@ invocations link against.  Pre-built
                        .o and .a files passed to @PROG@ are linked
                        straight through (not re-compiled), enabling
                        the same staged-build pattern.
  --run                 Build and run in QEMU (remaining args passed to run-qemu.sh)
  -o FILE               Output filename (default: <source>.efi, or
                        <source>.o with -c)
  -I DIR                Add include search path
  -DNAME[=VALUE]        Define preprocessor macro
  -Wfoo / -Wno-foo      Warning flags
  -ffoo                 Compiler flags
  -std=...              C/C++ standard. Applied to the matching language only,
                        so it is safe in a mixed C/C++ build. C++ defaults to
                        c++23; C is left at the compiler's own default.
  -<flag>               Any other single-dash flag is forwarded to the
                        compiler (C and C++) -- e.g. -O2, -g3, -pedantic, and
                        gcc dependency-generation flags, so incremental
                        builds can emit .d files.
                        USE -MD, NOT -MMD. The SDK's headers arrive via
                        -isystem, and -MMD omits system headers by
                        definition -- so -MMD tracks NOT ONE axl header and
                        editing one silently leaves your object stale.
                        -MD lists them (measured: 292 vs 0). Dependency
                        flags need -c; on a link invocation gcc derives the
                        path from a scratch object axl-cc then deletes.
  -Wl,<opt>[,<opt>...]  Forward option(s) to the linker (ld)
  -Xlinker <opt>        Forward a single option to the linker (ld)
  --no-eh-frame         Drop the unwind tables from a C++ link.
                        Saving = .eh_frame + a constant ~13.5 KB (x64)
                        / ~16.5 KB (aa64) of collected throw path.
                        .eh_frame scales with YOUR code on x64 and is
                        constant (~8.3 KB) on aa64, so expect ~13% at
                        any size on x64 and ~25 KB FLAT on aa64.
                        Measure rather than budget from a percentage.
                        For a C++ image that uses neither exceptions
                        nor iostreams and never needs to CATCH.
                        A throw still halts diagnosably -- it prints
                        the type and what() and exits -- because
                        __cxa_throw is intercepted before the unwinder
                        is entered. Without that interception, dropping
                        the tables does not degrade the message, it
                        takes a CPU fault and WEDGES the machine.
                        REFUSED together with -fexceptions: no catch
                        block could run, and an image whose handlers
                        are silently dead is a correctness failure
                        rather than the size trade this flag offers.
  -v, --verbose         Print compiler/linker commands
  --version             Show version and build info
  -h, --help            Show this help

Examples:
  @PROG@ hello.c -o hello.efi
  @PROG@ hello.cpp -o hello.efi
  @PROG@ --debug hello.c -o hello.efi
  @PROG@ main.cpp legacy.c -o app.efi      # mixed C/C++
  @PROG@ -x c++ hello.c -o hello.efi       # force C++ mode
  @PROG@ hello.c --run
  @PROG@ containers.cpp -o app.efi           # std::vector / map / string
  @PROG@ --embed mydriver.efi=my_driver launch.c -o launch.efi
  @PROG@ --service my-service service.c
  @PROG@ -c lib1.cpp -o lib1.o                 # compile-only
  ar rcs libfoo.a lib1.o lib2.o                # archive your sources
  @PROG@ hello.cpp libfoo.a -o hello.efi       # link against your .a

Toolchain: gcc (C), g++ (C++)
HELP
            # Invoked through the alias, the extension-dispatch text above is
            # only half true — -x c++ is already in effect, so say so rather
            # than leaving the reader to reconcile it.
            if [[ "$AXL_PROG" == "axl-c++" ]]; then
                cat <<'CPPALIAS'

Note: axl-c++ is axl-cc with -x c++ already applied, so EVERY source
compiles as C++ regardless of its extension — the per-extension dispatch
described above does not apply. Use axl-cc for extension-based dispatch
(including mixed C/C++ in one command).
CPPALIAS
            fi
            exit 0 ;;
        # Unknown --long option: an axl-cc typo, not a compiler flag. Fail
        # clearly rather than forwarding it to gcc/ld or treating it as a source.
        --*)
            echo "ERROR: unknown option: $1" >&2
            echo "       (run '$AXL_PROG --help' for $AXL_PROG options)" >&2
            exit 1 ;;
        # Any other single-dash flag we don't consume ourselves is a compiler
        # flag — forward it (matches the gcc/clang driver convention). Covers
        # -O2, -g3, -pedantic, -MMD, -save-temps, ... for both C and C++.
        -?*)
            CFLAGS_EXTRA+=("$1"); shift ;;
        *)      SOURCES+=("$1"); shift ;;
    esac
done

if [[ ${#SOURCES[@]} -eq 0 ]]; then
    echo "Usage: axl-cc [OPTIONS] source.c [-o output.efi]  (try --help)" >&2
    exit 1
fi

for src in "${SOURCES[@]}"; do
    if [[ ! -f "$src" ]]; then
        echo "ERROR: source file not found: $src" >&2
        exit 1
    fi
done

# --service NAME: dual-compile the source into a driver image AND a
# launcher app that embeds it. The source uses AXL_SERVICE(svc) which
# emits DriverEntry under -DAXL_SERVICE_BUILD_DRIVER and main()
# otherwise. axl-cc reinvokes itself twice with appropriate flags.
if [[ -n "$SERVICE_NAME" ]]; then
    # NAME must match the svc identifier passed to AXL_SERVICE(svc) —
    # both sides need to agree on the embed symbol axl_embedded_<NAME>.
    if ! [[ "$SERVICE_NAME" =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]]; then
        echo "ERROR: --service: NAME must be a C identifier (matches the AXL_SERVICE(svc) macro arg): '$SERVICE_NAME'" >&2
        exit 1
    fi
    fwd=("--arch" "$ARCH")
    [[ "$BUILD"   == "debug" ]]   && fwd+=("--debug")
    [[ "$RUNTIME" == "minimal" ]] && fwd+=("--minimal-runtime")
    [[ "$VERBOSE" == "true" ]]    && fwd+=("--verbose")
    [[ "$NO_EH_FRAME" == "true" ]] && fwd+=("--no-eh-frame")
    # --hosted must survive the re-invocation, or `--service NAME --hosted`
    # silently builds both passes freestanding and fails at
    # bits/requires_hosted.h with no mention of the flag the caller passed.
    # --hosted is deliberately NOT forwarded: it is a no-op that prints a
    # notice, so passing it on would print the notice twice for one caller.
    # --allow-host-paths IS: without it the child rejects the build and tells
    # the caller to pass a flag they already passed. Same shape as the
    # --allow-uefi and -x misses documented above.
    [[ "$ALLOW_HOST_PATHS" == "true" ]] && fwd+=("--allow-host-paths")
    # --allow-uefi and -x have the same "survives the re-invocation"
    # requirement as --hosted, and neither was forwarded. Without the first,
    # pass 2 (the app) dies on the <uefi/…> #error telling the user to pass a
    # flag they DID pass. Without the second, `axl-c++ --service` -- which is
    # axl-cc with `-x c++` pre-applied -- compiled every source with gcc as C.
    [[ "$ALLOW_UEFI" == "true" ]] && fwd+=("--allow-uefi")
    [[ -n "$FORCE_LANG" ]]        && fwd+=("-x" "$FORCE_LANG")
    for x in ${CFLAGS_EXTRA[@]+"${CFLAGS_EXTRA[@]}"}; do
        fwd+=("$x")
    done
    # -std lives in its own per-language arrays, NOT in CFLAGS_EXTRA, so it has
    # to be forwarded explicitly or both sub-builds silently fall back to the
    # defaults -- a `--service NAME -std=c++20` would compile as c++23 with no
    # mention of the flag the caller passed. Same failure mode --hosted has
    # above, same reason it is listed there.
    #
    # Only what the CALLER supplied. Forwarding the c++23 DEFAULT would hand
    # the child an explicit C++ standard it never asked for, and the child's
    # own reachability check would then reject a pure-C service outright.
    for x in ${STD_C[@]+"${STD_C[@]}"}; do
        fwd+=("$x")
    done
    if [[ "$STD_CXX_SET" == "true" ]]; then
        fwd+=("${STD_CXX[@]}")
    fi

    # Pass 1: driver image
    "$SCRIPT_DIR/axl-cc" "${fwd[@]}" \
        --type driver -DAXL_SERVICE_BUILD_DRIVER \
        "${SOURCES[@]}" -o "${SERVICE_NAME}-dxe.efi" \
        || { echo "ERROR: --service: driver build failed" >&2; exit 1; }

    # Pass 2: launcher app, embedding the driver from pass 1
    exec "$SCRIPT_DIR/axl-cc" "${fwd[@]}" \
        --embed "${SERVICE_NAME}-dxe.efi=${SERVICE_NAME}" \
        "${SOURCES[@]}" -o "${SERVICE_NAME}.efi"
fi

# Split SOURCES into compilables vs pre-built objects/archives.
# .o and .a files are passed straight to the linker (or, with -c,
# rejected as nonsensical — there's nothing to compile).  This lets
# consumers build their own libraries with `axl-cc -c ...; ar rcs
# libfoo.a *.o` and then link them via a subsequent axl-cc invocation
# (`axl-cc app.cpp libfoo.a -o app.efi`).
COMPILE_SOURCES=()
PREBUILT_OBJS=()
for src in "${SOURCES[@]}"; do
    case "$src" in
        *.o|*.a) PREBUILT_OBJS+=("$src") ;;
        *)       COMPILE_SOURCES+=("$src") ;;
    esac
done

if [[ "$COMPILE_ONLY" == "true" && ${#PREBUILT_OBJS[@]} -gt 0 ]]; then
    echo "ERROR: -c (compile-only) is incompatible with pre-built .o/.a inputs" >&2
    exit 1
fi
if [[ "$COMPILE_ONLY" == "true" && ${#COMPILE_SOURCES[@]} -eq 0 ]]; then
    echo "ERROR: -c needs at least one source file to compile" >&2
    exit 1
fi

# Default output: strip any known source extension from the first
# compilable source.  Order matters — longer suffixes first so .cpp
# doesn't fall through to .c.  With -c, the output extension is .o
# (mirrors gcc -c convention); without it, .efi.
if [[ -z "$OUTPUT" ]]; then
    first="${COMPILE_SOURCES[0]:-${PREBUILT_OBJS[0]}}"
    OUTPUT="$first"
    out_ext=$([[ "$COMPILE_ONLY" == "true" ]] && echo ".o" || echo ".efi")
    for ext in .cpp .cxx .cc .c; do
        [[ "$OUTPUT" == *"$ext" ]] && { OUTPUT="${OUTPUT%$ext}$out_ext"; break; }
    done
fi

LIB_DIR="$SDK_DIR/lib/axl/$ARCH"
if [[ ! -d "$LIB_DIR" ]]; then
    echo "ERROR: no SDK libraries for arch '$ARCH' in $LIB_DIR" >&2
    exit 1
fi

# Image type → entry + CRT0
case "$TYPE" in
    app)     ENTRY="${ENTRY:-_AxlEntry}" ;;
    driver)  ENTRY="${ENTRY:-DriverEntry}" ;;
    runtime) ENTRY="${ENTRY:-DriverEntry}" ;;
    *)  echo "ERROR: unknown type '$TYPE' (use: app, driver, runtime)" >&2; exit 1 ;;
esac

run_cmd() {
    if [[ "$VERBOSE" == "true" ]]; then
        echo "+ $*" >&2
    fi
    "$@"
}

# Build mode flags. Both modes carry DWARF debug info — release
# trades only the leak tracking and goes to -Os, debug stays at
# -Og + AXL_MEM_DEBUG. The .efi itself stays slim either way (debug
# DWARF lives in the side-by-side .debug file referenced by the PE
# debug data directory; pe-set-debug wires this up at link time).
if [[ "$BUILD" == "debug" ]]; then
    OPT_FLAGS="-Og -g -gdwarf -DAXL_MEM_DEBUG"
else
    OPT_FLAGS="-Os -g -gdwarf -DNDEBUG"
fi

if [[ "$VERBOSE" == "true" ]]; then
    echo "[axl-cc] arch=$ARCH type=$TYPE build=$BUILD toolchain=gcc entry=$ENTRY output=$OUTPUT" >&2
fi

# Stack-smashing detection, on by default. `-mstack-protector-guard=global` is
# the load-bearing half on x86-64: GCC otherwise reads the canary from
# %fs:0x28, glibc's TLS block, which UEFI never sets up -- so the plain flag
# faults instead of protecting. AArch64 already defaults to the global symbol.
# libaxl.a supplies __stack_chk_guard and __stack_chk_fail.
#
# Opt out per invocation with -fno-stack-protector: consumer flags are appended
# after these, and the last -f wins.
STACK_PROTECTOR="-fstack-protector-strong -mstack-protector-guard=global"

TMPDIR="/tmp/axl-cc-$$"
mkdir -p "$TMPDIR"

# Raw UEFI access is granted per IMAGE TYPE, not to everyone with the include
# path. <uefi/axl-uefi.h> refuses to compile without AXL_ALLOW_UEFI, so an
# ordinary application can no longer acquire the EDK2 surface by typing an
# #include -- it has to say so, and then the intent is visible on the build
# line instead of buried three headers down.
#
# Every NON-APP image type is granted it unconditionally -- driver AND runtime.
# Producing or interposing on a protocol means implementing that protocol's own
# types, so a shim cannot be written without them and asking for a flag would
# be noise. Testing `!= app` rather than `== driver` on purpose: a runtime
# driver is the image MOST likely to need raw UEFI (EFI_RUNTIME_SERVICES,
# SetVirtualAddressMap), and denying it would push the author toward
# `--type driver`, which silently builds subsystem 11 instead of 12 -- an image
# the firmware does not keep resident past ExitBootServices.
UEFI_DEFINE=()
if [[ "$TYPE" != "app" || "$ALLOW_UEFI" == "true" ]]; then
    UEFI_DEFINE=(-DAXL_ALLOW_UEFI)
fi

# Architecture-specific settings
case "$ARCH" in
    x64)  # ld/ar/objcopy from our own toolchain, as aa64 does -- the -axl
          # build carries the PE target this converts to.
          CROSS="${AXL_X64_BINUTILS_PREFIX:-${AXL_X64_BINUTILS_PREFIX_DEFAULT:-}}"
          PE_TARGET="pei-x86-64"
          GCC_ARCH="-mno-red-zone -march=x86-64"
          EFI_LDS="$SDK_DIR/lib/axl/elf_x86_64_efi.lds"
          EFI_LDS_EH="$SDK_DIR/lib/axl/elf_x86_64_efi_eh.lds"
          GCC_CRT0="$LIB_DIR/axl-crt0-gcc-x86_64.o"
          # AXL's own x86_64-elf toolchain, matching aa64's and $GCC_BIN's --
          # task T2 in AXL-Cxx-Design.md 6a-PLAN. It was the host g++ until
          # then, which was the SDK's last host input, and dropping it is not
          # only a hermeticity argument: the host compiler is glibc-targeted,
          # so its libsupc++ reads the exception globals and the stack canary
          # through %fs, which UEFI never sets up.
          GXX_BIN="${AXL_X64_GXX:-${AXL_X64_GXX_DEFAULT:-}}"
          # C, however, is bare-metal-only now. Host gcc would resolve
          # <string.h> to /usr/include -- the non-hermetic build the SDK's
          # compat shims used to paper over, and those shims are gone.
          GCC_BIN="${AXL_X64_GCC:-${AXL_X64_GCC_DEFAULT:-}}" ;;
    aa64) # ld/ar/objcopy from ARM's bare-metal toolchain, not apt's
          # aarch64-linux-gnu-*: a consumer should need no system development
          # tools (AXL-Libc-Substrate-Design.md §4.1d), and ARM's ships the
          # pei-aarch64-little target this converts to. The Makefile and the
          # generated CMake package read the same manifest key -- all three
          # build paths, which is the drift check-flag-parity exists over.
          CROSS="${AXL_AA64_BINUTILS_PREFIX:-${AXL_AA64_BINUTILS_PREFIX_DEFAULT:-}}"
          PE_TARGET="pei-aarch64-little"
          # -ffixed-x18: UEFI AArch64 binding (UEFI 2.11 §2) reserves
          # x18 as the platform register; without this flag GCC's
          # register allocator may clobber it, leading to post-
          # ExitBootServices OS-side corruption that's hard to trace.
          # Matches the convention used by ARM bare-metal UEFI builds
          # (e.g. a downstream UEFI-C++ consumer's aarch64-none-elf-gcc
          # invocation).
          GCC_ARCH="-ffixed-x18"
          EFI_LDS="$SDK_DIR/lib/axl/elf_aarch64_efi.lds"
          EFI_LDS_EH="$SDK_DIR/lib/axl/elf_aarch64_efi_eh.lds"
          GCC_CRT0="$LIB_DIR/axl-crt0-gcc-aarch64.o"
          # AArch64 C++ uses ARM's bare-metal cross because the
          # Linux-ABI cross's libstdc++ headers pull hosted typedefs.
          # See docs/ROADMAP.md axlmm Toolchain section.
          GXX_BIN="${AXL_AA64_GXX:-${AXL_AA64_GXX_DEFAULT:-}}"
          # Same for C: aarch64-linux-gnu-gcc targets glibc, and its default
          # include path carries no <string.h> a freestanding consumer may use.
          GCC_BIN="${AXL_AA64_GCC:-${AXL_AA64_GCC_DEFAULT:-}}" ;;
esac

# Per-source language detection.  Returns "cpp" or "c" on stdout.
# Honors -x override; otherwise dispatches by extension.
detect_lang() {
    local src="$1"
    case "$FORCE_LANG" in
        c++|cpp|cxx) echo cpp; return ;;
        c)           echo c;   return ;;
    esac
    case "$src" in
        *.cpp|*.cc|*.cxx|*.CPP|*.C) echo cpp ;;
        *)                          echo c ;;
    esac
}

# Quick scan: which languages are in the source list?  HAS_CPP drives
# toolchain validation and folds into CXX_LINK below; both drive the -std
# reachability check that follows.  Cheap loop — sources are few.
HAS_CPP=false
HAS_C=false
for src in "${COMPILE_SOURCES[@]}"; do
    if [[ "$(detect_lang "$src")" == "cpp" ]]; then
        HAS_CPP=true
    else
        HAS_C=true
    fi
done

# A caller-supplied -std that NO source in this build can use would otherwise
# be dropped in silence, because -std is routed per language. Two ways in:
# `axl-c++` (which is axl-cc with `-x c++` pre-applied, fixing every source to
# C++) and plain extension dispatch (`axl-cc -std=gnu2x foo.cpp`). Before the
# per-language split the compiler itself rejected the mismatch with a clear
# message; silently building at the wrong standard is strictly worse than that,
# so say it here.
#
# Only when something is actually being COMPILED. A link-only invocation has no
# source to match against, and passing one flag set to both compile and link
# steps is an ordinary Makefile pattern -- erroring there would break callers
# for no benefit.
if [[ ${#COMPILE_SOURCES[@]} -gt 0 ]]; then
    if [[ ${#STD_C[@]} -gt 0 && "$HAS_C" == "false" ]]; then
        echo "ERROR: ${STD_C[*]} names a C standard, but every source in this" >&2
        echo "       build compiles as C++. Use a c++NN / gnu++NN standard." >&2
        rm -rf "$TMPDIR"
        exit 1
    fi
    if [[ "$STD_CXX_SET" == "true" && "$HAS_CPP" == "false" ]]; then
        echo "ERROR: ${STD_CXX[*]} names a C++ standard, but every source in" >&2
        echo "       this build compiles as C. Use a cNN / gnuNN standard." >&2
        rm -rf "$TMPDIR"
        exit 1
    fi
fi

# HOST INCLUDE / LIBRARY PATHS, rejected before anything is compiled.
#
# This is the cheap half of the hermeticity check and it fires on INTENT: the
# flag is present whether or not a header is ultimately read through it, so the
# message can name the flag rather than a header six includes down. The
# expensive half (a -MD scan of what was ACTUALLY opened) runs after each
# compile and catches what this cannot -- an absolute `#include "/usr/..."` in
# a source file, which names no flag at all.
#
# -L is here and NOT in the -MD half, because a depfile lists headers only.
# A `-L/usr/lib -lfoo` is invisible to it and is the more dangerous of the two:
# a glibc object linked into a firmware image.
axl_cc_reject_host_paths() {
    local what="$1"; shift
    local f bad=""
    for f in "$@"; do
        case "$f" in
            -I/usr/*|-L/usr/*|-isystem/usr/*|-idirafter/usr/*|/usr/include*|/usr/lib*)
                bad="$bad $f" ;;
        esac
    done
    [[ -z "$bad" ]] && return 0
    echo "ERROR: $what names a HOST path:$bad" >&2
    echo "       A UEFI image cannot use the host's headers or libraries --" >&2
    echo "       they are built for another libc, another ABI and an OS that" >&2
    echo "       will not be there. The toolchain supplies its own; see" >&2
    echo "       docs/AXL-Libc-Substrate-Design.md." >&2
    echo "       If you genuinely need this, say so on the build line:" >&2
    echo "         $AXL_PROG --allow-host-paths ..." >&2
    rm -rf "$TMPDIR"
    exit 1
}
if [[ "$ALLOW_HOST_PATHS" != "true" ]]; then
    axl_cc_reject_host_paths "a compile flag" \
        ${CFLAGS_EXTRA[@]+"${CFLAGS_EXTRA[@]}"}
    axl_cc_reject_host_paths "a linker flag" \
        ${LDFLAGS_USER[@]+"${LDFLAGS_USER[@]}"}
    # And an archive or object handed in POSITIONALLY, which no flag scan and
    # no depfile can see -- `axl-cc app.c /usr/lib64/libm.a` used to link a
    # glibc object straight into a firmware image. This is the more dangerous
    # of the two directions the function's own comment names.
    axl_cc_reject_host_paths "an input file" \
        ${PREBUILT_OBJS[@]+"${PREBUILT_OBJS[@]}"}
fi

# Dependency flags on a LINK invocation produce nothing USABLE, and the two
# spellings fail differently -- both measured, because the first version of
# this warning described neither correctly:
#
#   with -MF <path>   the file IS written, and its target line names the
#                     scratch object ($TMPDIR/<base>.o) that axl-cc deletes on
#                     exit. Nothing will ever match that target, so make treats
#                     the rules as dead. Worse than absent: it looks like it
#                     worked. Two sources share the one -MF path, so the second
#                     compile also overwrites the first's deps.
#   without -MF       gcc derives the path from that same scratch object, so
#                     the file lands in $TMPDIR and vanishes with it. No file,
#                     no error, no clue.
#
# `--depfile` rejected this outright ("requires -c"); forwarded flags cannot,
# so say it. A WARNING and not an error: passing -MD through a shared CFLAGS to
# both the compile and the link step is an ordinary Makefile pattern, and
# erroring would break builds that are doing nothing wrong.
if [[ "$COMPILE_ONLY" != "true" ]]; then
    for _f in ${CFLAGS_EXTRA[@]+"${CFLAGS_EXTRA[@]}"}; do
        case "$_f" in
            -M|-MM|-MD|-MMD)
                echo "$AXL_PROG: warning: $_f asks for a dependency file, but this" >&2
                echo "         is a LINK invocation. Any file produced names a" >&2
                echo "         temporary object that this command deletes, so" >&2
                echo "         nothing will match it; without -MF no file is" >&2
                echo "         written at all. Pass -c to get a usable one." >&2
                break ;;
        esac
    done
fi

# Name an installer that can actually SUCCEED, for whichever compiler is
# missing. A packaged install has no scripts/ directory, so pointing a .deb or
# .rpm user at "scripts/install-toolchain.sh" is a dead end -- which is exactly
# what these messages used to do. Both arches are downloads now; x64 gained a
# published tarball with the -axl toolchain release, and only falls back to the
# ~40-minute source build when the download fails AND the source tree is here.
axl_cc_name_toolchain_installer() {
    local arch="$1"
    # Under AXL_TOOLCHAIN=cross the caller has declared they supply the
    # toolchain, so naming our installer would answer a question they did not
    # ask -- and would read as "you are holding it wrong" when the actual
    # remedy is one unset variable. Say what IS true for this variant.
    if [[ "$AXL_TOOLCHAIN" == "cross" ]]; then
        echo "       AXL_TOOLCHAIN=cross does not consult the" >&2
        echo "       axl-toolchains.conf defaults, by design -- name the" >&2
        echo "       toolchain yourself, or unset AXL_TOOLCHAIN to use the" >&2
        echo "       one the SDK installs." >&2
        return
    fi
    if [[ -x "$SDK_DIR/bin/axl-install-toolchain" ]]; then
        echo "       Install the bare-metal toolchain via:" >&2
        echo "         axl-install-toolchain $arch" >&2
    elif [[ -x "$SCRIPT_DIR/install-toolchain.sh" ]]; then
        echo "       Install the bare-metal toolchain via:" >&2
        echo "         scripts/install-toolchain.sh $arch" >&2
    else
        echo "       The toolchain installer is not present in this install --" >&2
        echo "       it ships as bin/axl-install-toolchain and as" >&2
        echo "       scripts/install-toolchain.sh in the source tree." >&2
    fi
}

# Validate the C toolchain ONLY when gcc actually runs: a .c source, or an
# --embed blob (whose generated .S is assembled with it). It is NOT needed by a
# pure-C++ build, and NOT by a link-only invocation
# (`axl-cc app.o libfoo.a -o app.efi`) — the crt0 is prebuilt and the link uses
# ${CROSS}ld. Demanding it there would fail a build for a compiler it never
# invokes, which is the failure mode this guard exists to prevent, inverted.
if [[ "$HAS_C" == "true" || ${#EMBEDS[@]} -gt 0 ]] \
   && { [[ -z "$GCC_BIN" ]] || { [[ ! -x "$GCC_BIN" ]] && ! command -v "$GCC_BIN" &>/dev/null; }; }; then
    if [[ -z "$GCC_BIN" ]]; then
        echo "ERROR: no $ARCH C compiler is configured." >&2
        echo "       axl-toolchains.conf was not found beside this script or in" >&2
        echo "       $SDK_DIR/share/axl/ -- the install may be incomplete." >&2
    else
        echo "ERROR: $ARCH C compiler not found at $GCC_BIN" >&2
    fi
    axl_cc_name_toolchain_installer "$ARCH"
    if [[ "$ARCH" == "aa64" ]]; then
        echo "       Or set AXL_AA64_GCC to an aarch64-none-elf gcc." >&2
    else
        echo "       Or set AXL_X64_GCC to an x86_64-elf gcc." >&2
    fi
    echo "       C is compiled bare-metal on both arches so a build uses no" >&2
    echo "       host headers; see docs/AXL-Libc-Substrate-Design.md." >&2
    rm -rf "$TMPDIR"
    exit 1
fi

# Validate the C++ COMPILER only when a .cpp is actually compiled. Pure-C
# builds never reach this; a missing g++ is invisible to them. It used to run
# for --hosted as well, because that flag stood in for "there is C++ in this
# link"; the link-side prerequisite moved to CXX_LINK below, which is derived
# from the objects and so is right for a staged build too.
#
# The link-time uses of $GXX_BIN are the `-print-file-name` lookups for
# libstdc++/libsupc++, and CXX_LINK is not known until after the compile step.
# That path reports a missing archive by name, which is the same information.
if [[ "$HAS_CPP" == "true" ]]; then
    if [[ -z "$GXX_BIN" ]] || { [[ ! -x "$GXX_BIN" ]] && ! command -v "$GXX_BIN" &>/dev/null; }; then
        # Name the compiler actually configured, not the one that used to be
        # the default. Saying "g++ not found in PATH" when the manifest points
        # at a missing bare-metal g++ is false -- host g++ IS in PATH -- and
        # hides the value that needs fixing.
        if [[ -z "$GXX_BIN" ]]; then
            echo "ERROR: C++ source detected, but no $ARCH C++ compiler is configured." >&2
            echo "       axl-toolchains.conf was not found beside this script or in" >&2
            echo "       $SDK_DIR/share/axl/ -- the install may be incomplete." >&2
        else
            echo "ERROR: C++ source detected; $ARCH C++ compiler not found at $GXX_BIN" >&2
        fi
        axl_cc_name_toolchain_installer "$ARCH"
        if [[ "$ARCH" == "aa64" ]]; then
            echo "       Or set AXL_AA64_GXX to an aarch64-none-elf g++." >&2
        else
            echo "       Or set AXL_X64_GXX to an x86_64-elf g++." >&2
        fi
        echo "       C++ is compiled bare-metal on both arches: a glibc-targeted" >&2
        echo "       g++ reads the exception globals and the stack canary through" >&2
        echo "       %fs, which UEFI never sets up. See docs/AXL-Cxx-Design.md." >&2
        rm -rf "$TMPDIR"
        exit 1
    fi
fi

RELOC_OBJ="$LIB_DIR/axl-reloc.o"
DEBUG_INFO_OBJ="$LIB_DIR/axl-debug-info.o"
PE_SET_DEBUG="$SDK_DIR/bin/pe-set-debug"

# Compile.  Per-source: dispatch to gcc (.c) or g++ (.cpp).  The C++
# flag set is constrained per docs/ROADMAP.md axlmm Toolchain section:
# -fno-exceptions -fno-rtti -fno-threadsafe-statics -std=c++23 are
# hard defaults baked in here — consumers cannot opt in to exceptions
# or RTTI because the link won't satisfy libsupc++ symbols.
OBJS=()
# -c output policy mirrors gcc: a single source can be redirected via
# -o; multiple sources go to per-source .o files in the current dir
# (and -o is forbidden — same gcc behavior).
if [[ "$COMPILE_ONLY" == "true" && ${#COMPILE_SOURCES[@]} -gt 1 && -n "${OUTPUT_USER_SET:-}" ]]; then
    echo "ERROR: -c with multiple source files cannot use -o" >&2
    rm -rf "$TMPDIR"
    exit 1
fi

for src in "${COMPILE_SOURCES[@]}"; do
    # Strip the longest matching source extension so .cpp.o etc. work.
    obj_base=""
    for ext in .cpp .cxx .cc .c; do
        if [[ "$src" == *"$ext" ]]; then
            obj_base="$(basename "${src%$ext}")"
            break
        fi
    done
    [[ -z "$obj_base" ]] && obj_base="$(basename "$src")"

    if [[ "$COMPILE_ONLY" == "true" ]]; then
        # Persist .o to the user's filesystem (not $TMPDIR which gets
        # cleaned at script exit).  Single-source: respect -o.
        # Multi-source: write each next to the cwd.
        if [[ ${#COMPILE_SOURCES[@]} -eq 1 ]]; then
            obj="$OUTPUT"
        else
            obj="${obj_base}.o"
        fi
    else
        # Normal link-after-compile: scratch .o in tmpdir.
        obj="$TMPDIR/${obj_base}.o"
    fi


    # Which compiler and which language mode the hermeticity pass must mirror.
    # It has to match the real compile: a -M run with a different
    # -ffreestanding, or a different compiler, resolves a different set of
    # headers and would answer a question nobody asked.
    if [[ "$(detect_lang "$src")" == "cpp" ]]; then
        HERM_CC="$GXX_BIN"
        HERM_MODE_FLAGS=(-fshort-wchar -fno-builtin "${STD_CXX[@]}")
    else
        HERM_CC="$GCC_BIN"
        HERM_MODE_FLAGS=(-ffreestanding -fshort-wchar -fno-builtin
                         ${STD_C[@]+"${STD_C[@]}"})
    fi

    if [[ "$(detect_lang "$src")" == "cpp" ]]; then
        # NO -ffreestanding, and that is the whole of task T3. It sets
        # __STDC_HOSTED__ to 0, which libstdc++ consults in
        # bits/requires_hosted.h to refuse <vector>/<string>/<map> -- so it was
        # the entirety of what --hosted turned off, and there is one C++ mode
        # now. C keeps it (see the gcc branch below): dropping it there would
        # pull a real <stdio.h> with a FILE and locale machinery AXL does not
        # implement. One mode PER LANGUAGE, and no flag for the caller.
        #
        # $GCC_ARCH stays -- dropping it is how a hosted spike picked up AVX
        # from a -march=x86-64-v3 default and #UD'd under a firmware that runs
        # with CR4.OSXSAVE clear.
        run_cmd "$GXX_BIN" \
            -fshort-wchar -fno-builtin \
            $STACK_PROTECTOR -fno-omit-frame-pointer -fpic $GCC_ARCH \
            -fno-exceptions -fno-rtti -fno-threadsafe-statics \
            "${STD_CXX[@]}" \
            -ffunction-sections -fdata-sections \
            $OPT_FLAGS -Wall \
            -DAXL_BACKEND_NATIVE \
            ${UEFI_DEFINE[@]+"${UEFI_DEFINE[@]}"} \
            -isystem "$SDK_DIR/include/axl-sdk" \
            ${CFLAGS_EXTRA[@]+"${CFLAGS_EXTRA[@]}"} \
            -c "$src" -o "$obj" || { echo "ERROR: C++ compilation failed: $src" >&2; rm -rf "$TMPDIR"; exit 1; }
    else
        run_cmd "$GCC_BIN" \
            -ffreestanding -fshort-wchar -fno-builtin \
            ${STD_C[@]+"${STD_C[@]}"} \
            $STACK_PROTECTOR -fno-omit-frame-pointer -fpic $GCC_ARCH \
            -ffunction-sections -fdata-sections \
            $OPT_FLAGS -Wall \
            -DAXL_BACKEND_NATIVE \
            ${UEFI_DEFINE[@]+"${UEFI_DEFINE[@]}"} \
            -isystem "$SDK_DIR/include/axl-sdk" \
            ${CFLAGS_EXTRA[@]+"${CFLAGS_EXTRA[@]}"} \
            -c "$src" -o "$obj" || { echo "ERROR: compilation failed: $src" >&2; rm -rf "$TMPDIR"; exit 1; }
    fi

    # HERMETICITY: did this TU actually OPEN anything under the host's tree?
    #
    # The complete half of the check. The flag scan above fires on intent and
    # cannot see an absolute `#include "/usr/..."`, which names no flag at all;
    # this is the compiler's own record of every file it opened.
    #
    # A SEPARATE -M pass, not -MD attached to the real compile, and that is
    # forced rather than chosen. gcc has ONE dependency mechanism, so attaching
    # `-MD -MF` here collides with a consumer forwarding their own
    # -MD/-MMD/-MF -- and they do: the generated CMake package passes
    # `-MD -MP -MF` on every source, and AGT's Makefile likewise. Measured, the
    # attached form took the -MF they asked for and broke 11 of this suite's
    # dependency assertions. An isolated pass cannot perturb the real compile
    # at all.
    #
    # -M and not -MM: -MM omits SYSTEM headers by definition, so a leak through
    # `-isystem /usr/include` is INVISIBLE to it (measured on one TU: -MM 0
    # hits, -M 19). That distinction is the whole reason this check works.
    #
    # Costs ~14 ms against a ~27 ms compile -- a preprocess with no codegen.
    if [[ "$ALLOW_HOST_PATHS" != "true" ]]; then
        HERM_D="$TMPDIR/axlcc-herm-${obj_base}.d"
        # The consumer's -I/-D must reach this pass -- they decide which
        # headers resolve, and a check run against a different search path
        # answers a different question. Their DEPENDENCY flags must NOT: this
        # pass owns -M/-MF/-MT, and forwarding theirs made gcc write OUR
        # dependency output over the file they asked for. Measured, it broke
        # five of this suite's assertions that way.
        #
        # -MF/-MT/-MQ take a SEPARATE argument, so each drops two tokens.
        HERM_CFLAGS=()
        _skip_next=false
        for _f in ${CFLAGS_EXTRA[@]+"${CFLAGS_EXTRA[@]}"}; do
            if [[ "$_skip_next" == "true" ]]; then _skip_next=false; continue; fi
            case "$_f" in
                -MF|-MT|-MQ)          _skip_next=true; continue ;;
                -M|-MM|-MD|-MMD|-MP|-MG) continue ;;
                -MF*|-MT*|-MQ*)       continue ;;
            esac
            HERM_CFLAGS+=("$_f")
        done
        # The same -D / -O / arch flags as the real compile, not just its -I.
        # A header reached under `#ifdef NDEBUG` is opened by a --release build
        # and NOT by a pass that omits -DNDEBUG -- measured, a leak inside that
        # guard passed cleanly. Preprocessor state is part of "which headers
        # this TU opens". Failure to produce the file is fatal: the compile already
        # succeeded, so a missing record means the check silently did not run.
        if ! "$HERM_CC" ${HERM_MODE_FLAGS[@]+"${HERM_MODE_FLAGS[@]}"} \
                -M -MF "$HERM_D" -MT herm \
                $OPT_FLAGS $GCC_ARCH -DAXL_BACKEND_NATIVE \
                ${UEFI_DEFINE[@]+"${UEFI_DEFINE[@]}"} \
                -isystem "$SDK_DIR/include/axl-sdk" \
                ${HERM_CFLAGS[@]+"${HERM_CFLAGS[@]}"} \
                "$src" >/dev/null 2>"$TMPDIR/herm.err" || [[ ! -f "$HERM_D" ]]; then
            echo "ERROR: could not determine which headers $src opened, so" >&2
            echo "       the host-header check did not run. A check that" >&2
            echo "       cannot see is worse than none." >&2
            sed 's/^/       /' "$TMPDIR/herm.err" >&2
            rm -f "$obj"; rm -rf "$TMPDIR"; exit 1
        fi
        # A HOST location is /usr or /lib -- EXCEPT the SDK's own tree and the
        # toolchain's, both of which legitimately live there.
        #
        # This is not hypothetical tidiness: build-packages.sh stages with
        # --prefix /usr, so a .deb/.rpm consumer's OWN headers are at
        # /usr/include/axl-sdk/ and a plain `axl-cc hello.c` would have been
        # rejected as "reached the HOST's headers" on every packaged install.
        # axl-toolchains.conf likewise documents a /usr/local toolchain prefix
        # as supported. A blocklist without these exemptions breaks the SDK's
        # own shipping configuration, which the staged-out/ test could not see.
        #
        # The toolchain root is the compiler's grandparent (<root>/bin/<cc>),
        # which covers both its gcc-internal and its libc headers.
        # EXEMPT THE INCLUDE DIR, NOT THE PREFIX. On a packaged install
        # SDK_DIR IS "/usr", so exempting "$SDK_DIR/" would whitelist the
        # entire host tree and disable this check exactly where it ships --
        # a worse bug than the false positive it was fixing, and one only a
        # /usr-rooted test would ever show.
        _herm_tc_root="$(dirname "$(dirname "$HERM_CC")")"
        # EXCLUDE THE SOURCE ITSELF. `-M` lists the TU as its own first
        # prerequisite, so a source that merely LIVES under /usr matched the
        # blocklist and was reported as the host header it had supposedly
        # opened -- naming itself in the error, which is the tell. That is not
        # a corner case: build-packages.sh stages examples to
        # /usr/share/doc/axl-sdk/examples/, and the .deb's own post-install
        # message tells the user to compile one from there, so every packaged
        # install failed on the first command it recommends.
        _herm_src_abs="$(readlink -f "$src" 2>/dev/null || echo "$src")"
        _herm_hits="$(tr ' \\' '\n\n' < "$HERM_D" \
                      | grep -E '^(/usr/|/lib/)' \
                      | grep -v "^$SDK_DIR/include/axl-sdk/" \
                      | grep -v "^$_herm_tc_root/" \
                      | grep -vxF "$src" \
                      | grep -vxF "$_herm_src_abs" \
                      | sort -u || true)"
        if [[ -n "$_herm_hits" ]]; then
            echo "ERROR: $src reached the HOST's headers:" >&2
            printf '         %s\n' $_herm_hits >&2
            echo "       A UEFI image cannot use them -- they describe another" >&2
            echo "       libc and another ABI. The toolchain supplies its own." >&2
            echo "       See docs/AXL-Libc-Substrate-Design.md; if you genuinely" >&2
            echo "       need this, say so on the build line:" >&2
            echo "         $AXL_PROG --allow-host-paths ..." >&2
            rm -f "$obj"; rm -rf "$TMPDIR"; exit 1
        fi
    fi


    OBJS+=("$obj")
done

# -c short-circuit: each source has its own .o now; nothing more to do.
# Pre-built .o/.a inputs are illegal in -c mode (caught above).
if [[ "$COMPILE_ONLY" == "true" ]]; then
    rm -rf "$TMPDIR"
    for o in "${OBJS[@]}"; do echo "$o"; done
    exit 0
fi

# --embed: generate a tiny .s sidecar per blob and assemble it. The
# emitted symbols (axl_embedded_<name>{,_end}) match the convention
# <axl/axl-embed.h>'s AXL_EMBED_DECLARE / DATA / SIZE expects.
for spec in ${EMBEDS[@]+"${EMBEDS[@]}"}; do
    if [[ "$spec" == *"="* ]]; then
        embed_path="${spec%%=*}"
        embed_sym="${spec#*=}"
    else
        embed_path="$spec"
        embed_base="$(basename "$embed_path")"
        embed_base="${embed_base%%.*}"
        embed_sym="$(printf '%s' "$embed_base" | sed 's/[^a-zA-Z0-9_]/_/g')"
    fi

    if [[ ! -f "$embed_path" ]]; then
        echo "ERROR: --embed: file not found: $embed_path" >&2
        rm -rf "$TMPDIR"; exit 1
    fi
    if ! [[ "$embed_sym" =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]]; then
        echo "ERROR: --embed: derived symbol '$embed_sym' is not a valid C identifier; pass --embed PATH=name explicitly" >&2
        rm -rf "$TMPDIR"; exit 1
    fi
    # .incbin's argument is a quoted string literal; reject characters
    # that would break out of it (", \) or split it across lines (\n,
    # \r, NUL, other ctrl chars). Practically rare on UEFI build paths,
    # but the filter is paranoia, not a soft limit — finish the job.
    if [[ "$embed_path" == *[$'\x00-\x1f\x7f"\\']* ]]; then
        echo "ERROR: --embed: path contains characters that can't be embedded in .incbin: $embed_path" >&2
        rm -rf "$TMPDIR"; exit 1
    fi

    # Resolve to absolute so the path is independent of the invocation CWD
    [[ "$embed_path" != /* ]] && embed_path="$PWD/$embed_path"

    embed_s="$TMPDIR/embed_${embed_sym}.s"
    cat > "$embed_s" <<EMBED_S
    .section .rodata
    .balign 8
    .globl axl_embedded_${embed_sym}
    .globl axl_embedded_${embed_sym}_end
axl_embedded_${embed_sym}:
    .incbin "${embed_path}"
axl_embedded_${embed_sym}_end:

    .section .note.GNU-stack, "", %progbits
EMBED_S

    embed_o="$TMPDIR/embed_${embed_sym}.o"
    run_cmd "$GCC_BIN" -c "$embed_s" -o "$embed_o" \
        || { echo "ERROR: --embed: assembly failed for $embed_path" >&2; rm -rf "$TMPDIR"; exit 1; }
    OBJS+=("$embed_o")
done

# Link
# App:    asm CRT0 → _AxlEntry (C CRT0 axl-crt0-native.o) → main
# App (--minimal-runtime):
#         asm CRT0 → _AxlEntry (C CRT0 axl-crt0-minimal.o) → main
#         Minimal CRT0 skips registry/atexit/signal/default-loop setup.
# Driver: asm CRT0 → _AxlEntry (aliased to user's $ENTRY via --defsym)
#
# Drivers can't link a C CRT0 (they pull in main()) and don't define
# _AxlEntry directly, so we tell the linker that _AxlEntry is just
# another name for the user's entry function (e.g. DriverEntry). This
# keeps the asm CRT0's relocation step in the call path.
LDFLAGS_EXTRA=()
if [[ "$TYPE" == "app" ]]; then
    if [[ "$RUNTIME" == "minimal" ]]; then
        C_CRT0="$LIB_DIR/axl-crt0-minimal.o"
    else
        C_CRT0="$LIB_DIR/axl-crt0-native.o"
    fi
    CRT0_OBJS="$GCC_CRT0 $RELOC_OBJ $DEBUG_INFO_OBJ $C_CRT0"
else
    if [[ "$RUNTIME" == "minimal" ]]; then
        echo "ERROR: --minimal-runtime is app-type only (use on --type app)" >&2
        rm -rf "$TMPDIR"
        exit 1
    fi
    CRT0_OBJS="$GCC_CRT0 $RELOC_OBJ $DEBUG_INFO_OBJ"
    LDFLAGS_EXTRA+=("--defsym=_AxlEntry=$ENTRY")
fi

# PE/COFF subsystem code: 10=APPLICATION, 11=BOOT_SERVICE_DRIVER, 12=RUNTIME_DRIVER.
# Loaded via the wrong path the firmware misroutes the entry point, leading to
# crashes (KVM emulation failure / silent dispatch failures).
case "$TYPE" in
    app)     SUBSYSTEM=10 ;;
    driver)  SUBSYSTEM=11 ;;
    runtime) SUBSYSTEM=12 ;;
esac

SO_FILE="$TMPDIR/output.so"
# --no-warn-rwx-segments: the .so is just an intermediate consumed by
# objcopy → PE/COFF; no OS loads it, so the linker's RWX warning is a
# false positive (the .efi has properly split per-section permissions).
# --no-undefined: ld(1) with `-shared` silently accepts unresolved
# symbols by default — they become zero/garbage at runtime (UEFI
# binaries are statically self-contained; there's no dynamic loader
# to resolve them post-link). Force a hard link error instead so
# missing-symbol bugs surface at build time rather than as
# RIP-points-at-nonsense crashes in the field. The AXL library's own
# build already uses this flag; consumer-facing axl-cc was missing it.
# When any C++ reaches the link, it also carries the toolchain's
# libstdc++/libsupc++ and AXL's four cxxrt glue objects; a pure-C link takes
# neither. See the P4 block below for what that swap replaced and why the
# choice is made from the OBJECTS rather than from a flag.
#
# ONE nm pass over everything reaching the link -- freshly compiled objects and
# any handed to us. A failure to read them leaves the answer false, which is
# the pre-existing behaviour: this can only ADD detection, never remove it.
# The `--hosted` flag used to carry the same job for the staged build
# (`axl-c++ -c a.cpp` then `axl-c++ a.o -o app.efi`, where the link half sees
# no .cpp source at all); T3 retired the flag and the scan replaced it, which
# also CLOSED a gap -- that staged flow was already broken, and failed on an
# undefined `operator new` that named no flag.
_link_objs=(${OBJS[@]+"${OBJS[@]}"} ${PREBUILT_OBJS[@]+"${PREBUILT_OBJS[@]}"})
_link_undef=""
if [[ ${#_link_objs[@]} -gt 0 ]]; then
    _link_undef="$("${NM_BIN:-nm}" -u "${_link_objs[@]}" 2>/dev/null || true)"
fi
# Itanium-mangled or __cxa_* undefined symbols mean a C++ translation unit is
# in this link. `_Z` covers operator new/delete and every std:: reference;
# __cxa_ covers the ABI hooks a C++ TU emits even with no library call in it.
CXX_LINK="false"
if printf '%s\n' "$_link_undef" | grep -q "^ *U _Z\|^ *U __cxa_\| _Z\| __cxa_"; then
    CXX_LINK="true"
fi
# A .cpp on THIS command line settles it without consulting nm. Folded in here
# rather than tested alongside CXX_LINK at each use, so there is ONE answer to
# "is this a C++ link" — the two were spelled `HAS_CPP || CXX_LINK` at three
# separate sites, which is three chances to add a fourth and get it wrong.
if [[ "$HAS_CPP" == "true" ]]; then
    CXX_LINK="true"
fi

# ONE C++ LINK SHAPE (P4, AXL-Libc-Substrate-Design.md §4d).
#
# There used to be two, selected by whether the caller passed -fexceptions:
# a DEFAULT link carrying libaxl-cxx.a and no libstdc++ at all, and an
# EXCEPTIONS link carrying the toolchain's libstdc++/libsupc++ instead. They
# were alternatives rather than companions -- 53 of libaxl-cxx.a's 56 symbols
# collide with libstdc++ -- so the two could never appear together, and
# picking the wrong one failed at RUNTIME on the first throw rather than at
# link.
#
# P4 deletes libaxl-cxx.a and keeps the exceptions shape for every C++ link.
# What that buys is <iostream>, <sstream> and <fstream>, which no set of
# hand-written substitutes was ever going to reach; what it costs is measured
# and accepted (+46,928 .text on sdk/examples/containers.cpp, x64). So
# -fexceptions is now purely a COMPILE-side flag -- it decides whether the
# caller's own frames get landing pads -- and no longer selects a link.
#
# The glue AXL still owes is OBJECTS, not an archive, and that is load-bearing
# rather than stylistic. axl-cxxrt-terminate.o preempts libstdc++'s
# vterminate.o, whose __gnu_cxx::__verbose_terminate_handler drags
# __cxa_demangle and newlib's stdio in for ~112 KB and then prints NOTHING
# under UEFI. From an archive that member could still be pulled; from an
# object it cannot. Same reasoning as axl-cxxrt-alloc.o's sbrk. See
# src/cxxrt/axl-cxxrt-terminate.cpp.
CXX_LIB_ARGS=()
# --no-eh-frame AND exceptions is a CORRECTNESS failure, not a size trade, so
# it is refused rather than warned about. A handler in a --no-eh-frame image
# can never run -- nothing unwinds to it -- and the throw would reach the
# interceptor in axl-cxxrt-nothrow.o and exit, silently skipping every catch
# block the source contains. That is the one outcome this flag must not be
# able to produce.
#
# Two sources, because a staged build reaches the link with no source at all:
# the flag on this command line, and a pre-built object referencing
# __gxx_personality_v0 (which -fexceptions is what emits).
if [[ "$NO_EH_FRAME" == "true" ]]; then
    _eh_reason=""
    for _f in ${CFLAGS_EXTRA[@]+"${CFLAGS_EXTRA[@]}"}; do
        [[ "$_f" == "-fexceptions" ]] && _eh_reason="-fexceptions was passed"
    done
    if [[ -z "$_eh_reason" && ${#PREBUILT_OBJS[@]} -gt 0 ]]; then
        for _o in "${PREBUILT_OBJS[@]}"; do
            if "${CROSS}nm" -u "$_o" 2>/dev/null | grep -q '__gxx_personality_v0'; then
                _eh_reason="$_o references __gxx_personality_v0"
                break
            fi
        done
    fi
    if [[ -n "$_eh_reason" ]]; then
        echo "ERROR: --no-eh-frame cannot be combined with exceptions" >&2
        echo "       ($_eh_reason)." >&2
        echo "" >&2
        echo "  --no-eh-frame drops the unwind tables, so no catch block in" >&2
        echo "  the image can ever run: a throw would print its type and exit" >&2
        echo "  instead of reaching your handler. Refusing rather than" >&2
        echo "  building an image whose exception handling is silently dead." >&2
        echo "" >&2
        echo "  Drop one of the two. Without -fexceptions a throw out of" >&2
        echo "  libstdc++ still HALTS diagnosably; it just cannot be caught." >&2
        rm -rf "${TMPDIR:-}" 2>/dev/null || true
        exit 1
    fi
fi

if [[ "$CXX_LINK" == "true" ]]; then
    # Checked HERE rather than beside the compiler check, because these are
    # LINK prerequisites: the staged flow (`axl-c++ -c a.cpp` then `axl-c++
    # a.o -o app.efi`) reaches the link with no .cpp source at all, and used
    # to get ld's raw undefined-symbol list instead of a message naming the
    # missing install step.
    # --no-eh-frame swaps the frame-table registrar for the throw
    # interceptor. They are mutually exclusive: axl-cxxrt-eh.o references
    # __eh_frame_start, which only the exceptions script defines, so keeping
    # it alongside the default script is a hard --no-undefined link error --
    # which is why this is an object-set change and not only a script change.
    _cxxrt_eh_obj=axl-cxxrt-eh.o
    [[ "$NO_EH_FRAME" == "true" ]] && _cxxrt_eh_obj=axl-cxxrt-nothrow.o
    for _ehobj in axl-cxxrt-alloc.o "$_cxxrt_eh_obj" axl-cxxrt-stubs.o \
                  axl-cxxrt-terminate.o; do
        if [[ ! -f "$LIB_DIR/$_ehobj" ]]; then
            echo "ERROR: this link contains C++ and needs $LIB_DIR/$_ehobj," >&2
            echo "       which this SDK was built without. Rebuild with C++" >&2
            echo "       support:" >&2
            echo "         ./scripts/install.sh --cpp" >&2
            rm -rf "$TMPDIR"; exit 1
        fi
        CXX_LIB_ARGS+=("$LIB_DIR/$_ehobj")
    done
fi
# A C++ LINK NEEDS THE WHOLE MATCHED SET, not just libstdc++: the unwinder is
# in libgcc.a, the ABI layer and the emergency pool in libsupc++.a, and
# libstdc++ reaches libc/libm for memcpy, ceil and the syscall stubs libnosys
# answers. All resolved through $GXX_BIN rather than assembled from a path, so
# an AXL_*_GXX override moves the libraries with the compiler.
#
# -frtti needs nothing extra now, and that IS the change. typeid and
# dynamic_cast want __cxxabiv1::__class_type_info's vtables and
# __dynamic_cast from libsupc++, which used to make -frtti the one flag that
# put libstdc++.a on the line; every C++ link carries it since P4, so the
# separate RTTI_LINK detection and its diagnostic are gone.
#
# NO libnosys.a, deliberately. It supplies exactly the syscall stubs newlib's
# reentrant layer needs -- and every one of its objects carries a
# `.gnu.warning.<sym>` section, so a SUCCEEDING link emits ten "not
# implemented and will always fail" lines. axl-cxxrt-stubs.o answers the same
# set quietly.
#
# THE C LIBRARY IS ON EVERY LINK (P3, AXL-Libc-Substrate-Design.md §4d).
#
# It used to arrive only on the -fexceptions path, which is why `printf` and
# `malloc` were unavailable to plain C: a C link was libaxl.a and nothing else.
# libstdc++/libsupc++ stay C++-only -- those are the C++ runtime, and a C image
# has no use for them.
#
# Resolved through the C driver for a C link and the C++ one for a C++ link,
# because a C-only SDK need not have a C++ toolchain installed at all and
# asking $GXX_BIN would fail for a consumer who never wanted one.
EH_LIBS=()
_libsrc="$GCC_BIN"
_libwhy="the C library"
_libfix="axl-install-toolchain $ARCH"
_liblist=(libc.a libm.a libgcc.a)
if [[ "$CXX_LINK" == "true" ]]; then
    _libsrc="$GXX_BIN"
    _libwhy="the C++ runtime"
    _liblist=(libstdc++.a libsupc++.a libc.a libm.a libgcc.a)
fi
for _ehlib in "${_liblist[@]}"; do
    _p="$("$_libsrc" -print-file-name="$_ehlib" 2>/dev/null || true)"
    if [[ ! -f "$_p" ]]; then
        echo "ERROR: $_libwhy needs $_ehlib from the bare-metal" >&2
        echo "       toolchain; '${_libsrc:-<none configured>}' could not" >&2
        echo "       locate it (got: '${_p:-<nothing>}')." >&2
        echo "       Install it via '$_libfix'." >&2
        rm -rf "$TMPDIR"; exit 1
    fi
    EH_LIBS+=("$_p")
done

# THE PORTING LAYER TRAVELS WITH THE C LIBRARY, and this is load-bearing rather
# than tidy. newlib defines none of write/read/open/close/lseek/fstat, and
# `malloc` reaches dlmalloc which grows through `sbrk` -- all of which live in
# AXL's glue objects. Without them on a C link:
#
#   x64   an undefined reference, which is at least loud
#   aa64  WORSE -- ARM's newlib ships its own sbrk/write/read that call the
#         _r forms, which call back to these names. Two halves of a mutual
#         recursion, i.e. a stack overflow at the first malloc rather than a
#         link error.
#
# Named as OBJECTS, for the displacement reason documented below.
for _pobj in axl-cxxrt-alloc.o axl-cxxrt-stubs.o; do
    if [[ -f "$LIB_DIR/$_pobj" ]]; then
        case " ${CXX_LIB_ARGS[*]-} " in
            *" $LIB_DIR/$_pobj "*) ;;
            *) CXX_LIB_ARGS+=("$LIB_DIR/$_pobj") ;;
        esac
    fi
done
# ALWAYS a group: libc.a is on every link (P3), and libaxl.a <-> libc.a is
# genuinely mutually dependent -- libaxl's vendored code calls memcpy, while
# newlib's stdio calls back into AXL's porting layer. One pass in either order
# leaves something undefined.
LIB_GROUP_OPEN=(--start-group)
LIB_GROUP_CLOSE=(--end-group)

# --version-script localizes every symbol but the entry point. `-shared`
# otherwise exports all globals into the dynamic symbol table and treats them
# as --gc-sections roots, so dead-code elimination can't run and a trivial app
# drags in the whole runtime (~110 KB). A UEFI image needs no exports, so
# localizing cuts the .efi ~66%. Guarded so an SDK staged before this file
# existed still links (just larger).
VERSION_SCRIPT_ARGS=()
EFI_VER="$SDK_DIR/lib/axl/efi-localize.ver"
[[ -f "$EFI_VER" ]] && VERSION_SCRIPT_ARGS+=(--version-script "$EFI_VER")

# The C++ script differs from the default in one place: it KEEPs .eh_frame and
# defines __eh_frame_start. It is a separate file rather than a KEEP() in the
# shared one because KEEP costs a C-only image +16.8% for tables it can never
# use (AXL-Cxx-Unwinder-Design.md §U2, measured).
#
# EVERY C++ LINK TAKES IT SINCE P4, not only an -fexceptions one. libstdc++ is
# compiled WITH exceptions whatever the caller passed, so `vector::at` out of
# range really throws now -- and without a registered frame table that throw
# reaches std::terminate through _URC_FATAL_PHASE1_ERROR instead of the normal
# path, losing the type name and what() that axl-cxxrt-terminate.cpp prints.
LINK_LDS="$EFI_LDS"
NO_EH_LD_ARGS=()
if [[ "$CXX_LINK" == "true" ]]; then
    if [[ "$NO_EH_FRAME" == "true" ]]; then
        # The DEFAULT script, and __cxa_throw redirected to the interceptor in
        # axl-cxxrt-nothrow.o. --wrap rather than a plain definition because
        # libsupc++'s eh_throw.o lands on the link regardless (the terminate
        # handler needs other symbols from it) and a second definition is a
        # `multiple definition` error.
        NO_EH_LD_ARGS+=(--wrap=__cxa_throw)
    else
        if [[ ! -f "${EFI_LDS_EH:-}" ]]; then
            echo "ERROR: a C++ link needs ${EFI_LDS_EH:-the exceptions linker script}," >&2
            echo "       which this SDK does not carry. Re-run scripts/install.sh." >&2
            rm -rf "$TMPDIR"; exit 1
        fi
        LINK_LDS="$EFI_LDS_EH"
    fi
fi

run_cmd ${CROSS}ld -nostdlib -shared -Bsymbolic \
    --no-warn-rwx-segments --no-undefined --gc-sections \
    ${NO_EH_LD_ARGS[@]+"${NO_EH_LD_ARGS[@]}"} \
    -T "$LINK_LDS" \
    ${VERSION_SCRIPT_ARGS[@]+"${VERSION_SCRIPT_ARGS[@]}"} \
    ${LDFLAGS_EXTRA[@]+"${LDFLAGS_EXTRA[@]}"} \
    ${LDFLAGS_USER[@]+"${LDFLAGS_USER[@]}"} \
    -o "$SO_FILE" \
    $CRT0_OBJS \
    "${OBJS[@]}" \
    ${PREBUILT_OBJS[@]+"${PREBUILT_OBJS[@]}"} \
    ${LIB_GROUP_OPEN[@]+"${LIB_GROUP_OPEN[@]}"} \
    ${CXX_LIB_ARGS[@]+"${CXX_LIB_ARGS[@]}"} \
    "$LIB_DIR/libaxl.a" \
    ${EH_LIBS[@]+"${EH_LIBS[@]}"} \
    ${LIB_GROUP_CLOSE[@]+"${LIB_GROUP_CLOSE[@]}"} \
    || { echo "ERROR: linking failed" >&2; rm -rf "$TMPDIR"; exit 1; }

# .eh_frame / .gcc_except_table are UNCONDITIONAL, and measured to be free.
#
# objcopy takes EXACT section names and silently drops anything not listed, so
# without them the unwind tables are linked correctly and then thrown away --
# and that failure surfaces only at runtime, on the first throw.
#
# Naming them on every link rather than only an exceptions one costs a C image
# NOTHING: `cmp` says byte-identical, because --gc-sections has already
# collected the sections in a build that keeps nothing, so there is nothing
# left to copy. The §U2 byte-identity constraint is about IMAGE bytes, and it
# is the KEEP() in the linker script that would break it -- which is why that
# lives in the separate _eh script and this does not. Gating these as well was
# the first shape here, and check-flag-parity correctly rejected it: the
# Makefile and the CMake package would have had to grow the same conditional.
# CONSTRUCTORS THAT NOTHING WILL RUN. AXL walks .init_array only; the linker
# scripts also define __CTOR_LIST__/__CTOR_END__ around the legacy .ctors, and
# nothing reads them. So a non-empty .ctors is silently dead code that a
# consumer wrote expecting it to execute.
#
# This is reachable in exactly one way and it is not hypothetical: GCC's
# x86_64-*-elf target defaults to .ctors, and AXL's own toolchain only escapes
# it via --enable-initfini-array (14.3.0-axl2). Point AXL_X64_GXX at an older
# build -- 14.3.0-axl is still on this machine, and a stale override or a CI
# cache is enough -- and every global constructor stops running with no
# diagnostic anywhere. Measured, same source, two toolchains:
#
#     -axl   __init_array_start == __init_array_end   (empty)
#            __CTOR_LIST__      != __CTOR_END__       (8 bytes, unwalked)
#     -axl2  the reverse
#
# One nm over the .so we already produced. A C image has both pairs empty and
# pays a few milliseconds.
# FAIL CLOSED on a broken toolchain, but do not punish a deliberate strip:
# if nm cannot RUN the check is worthless and that is a misconfiguration of
# exactly the kind this guards, so it is fatal; if nm runs and the symbols are
# simply absent (`-Wl,-s`, or an SDK staged before the linker scripts defined
# them) the image is legitimate and unverifiable, which is a warning.
if ! _ctor_syms="$(${CROSS}nm "$SO_FILE" 2>&1)"; then
    echo "ERROR: ${CROSS}nm could not read $SO_FILE, so the .ctors check" >&2
    echo "       could not run. A check that cannot see is worse than none." >&2
    echo "       $_ctor_syms" >&2
    rm -f "$OUTPUT"; rm -rf "$TMPDIR"; exit 1
fi
_ctor_lo="$(printf '%s\n' "$_ctor_syms" | awk '$3 == "__CTOR_LIST__" { print $1 }')"
_ctor_hi="$(printf '%s\n' "$_ctor_syms" | awk '$3 == "__CTOR_END__" { print $1 }')"
if [[ -z "$_ctor_lo" || -z "$_ctor_hi" ]]; then
    echo "$AXL_PROG: warning: no __CTOR_LIST__/__CTOR_END__ in $SO_FILE, so" >&2
    echo "         constructors landing in .ctors cannot be detected (a" >&2
    echo "         stripped link, or a linker script predating them)." >&2
elif [[ "$_ctor_lo" != "$_ctor_hi" ]]; then
    # Name the compiler that actually produced this link. The guard fires for
    # a pure-C image too -- __attribute__((constructor)) built by a stale
    # AXL_<ARCH>_GCC does it -- and telling that author to fix a C++ override
    # they never set points at the wrong knob.
    if [[ "$CXX_LINK" == "true" ]]; then
        _ctor_cc="$GXX_BIN"; _ctor_var="AXL_${ARCH^^}_GXX"
    else
        _ctor_cc="$GCC_BIN"; _ctor_var="AXL_${ARCH^^}_GCC"
    fi
    echo "ERROR: this image has global constructors in .ctors, which" >&2
    echo "       nothing runs -- AXL walks .init_array only." >&2
    echo "       They would be silently skipped at boot." >&2
    echo "" >&2
    # NAME THE CULPRIT rather than infer a cause. Every input is right here, so
    # ask each one which section it carries instead of guessing from
    # .init_array being empty -- which it legitimately is for any program with
    # no static initialisers, so that heuristic blamed the compiler for this
    # guard's own hand-written .S fixture.
    _ctor_from=""
    for _o in ${OBJS[@]+"${OBJS[@]}"} ${PREBUILT_OBJS[@]+"${PREBUILT_OBJS[@]}"}; do
        if ${CROSS}objdump -h "$_o" 2>/dev/null | grep -q '[ 	]\.ctors'; then
            _ctor_from="$_ctor_from $_o"
        fi
    done
    if [[ -n "$_ctor_from" ]]; then
        echo "       It came from:" >&2
        for _o in $_ctor_from; do echo "         $_o" >&2; done
    fi
    # A freshly COMPILED object carrying .ctors means the compiler did it; a
    # prebuilt one means whoever built that object did. Both can be true.
    _ctor_compiled=false
    for _o in ${OBJS[@]+"${OBJS[@]}"}; do
        case " $_ctor_from " in *" $_o "*) _ctor_compiled=true ;; esac
    done
    if [[ "$_ctor_compiled" == "true" ]]; then
        echo "" >&2
        echo "       That object was compiled by this invocation, so the" >&2
        echo "       compiler is emitting the legacy section:" >&2
        echo "       '$_ctor_cc'" >&2
        echo "       needs --enable-initfini-array; AXL's own toolchain has it" >&2
        echo "       from 14.3.0-axl2 onward. Install the current one:" >&2
        axl_cc_name_toolchain_installer "$ARCH"
        echo "       and clear any stale $_ctor_var override." >&2
    else
        echo "" >&2
        echo "       Nothing this invocation COMPILED carries .ctors, so it" >&2
        echo "       arrived prebuilt. Rebuild that input with the same" >&2
        echo "       toolchain as the rest (see above for which)." >&2
    fi
    # Remove BOTH artefacts of an earlier successful build. The .so is the one
    # a developer would nm/addr2line to diagnose this, so leaving a stale one
    # is worse than leaving a stale .efi -- it answers questions about a
    # different binary.
    rm -f "$OUTPUT" "${OUTPUT%.efi}.so"; rm -rf "$TMPDIR"; exit 1
fi

run_cmd ${CROSS}objcopy \
    -j .text -j .sdata -j .data -j .bss -j .dynamic -j .dynsym \
    -j .rel -j .rela -j .rela.dyn -j .reloc -j .rodata -j .dbgdir \
    -j .eh_frame -j .gcc_except_table \
    --output-target="$PE_TARGET" --subsystem=$SUBSYSTEM \
    "$SO_FILE" "$OUTPUT" || { echo "ERROR: objcopy failed" >&2; rm -rf "$TMPDIR"; exit 1; }

# Patch PE debug directory with module name
"$PE_SET_DEBUG" "$OUTPUT" "$(basename "$OUTPUT")" || {
    echo "ERROR: pe-set-debug failed" >&2; rm -rf "$TMPDIR"; exit 1;
}

# Keep the ELF .so alongside the .efi (has DWARF symbols for addr2line/debugging)
cp "$SO_FILE" "${OUTPUT%.efi}.so"

rm -rf "$TMPDIR"
echo "$OUTPUT"

# --run: launch in QEMU
if [[ "$RUN" == "true" ]]; then
    # Find run-qemu.sh relative to the SDK or in the source tree
    RUN_SCRIPT=""
    if [[ -f "$SDK_DIR/scripts/run-qemu.sh" ]]; then
        RUN_SCRIPT="$SDK_DIR/scripts/run-qemu.sh"
    elif [[ -f "$SCRIPT_DIR/../../scripts/run-qemu.sh" ]]; then
        RUN_SCRIPT="$SCRIPT_DIR/../../scripts/run-qemu.sh"
    fi

    if [[ -z "$RUN_SCRIPT" ]]; then
        echo "ERROR: run-qemu.sh not found (--run requires the AXL source tree)" >&2
        exit 1
    fi

    # Map axl-cc arch names to run-qemu arch names
    case "$ARCH" in
        x64)  QEMU_ARCH="X64" ;;
        aa64) QEMU_ARCH="AARCH64" ;;
        *)    QEMU_ARCH="$ARCH" ;;
    esac

    exec "$RUN_SCRIPT" --arch "$QEMU_ARCH" ${RUN_ARGS[@]+"${RUN_ARGS[@]}"} "$OUTPUT"
fi

#!/bin/bash
# axl — the SDK's front door: run its host-side tools, and manage the install.
#
# TWO JOBS, and the second arrived later than this file did.
#
# 1. A COMMAND DISPATCHER. `axl run-qemu`, `axl rsod-decode`, `axl gdb-syms`,
#    `axl emulate` ... — every host-side script the SDK ships, reachable by
#    name from wherever the SDK happens to be installed.
#
# 2. A VERSION MANAGER. `axl update`, `axl use <version>`, `axl list`,
#    `axl uninstall`, `axl prune` — the install maintains itself, without the
#    user re-fetching anything from a web page.
#
# WHY (1) EXISTS. The host-side scripts used to land on no PATH at all: a
# couple got wrappers and the rest sat at a full path that depended on how the
# SDK had been installed. So the crash handler printed
#
#     rsod-decode.py --syms <build>/X.so --rsod crash-report.txt
#
# as the command to run, and for most users that was `command not found`.
# Consumers then invented their own answer -- a hardcoded path into someone's
# home directory -- and every README, printed hint and consumer script had to
# name a location it could not know. `axl <command>` makes the install location
# stop mattering. AXL-Distribution-Design.md §13; the UEFI-side `axl.efi`
# busybox is the same idiom, so this is its host-side sibling rather than a new
# concept.
#
# WHY (2) LIVES HERE TOO, rather than in a second program. The five verbs are
# spelled out in this file instead of being staged as commands, because they
# are the ONE thing that cannot be a script in libexec/axl: they drive
# `libexec/axl/install.sh`, which is staged mode 0644 precisely so the command
# scan below does NOT offer it as `axl install` (§18.6 -- the install knows its
# own version, prefix and links; a script on a web server knows none of them).
# One name each, deliberately: no `self-update` alias, no separate `install`
# verb. `use` subsumes `install` because they would differ only in whether the
# version happens to be downloaded already, which is not a distinction a user
# should have to make. See §19's D1a.
#
# NOT a wrapper per tool. The command list IS the contents of libexec/axl/, so
# adding a tool to install.sh's staging list adds a subcommand and there is no
# second list to drift from it -- the failure mode `check-flag-parity` exists
# for elsewhere in this tree.
#
# The FILES keep their real names and only the COMMAND drops the extension.
# That is not cosmetic: these scripts locate each other by filename from their
# own directory -- run-qemu.sh does `source "$(dirname "$0")/axl-common.sh"`,
# profile-qemu.sh runs `$SCRIPT_DIR/gdb-syms.py`, axl-emulate execs run-qemu.sh
# from `Path(__file__).resolve().parent`. Staging them under stripped names
# would leave every one of them correct and unable to find the others.
set -uo pipefail

# `readlink -f` FIRST, then `cd -P`. Both halves are load-bearing:
#
#   - readlink -f follows a symlink on $0 itself. `cd -P` alone resolves the
#     DIRECTORY physically but never $0, so `ln -s <prefix>/bin/axl
#     ~/.local/bin/axl` resolved the prefix to ~/.local and every lookup under
#     it failed -- which is exactly the shape install.sh produces, so this file
#     could not be reached through a link until it was fixed.
#   - cd -P keeps what it was here for, the same reason axl-cc does it: on a
#     usrmerge distro /bin is a symlink to /usr/bin, and a logical `cd` would
#     resolve the prefix to `/` instead of `/usr`.
#
# Together they also make the `current` symlink (§12.2) resolve to the
# versioned root it points at, which is what a printed diagnostic should name.
_axl_self="$(readlink -f "$0" 2>/dev/null || echo "$0")"
SCRIPT_DIR="$(cd -P "$(dirname "$_axl_self")" && pwd)"
PREFIX="$(dirname "$SCRIPT_DIR")"
LIBEXEC="$PREFIX/libexec/axl"
VERSION_FILE="$PREFIX/share/axl/version"

# The one-line summary a command carries for `axl --help`, read from the
# command itself rather than from a table here: a table would be a second
# source of truth for a fact the file already states.
cmd_desc() {
    local d
    d=$(sed -n 's/^#[[:space:]]*axl-desc:[[:space:]]*//p' "$1" 2>/dev/null | head -1)
    printf '%s' "$d"
}

# basename -> command name: drop a .sh/.py extension and a leading `axl-`, so
# `rsod-decode.py` is `axl rsod-decode` and `axl-emulate` is `axl emulate`
# rather than `axl axl-emulate`.
cmd_name() {
    local n="${1##*/}"
    n="${n%.sh}"; n="${n%.py}"
    printf '%s' "${n#axl-}"
}

list_commands() {
    [[ -d "$LIBEXEC" ]] || return 0
    local f
    for f in "$LIBEXEC"/*; do
        [[ -f "$f" && -x "$f" ]] || continue
        printf '%s\n' "$(cmd_name "$f")"
    done | sort
}

# command name -> the file that provides it. A scan rather than a table, for
# the same reason the listing is: a table would be a second source of truth.
resolve_command() {
    local want="$1" f
    [[ -d "$LIBEXEC" ]] || return 1
    for f in "$LIBEXEC"/*; do
        [[ -f "$f" && -x "$f" ]] || continue
        if [[ "$(cmd_name "$f")" == "$want" ]]; then
            printf '%s' "$f"
            return 0
        fi
    done
    return 1
}

usage() {
    # STDOUT, NOT STDERR -- and the exit status is a separate question, decided
    # at the call site. A bare `axl` is someone looking for the command list,
    # which is the entire point of this program, so the text must not be behind
    # a redirect. That argument is about the STREAM; it was also used to return
    # 0, which made `axl "$cmd"` with an empty $cmd report success for having
    # done nothing, while `axl use` with no version and `axl <unknown>` both
    # exit 2 for the same class of mistake.
    echo "usage: axl <command> [args ...]"
    echo "       axl update | use <version> | list | uninstall"
    echo "       axl toolchain list [--porcelain] | install [aa64|x64|all]"
    echo "                      | uninstall [--dry-run|-n] <aa64|x64>"
    echo "                      (list names which compiler each arch builds with)"
    echo "                      ('axl update' re-installs the toolchains you"
    echo "                       ALREADY have, at the version the new SDK pins;"
    echo "                       an arch without one is never downloaded."
    echo "                       'axl update --no-toolchain' skips that --"
    echo "                       for an offline box, or one without sudo)"
    echo "       axl version    (manager + SDK; --version is the program alone)"
    echo "       axl --print-prefix | --print-version | --help"
    echo ""
    echo "host commands:"
    local c d f
    while read -r c; do
        [[ -n "$c" ]] || continue
        f=$(resolve_command "$c") || continue
        d=$(cmd_desc "$f")
        if [[ -n "$d" ]]; then
            printf '  %-18s %s\n' "$c" "$d"
        else
            printf '  %s\n' "$c"
        fi
    done < <(list_commands)
    echo ""
    echo "Run 'axl <command> --help' for a command's own options."
    echo ""
    # "Tool" is overloaded four ways here -- these host-side helper scripts,
    # the HOST's own gcc/binutils, AXL's bare-metal CROSS toolchain under
    # /opt, and the target .efi utilities. A bare command list invites the
    # reader to assume this one program fronts all of them. Naming the
    # compiler drivers and where their toolchain comes from removes the guess.
    #
    # THIS TEXT USED TO END "NOT the host's gcc", and v4.7.0 made that false in
    # the release that shipped it: AXL_TOOLCHAIN=auto became the x64 default,
    # so a C build with no bare-metal toolchain installed uses the host's own
    # gcc. The reader most likely to hit that line -- a C-only x64 consumer --
    # was exactly the one the feature exists for, and the help told them they
    # needed the 239 MB install. C++ is refused under host mode on both arches
    # (axl-cc's axl_cc_refuse_cxx_under_host), so that half stays true and is
    # now said separately instead of by implication.
    echo "These commands run on the HOST."
    echo "To compile for UEFI use axl-cc / axl-c++, which build with AXL's bare-metal"
    echo "cross toolchain. On x64, C falls back to the host's own gcc when that"
    echo "toolchain is absent; C++ always needs it."
    echo "Run 'axl toolchain list' to see which compiler each arch will use, and"
    echo "'axl toolchain install' to fetch one."
}

# THE CURRENT SDK, which is not necessarily this script's own prefix. Since
# §20 M2 `axl` is linked out of the MANAGER root, which holds no headers, no
# manifest and no axl-install-toolchain -- all of that is SDK content and has
# to follow `axl use`. Extracted from --print-prefix so the toolchain verb
# cannot resolve it differently; `axl prune` reading the manifest from its own
# prefix is exactly the bug that duplication produces. NOTE axl-prune.sh is a
# separate program and still resolves this inline: it only needs the manifest
# to be readable, so it tests for the FILE rather than for a symlink, and the
# two answers differ if `<root>/axl-sdk` is ever a real directory.
#
# Falls back to $PREFIX when there is no marker -- a source-tree stage, an
# unpacked tarball, or a host-tools-only install all land there, and naming
# your own tree beats naming nothing.
sdk_prefix() {
    local _root _p
    _root="$(dirname "$PREFIX")"
    if [[ -L "$_root/axl-sdk" ]] \
       && _p="$(cd -P "$_root/axl-sdk" 2>/dev/null && pwd)" \
       && [[ -n "$_p" ]]; then
        printf '%s\n' "$_p"
    else
        printf '%s\n' "$PREFIX"
    fi
}

# THE CROSS TOOLCHAIN, resolved ONCE for every arm that asks about it. The
# `toolchain` arm's own comment already refused a second copy for its two
# callers -- `list` would report one root installed while `uninstall` removed a
# different one, and that command ends in `rm -rf`. `update` is the third
# caller and its mistake is the mirror image: it decides from this whether to
# DOWNLOAD a toolchain, so a resolution that disagreed would either fetch ~96 MB
# nobody asked for or silently leave axl-cc on the host compiler. Hence hoisted
# here rather than copied there.

# Snapshot the AXL_<ARCH>_GXX overrides BEFORE anything sources
# axl-toolchains.conf, which defines the neighbouring *_DEFAULT names that the
# `${AXL_<ARCH>_GXX:-$AXL_<ARCH>_GXX_DEFAULT}` resolution falls back to.
_env_aa64_gxx="${AXL_AA64_GXX:-}"
_env_x64_gxx="${AXL_X64_GXX:-}"
_env_aa64_gcc="${AXL_AA64_GCC:-}"
_env_x64_gcc="${AXL_X64_GCC:-}"

# BOTH LAYOUTS, the same two install-toolchain.sh has always tried: an INSTALL
# keeps the manifest in share/axl/, a source checkout keeps it beside the
# scripts. Checking only the installed path would fail for every developer
# running this out of a tree, which is the easiest place to reach for it.
tc_conf_path() {   # tc_conf_path <sdk prefix> -> the manifest path, or status 1
    local _c
    _c="$1/share/axl/axl-toolchains.conf"
    [[ -r "$_c" ]] || _c="$1/scripts/axl-toolchains.conf"
    [[ -r "$_c" ]] || return 1
    printf '%s\n' "$_c"
}

# Sets _v (the pinned version), _o (the AXL_<ARCH>_GXX override, if any), _g
# (the g++ locator) and _d (the toolchain root) for one arch. Requires the
# manifest to have been sourced.
#
# `${AXL_<ARCH>_GXX:-$AXL_<ARCH>_GXX_DEFAULT}` -- the resolution
# axl-toolchains.conf documents and which axl-cc, install.sh and the Makefile
# all use. Reading _DEFAULT alone reported MISSING for anyone who installed
# with `--prefix $HOME/.local/opt` and exported what the installer's own
# print_env told them to, then advised re-downloading 55 MB into /opt.
# _TOOLCHAIN_DIR has no _DEFAULT twin and so no override variable, so when the
# compiler is overridden the root is derived from it -- <root>/bin/<cc>, the
# same shape install-toolchain.sh uses.
# _gc (the C locator) and _oc (its override, if any) are set alongside _g/_o.
# `uninstall` still derives its target from the g++ override alone -- it must
# remove ONE root and the g++ half is the one its messages name -- but `list`
# reports both and tc_installed_arches accepts EITHER.
tc_resolve() {   # tc_resolve <arch>
    case "$1" in
        aa64) _v="${AXL_AA64_TOOLCHAIN_VERSION:-}"
              _o="$_env_aa64_gxx"
              _g="${_o:-${AXL_AA64_GXX_DEFAULT:-}}"
              _oc="$_env_aa64_gcc"
              _gc="${_oc:-${AXL_AA64_GCC_DEFAULT:-}}"
              _d="${AXL_AA64_TOOLCHAIN_DIR:-}" ;;
        x64)  _v="${AXL_X64_TOOLCHAIN_VERSION:-}"
              _o="$_env_x64_gxx"
              _g="${_o:-${AXL_X64_GXX_DEFAULT:-}}"
              _oc="$_env_x64_gcc"
              _gc="${_oc:-${AXL_X64_GCC_DEFAULT:-}}"
              _d="${AXL_X64_TOOLCHAIN_DIR:-}" ;;
        *)    _v=""; _o=""; _oc=""; _g=""; _gc=""; _d="" ;;
    esac
    [[ -n "$_o" ]] && _d="$(dirname "$(dirname "$_g")")"
    # EXPLICIT. A bare `[[ ... ]] && ...` as the last statement makes the
    # function's status the TEST's, so "no override set" would come back to a
    # caller as a failure.
    return 0
}

# IS THIS A USABLE TOOLCHAIN ROOT? Both callers derive a root as
# dirname(dirname(locator)), which only means anything for an absolute path in
# the <root>/bin/<cc> layout. A bare name on PATH -- which tc_have_compiler
# accepts, deliberately -- gives "."; /usr/bin/x86_64-elf-g++, an entirely
# ordinary distro cross-gcc, gives "/usr"; and a locator one component short
# gives "/". None of those is a toolchain root, and each is an answer that
# reads as true: `axl update` would offer to install into the filesystem root,
# and `axl toolchain list` printed /usr as the location and then measured it
# with `du -sh` -- 11G reported as the size of a toolchain.
#
# TWO components, minimum, and absolute. That is the same condition the update
# arm spelled inline as `$_r == /* && $_r != "/" && $(dirname $_r) == /* &&
# $(dirname $_r) != "/"` -- said once here so the two cannot drift, since they
# are the same question about the same derived value.
tc_root_usable() {   # tc_root_usable <path>
    [[ "$1" == /?*/?* ]]
}

# WHICH ARCHES ACTUALLY HAVE A TOOLCHAIN -- one arch name per line, nothing at
# all when none does. `axl update` reads this to decide what to bring along.
#
# ASK THE COMPILER, do not stat the directory: a partial extract leaves the
# directory there and nothing in it, and `axl toolchain list` distinguishes
# those two for the same reason. Getting it wrong here is not a cosmetic
# printout -- a false positive downloads a toolchain onto a consumer who
# deliberately has none.
#
# EITHER LOCATOR COUNTS -- gcc or g++. Probing only g++ meant a consumer who
# located their toolchain with AXL_X64_GCC alone, or whose tree is missing only
# the C++ driver, read MISSING and was declined SILENTLY: the same class of
# silence this function exists to remove, reappearing one layer up. `axl
# toolchain list` reports both locators in fields of their own since §21c, and
# still separates them from the "builds with:" line that asks axl-cc -- so the
# two can legitimately disagree, and §21a.4 records why.
#
# There is deliberately NO "but that compiler is not one of ours" refusal.
# Deciding that would mean inferring provenance from a path or a --version
# string, and a guess is exactly what this tree refuses; the §21 receipt cannot
# stand in either, because every root installed before receipts existed is
# unmarked. Detect it, carry it, and let install-toolchain.sh's own
# already-installed check be the thing that decides whether a fetch happens.
#
# `-x` OR `command -v`: a locator may legitimately hold a bare name resolved on
# PATH rather than an absolute path, which is the shape axl-cc's own presence
# probes use.
tc_have_compiler() {   # tc_have_compiler <path or bare name>
    [[ -n "$1" ]] || return 1
    [[ -x "$1" ]] && return 0
    command -v "$1" >/dev/null 2>&1
}

# WHERE it is installed matters as much as WHETHER, which is why each line
# carries a classification:
#
#     <arch>  default    -      -       -
#     <arch>  elsewhere  <VAR>  <root>  <found>
#
# <found> is the locator VERBATIM and <root> is dirname(dirname(<found>)) --
# useful only when <found> is an absolute path in the <root>/bin/<cc> layout.
# tc_have_compiler deliberately accepts a BARE NAME on PATH, for which <root>
# is "." and means nothing; the caller validates before it prints either.
#
# `default` means the compiler sits at the root the manifest names, which is
# also the only place axl-install-toolchain will ever write. `elsewhere` means
# an AXL_<ARCH>_GCC/_GXX override points somewhere else -- and that is NOT a
# carryable state: install-toolchain.sh resolves the manifest's *_DEFAULT
# paths under INSTALL_ROOT (default /opt) and reads no override at all, so
# carrying it would sudo-install a SECOND toolchain into a root the consumer
# did not choose and leave theirs untouched. Detected, declined, and told why.
#
# COMPARED AGAINST THE MANIFEST DIR, not against tc_resolve's $_d: with a g++
# override in play tc_resolve DERIVES $_d from that override, so the two would
# always compare equal and the case would never fire. The manifest dirs live
# under /opt, which is install-toolchain.sh's INSTALL_ROOT DEFAULT, so that is
# the target it would pick here; a manifest naming a root outside /opt would be
# disagreeing with its own installer, which `make check-toolchain-conf` is the
# gate for.
#
# $INSTALL_ROOT ITSELF IS NOT CONSULTED, deliberately. install-toolchain.sh
# honours it, so a consumer exporting both INSTALL_ROOT and matching locators
# would have a carry land correctly and is declined anyway -- the safe
# direction: a decline costs a printed message, a wrong carry costs a sudo
# download into someone else's tree. install.sh passes no INSTALL_ROOT through,
# so reading it here would mean predicting an environment the installer is not
# guaranteed to see. AXL-Distribution-Design.md 21a.4.
#
# A SUBSHELL, because sourcing the manifest defines a dozen AXL_* names and the
# caller goes on to `exec` install.sh; the update arm must not be reading the
# manifest's idea of a variable it was given on the command line.
tc_installed_arches() {
    local _s _c _a
    _s="$(sdk_prefix)"
    _c="$(tc_conf_path "$_s")" || return 0
    (
        # stdout REDIRECTED while sourcing. A manifest is KEY=VALUE and emits
        # nothing -- but this function's stdout IS its return value, and a
        # tampered or hand-edited file that echoed one line would become an
        # "arch" name that ends up in an install.sh argument.
        # shellcheck source=/dev/null
        . "$_c" >/dev/null 2>&1 || exit 0
        for _a in aa64 x64; do
            tc_resolve "$_a"
            # WHICHEVER LOCATOR ANSWERS FIRST, and whether it was an override.
            # g++ is asked first only so the reported variable matches the one
            # `list` and `uninstall` speak about when both are set.
            _found=""; _fvar=""
            if tc_have_compiler "$_g"; then
                _found="$_g"; [[ -n "$_o" ]]  && _fvar="AXL_${_a^^}_GXX"
            elif tc_have_compiler "$_gc"; then
                _found="$_gc"; [[ -n "$_oc" ]] && _fvar="AXL_${_a^^}_GCC"
            fi
            [[ -n "$_found" ]] || continue
            _mdir="${_d%/}"
            [[ -n "$_o" ]] && case "$_a" in
                aa64) _mdir="${AXL_AA64_TOOLCHAIN_DIR:-}" ;;
                x64)  _mdir="${AXL_X64_TOOLCHAIN_DIR:-}" ;;
            esac
            _mdir="${_mdir%/}"
            _froot="$(dirname "$(dirname "$_found")")"
            # AN EMPTY MANIFEST DIR IS NOT A MATCH. Left as "", it compares
            # equal to nothing and every arch reads `default` -- which is the
            # carry branch, so the safe reading has to be the other one.
            if [[ -n "$_fvar" && ( -z "$_mdir" || "$_froot" != "$_mdir" ) ]]; then
                printf '%s\telsewhere\t%s\t%s\t%s\n' \
                       "$_a" "$_fvar" "$_froot" "$_found"
            else
                printf '%s\tdefault\t-\t-\t-\n' "$_a"
            fi
        done
        exit 0
    )
}

case "${1-}" in
    -h|--help)
        usage
        exit 0
        ;;
    "")
        # The same text on the same stream as --help (test-axl-dispatcher.sh
        # diffs the two), and 2 because no command was given -- see usage().
        usage
        exit 2
        ;;
    list)
        # Reads the filesystem only, so this also works in a package install
        # (where it will correctly find nothing to list).
        _root="$(dirname "$PREFIX")"
        _cur=""
        [[ -L "$_root/axl-sdk" ]] && _cur="$(cd -P "$_root/axl-sdk" 2>/dev/null && pwd)"
        _any=0
        for _d in "$_root"/axl-sdk-[0-9]*; do
            [[ -d "$_d" ]] || continue
            _any=1
            # SIZE, because the very next line of output advises `axl prune`
            # and this is the number that decides whether that is worth
            # running. Best-effort: a du that cannot read the tree prints
            # nothing rather than a zero, since "0" is a claim about disk
            # rather than an admission that it was not measured.
            # -x: stay on one filesystem. These are our own install roots, so
            # a mount inside one is unexpected -- which is the reason not to
            # follow it into whatever it leads to.
            _sz="$(du -shx "$_d" 2>/dev/null | awk '{print $1}')"
            _mark="  "; [[ "$_d" == "$_cur" ]] && _mark="* "
            # TWO FORMATS, so an unmeasured size leaves no trailing blanks.
            if [[ -n "$_sz" ]]; then
                printf '%s%-24s %6s\n' "$_mark" "$(basename "$_d")" "$_sz"
            else
                printf '%s%s\n' "$_mark" "$(basename "$_d")"
            fi
        done
        if [[ "$_any" -eq 0 ]]; then
            echo "no versioned SDK roots under $_root"
            echo "(this prefix was not placed by install.sh -- see 'axl --print-prefix')"
        else
            echo ""
            echo "* = current.  'axl use <version>' switches;  'axl prune' removes old ones."
        fi
        exit 0
        ;;
    update|use|uninstall)
        # Maintenance runs from the copy INSIDE this prefix, so it works
        # without the original download and always matches what is installed.
        # Not commands in libexec/axl (install.sh stages 0644 there, so the
        # command scan skips it) -- they are spelled out here because
        # "update" and "uninstall" are the words people reach for, and
        # `axl install` would be a confusing third spelling of the same thing.
        #
        # ONE name each. rustup and uv say "self update" because they manage
        # OTHER things and must distinguish updating themselves from updating
        # what they installed. `axl` manages nothing else -- the SDK IS the
        # product -- so that distinction does not exist here, and a
        # `self-update` alias would be the same second spelling this comment
        # just refused for `install`.
        # SELF-HEAL BEFORE GIVING UP (§20). install.sh now pins `axl` to the
        # newest prefix that carries a staged installer -- but a user who is
        # ALREADY stranded cannot run install.sh to get that fix, because
        # fetching it is the very thing they lost. So look sideways: any
        # sibling prefix under the same root will do, newest first.
        _inst="$LIBEXEC/install.sh"
        if [[ ! -r "$_inst" ]]; then
            _root="$(dirname "$PREFIX")"
            while read -r _cand; do
                [[ -r "$_cand" ]] || continue
                _inst="$_cand"; break
            done < <(ls -d "$_root"/axl-sdk-*/libexec/axl/install.sh 2>/dev/null \
                     | sort -V -r)
        fi
        if [[ ! -r "$_inst" ]]; then
            echo "axl: no installer at $LIBEXEC/install.sh, and no other" >&2
            echo "     version under $(dirname "$PREFIX") has one either." >&2
            echo "     This SDK was not placed by install.sh (a source-tree" >&2
            echo "     stage, or an unpacked tarball). Re-run install.sh from" >&2
            echo "     the releases page:" >&2
            echo "       curl -fsSLO https://github.com/aximcode/axl-sdk-releases/releases/latest/download/install.sh" >&2
            exit 1
        fi
        _verb="$1"; shift
        _root="$(dirname "$PREFIX")"
        # THE BIN DIR THIS INSTALL WAS MADE WITH, read from where install.sh
        # RECORDED it. Recomputing it from the environment ignored
        # `install.sh --bin-dir` entirely, and the result was silent: `axl use
        # <older>` relinked into ~/.local/bin while the stale links on PATH
        # still pointed at the newer SDK, so the rollback path did not roll
        # back -- axl-cc kept compiling with the version you had just left --
        # and `axl uninstall` cleaned the other directory.
        #
        # NOT INFERRED FROM $0. That was the first fix and it is worse than
        # the bug: with a second symlink in front (a `sudo ln -s
        # ~/.local/bin/axl /usr/local/bin/axl`, an ordinary thing to do)
        # dirname $0 names /usr/local/bin, so `axl use` relinks THERE and
        # leaves the real PATH links stale -- reproducing the exact failure
        # while looking fixed. It also misses `<prefix>/bin/axl use ...`
        # entirely, where $0 is a regular file.
        #
        # THREE RUNGS, each meaning something different: an explicit override,
        # what this install actually recorded, and -- only for a tree
        # install.sh never placed (a source stage, a hand-unpacked tarball) --
        # the default. link_tree writes the file into every prefix it links,
        # the manager included, so a real install always hits rung two.
        #
        # No compatibility rung for installs predating the file: every
        # consumer is re-installed at its next upgrade.
        if [[ -n "${AXL_BIN_DIR:-}" ]]; then
            _bin="$AXL_BIN_DIR"
        elif [[ -r "$PREFIX/share/axl/bin-dir" ]]; then
            _bin="$(cat "$PREFIX/share/axl/bin-dir")"
        else
            _bin="${XDG_BIN_HOME:-$HOME/.local/bin}"
        fi
        case "$_verb" in
            uninstall)
                exec sh "$_inst" --uninstall --prefix "$_root" --bin-dir "$_bin" "$@"
                ;;
            use)
                [[ $# -ge 1 ]] || { echo "axl: use needs a version (try 'axl list')" >&2; exit 2; }
                _v="$1"; shift
                exec sh "$_inst" --use "$_v" --prefix "$_root" --bin-dir "$_bin" "$@"
                ;;
            update)
                # NO --version here, deliberately. "update" means go to the
                # newest; `axl update --version 4.3.0` would be a downgrade
                # wearing the word update. Selecting a version is `axl use`,
                # which is instant when that version is already on disk -- and
                # `axl prune` keeps one previous precisely so it usually is.
                for _a in "$@"; do
                    case "$_a" in
                        --version|--version=*)
                            echo "axl: 'update' always moves to the newest release." >&2
                            echo "     To select a version:  axl use <version>" >&2
                            exit 2
                            ;;
                    esac
                done
                # ARGS THAT ARE NOT AN UPDATE. These reached install.sh
                # unfiltered and each one broke something: `--use <older>`
                # downgraded the manager and re-execed into it; `--uninstall`
                # deleted the manager root and then the fall-through execed a
                # path that no longer existed. They are not update options, so
                # refuse them by name the way `--version` already is.
                for _a in "$@"; do
                    case "$_a" in
                        --use|--use=*|--uninstall|--host-tools)
                            echo "axl: 'update' does not take $_a." >&2
                            echo "     Try:  axl use <version> | axl uninstall" >&2
                            exit 2
                            ;;
                    esac
                done
                # --no-toolchain IS OURS AND IS NOT FORWARDED. install.sh has
                # no such option and would `die "unknown option"` on it -- the
                # default there is already "no toolchain", so the flag has
                # nothing to say to a first install. It exists because carrying
                # the toolchain is now the DEFAULT for `axl update`, and that
                # created a path which fails where it used to succeed: the
                # toolchain install wants network and (for /opt) sudo, so an
                # offline or unprivileged box needs a way to update just the
                # SDK. `--toolchain=` is not that way -- it is undocumented,
                # and the two-word `--toolchain ""` dies on install.sh's
                # `${2:?}` before it means anything.
                #
                # $_upd_args is what BOTH phases forward, so the flag is
                # stripped once rather than in each of the two places that
                # would have to agree.
                _no_tc=0
                _user_tc=0
                _upd_args=()
                for _a in "$@"; do
                    case "$_a" in
                        --no-toolchain)            _no_tc=1 ;;
                        --no-toolchain=*)
                            # SILENT FALL-THROUGH IS THE BUG. Unhandled, this
                            # landed in $_upd_args and install.sh died with
                            # "unknown option" naming a flag the user had every
                            # reason to think existed.
                            echo "axl: --no-toolchain takes no value (got '$_a')." >&2
                            exit 2
                            ;;
                        --toolchain|--toolchain=*) _user_tc=1
                                                   _upd_args+=("$_a") ;;
                        *) _upd_args+=("$_a") ;;
                    esac
                done
                # BOTH AT ONCE IS A CONTRADICTION, and silently letting
                # --toolchain win would install the very thing the other flag
                # asked to skip. Refused HERE, beside the other arg refusals
                # and BEFORE the manager phase -- a validation error must not
                # cost a manager update first.
                if [[ "$_no_tc" -eq 1 && "$_user_tc" -eq 1 ]]; then
                    echo "axl: --no-toolchain and --toolchain contradict each other." >&2
                    echo "     Pick one." >&2
                    exit 2
                fi
                # AN INVALID VARIANT IS AN ERROR, not a silent "carry
                # anyway": an `axl update` that ignored a typo in AXL_TOOLCHAIN
                # would fetch the toolchain the user was trying to opt out of.
                # axl-cc refuses the same value with the same four names. It
                # exits 1 and this exits 2, matching the other refusals in this
                # arm -- the TREATMENT matches, the number deliberately does
                # not.
                #
                # HERE, beside the other argument checks and ABOVE the manager
                # phase, for the same reason the contradiction above is: a
                # validation error must not first cost a manager self-update
                # and a re-exec.
                case "${AXL_TOOLCHAIN:-auto}" in
                    auto|axl|host|cross) ;;
                    *)
                        echo "axl: AXL_TOOLCHAIN=$AXL_TOOLCHAIN is not a toolchain variant." >&2
                        echo "     Use auto, axl, host or cross -- see axl-cc --help." >&2
                        exit 2
                        ;;
                esac
                # WHAT THE MANAGER PHASE GETS, as a whitelist rather than
                # "$@". `--toolchain` is meaningful for the SDK and `die`s on
                # a --host-tools install -- AFTER link_tree has already moved
                # the manager, so it produced a false "could not update" and
                # skipped the re-exec. `--prune` there would prune against the
                # wrong component.
                _mgr_args=()
                _skip_next=0
                for _a in ${_upd_args[@]+"${_upd_args[@]}"}; do
                    if [[ "$_skip_next" -eq 1 ]]; then _skip_next=0; continue; fi
                    case "$_a" in
                        --toolchain|--prune) [[ "$_a" == --toolchain ]] && _skip_next=1
                                             continue ;;
                        --toolchain=*)       continue ;;
                        *) _mgr_args+=("$_a") ;;
                    esac
                done

                # SELF-UPDATE FIRST, then re-exec the new `axl` to do the SDK.
                #
                # The manager holds this program AND the install.sh every verb
                # execs, so updating the SDK with the OLD installer means a fix
                # to install.sh lands one update later than the release that
                # carried it. Doing the manager first and re-execing makes the
                # fix apply to THIS run.
                #
                # THE VERSION FILE DECIDES, NOT THE EXIT STATUS. install.sh
                # does the update in link_tree and then runs five advisory
                # steps that can each `die` -- a system package check, the
                # toolchain, prune. Any of those turned a manager that HAD
                # updated into "could not update" and suppressed the re-exec.
                if [[ -z "${AXL_SELF_UPDATED:-}" ]]; then
                    _mgr="$_root/axl-sdk-host-tools"
                    _mv_before=""
                    [[ -r "$_mgr/share/axl/version" ]] \
                        && _mv_before="$(cat "$_mgr/share/axl/version")"
                    sh "$_inst" --host-tools --prefix "$_root" \
                       --bin-dir "$_bin" "${_mgr_args[@]}" || _mgr_rc=$?
                    _mv_after=""
                    [[ -r "$_mgr/share/axl/version" ]] \
                        && _mv_after="$(cat "$_mgr/share/axl/version")"
                    if [[ -n "$_mv_after" && "$_mv_after" != "$_mv_before" \
                          && -x "$_mgr/bin/axl" ]]; then
                        echo "axl: updating the manager first: ${_mv_before:-none} -> $_mv_after"
                        AXL_SELF_UPDATED=1 exec "$_mgr/bin/axl" update "$@"
                    elif [[ -n "${_mgr_rc:-}" ]]; then
                        echo "axl: could not update the manager (exit $_mgr_rc);" \
                             "continuing with the SDK" >&2
                    fi
                fi
                # THE INSTALLER MAY BE GONE. The manager phase can remove the
                # root $_inst lives in, and exec-ing a deleted path fails with
                # a raw "cannot open". Re-resolve through the same sibling scan
                # that un-strands an install above.
                if [[ ! -r "$_inst" ]]; then
                    while read -r _cand; do
                        [[ -r "$_cand" ]] || continue
                        _inst="$_cand"; break
                    done < <(ls -d "$_root"/axl-sdk-*/libexec/axl/install.sh 2>/dev/null \
                             | sort -V -r)
                fi
                [[ -r "$_inst" ]] || {
                    echo "axl: no installer left under $_root after the manager step" >&2
                    exit 1
                }
                # BRING THE TOOLCHAIN ALONG -- but ONLY for arches that
                # already have one.
                #
                # WHY AT ALL. The SDK pins the toolchain: axl-toolchains.conf
                # ships INSIDE the SDK, so a new SDK naming a newer gcc used to
                # move the SDK and leave the compiler behind. Since x64
                # defaults to AXL_TOOLCHAIN=auto that failure is SILENT --
                # axl-cc quietly falls back to the host gcc for C instead of
                # saying anything -- so "update" was leaving the install in a
                # state the user could not see.
                #
                # WHY NEVER UNCONDITIONALLY. A C-only consumer with no
                # toolchain is exactly who `auto` was built for, and handing
                # them a ~55-96 MB download during a routine update would undo
                # it. Per-arch for the same reason: an x64-only user must not
                # receive aa64.
                #
                # ORDER IS THE WHOLE TRICK: this runs BEFORE the exec below,
                # against the manifest of the SDK the user has RIGHT NOW. Ask
                # afterwards and the manifest names the version they are about
                # to get, so "is it installed?" answers about the wrong thing
                # -- it would report every arch missing and fetch nothing, on
                # precisely the upgrade that needed it.
                #
                # It reuses install.sh's own `--toolchain x64|aa64|all`, so
                # there is no second install path to keep in step.
                # $_user_tc / $_no_tc were settled with the other argument
                # checks, above the manager phase.
                #
                # PRECEDENCE: AXL-Distribution-Design.md §21a.4a has the
                # table, and this comment deliberately does NOT restate it.
                # The restated copy is exactly what drifted -- five rows here
                # against seven there, with the row numbers in the prose
                # pointing at different cases in each. One owner.
                # DECLINED, AND SAID SO. An AXL_<ARCH>_GCC/_GXX override is
                # an explicit statement, exactly like AXL_TOOLCHAIN=host --
                # and carrying such an arch would not move their toolchain, it
                # would sudo-install a SECOND one into a root they never chose
                # and leave theirs beside it. Declining silently would be the
                # defect; declining loudly, with a command that actually helps,
                # is the answer.
                #
                # THE PREFIX IS DERIVED, SO IT IS VALIDATED. `_froot` is
                # dirname(dirname(locator)), which only means anything for an
                # absolute path in the <root>/bin/<cc> layout. A bare name on
                # PATH (which tc_have_compiler accepts, deliberately) gives
                # ".", and /usr/bin/x86_64-elf-g++ -- an entirely ordinary
                # distro cross-gcc -- gives a PREFIX of "/". Printing either
                # would be telling someone to install a toolchain into their
                # working directory or into the root of the filesystem, which
                # is worse than printing no command at all. When the prefix is
                # not usable, name the path we found and hand back the generic
                # form with the directory left to them.
                tc_decline_override() {   # <arch> <var> <root> <found>
                    local _a="$1" _v="$2" _r="$3" _f="$4" _pfx
                    # The PARENT of the root -- where a second toolchain would
                    # be installed beside theirs. Needed by the remedy below,
                    # not by the validation: tc_root_usable answers the same
                    # question this used to ask of $_pfx directly ("the root is
                    # absolute with at least two components"), so the check
                    # moved to the shared predicate and this stayed.
                    _pfx="$(dirname "$_r")"
                    echo "axl: $_a is located by $_v, outside the root the SDK pins:"
                    # LABELLED. This is the LOCATOR -- the compiler itself --
                    # not the root; unlabelled under a line ending "the root
                    # the SDK pins:" it read as one.
                    echo "       compiler: $_f"
                    echo "     NOT updating it. axl-install-toolchain only ever writes"
                    echo "     <prefix>/<pinned-name> and reads no $_v, so carrying it"
                    echo "     here would install a SECOND toolchain under /opt and leave"
                    echo "     yours where it is."
                    if tc_root_usable "$_r"; then
                        # ALWAYS QUOTED, and AFTER the validation above -- a
                        # quoted value no longer starts with "/", so quoting
                        # first would fail the `== /*` test and send every such
                        # prefix down the generic branch.
                        #
                        # ALWAYS, not "when it contains a space". Quoting only
                        # spaces fixes the instance and leaves the class: a
                        # prefix holding a quote, a $ or a backtick still pastes
                        # broken, and the last of those pastes as a COMMAND. The
                        # escape below is the standard one -- close, escaped
                        # quote, reopen -- so the result is safe for any byte.
                        _pfx="'${_pfx//\'/\'\\\'\'}'"
                        echo "     Install the newly pinned one beside yours with:"
                        echo "       axl toolchain install $_a --prefix $_pfx"
                    else
                        echo "     That locator is not a <root>/bin/<compiler> path, so there is"
                        echo "     no prefix to infer. Pick one yourself:"
                        echo "       axl toolchain install $_a --prefix <dir>"
                    fi
                    # NOT "moves yours forward": it does not. It writes a NEW
                    # root beside theirs and touches neither the old tree nor
                    # the variable pointing at it.
                    echo "     That writes a NEW root and does not modify yours -- $_v still"
                    echo "     points at the old one until you re-export what it prints."
                }
                _tc_arg=()
                if [[ "$_user_tc" -eq 0 && "$_no_tc" -eq 0 ]]; then
                    _have=(); _seen=()
                    _el_a=(); _el_v=(); _el_r=(); _el_f=()
                    # WHITELIST both fields, not "non-empty". What goes into
                    # $_tc_arg is handed straight to install.sh, which validates
                    # it and `die`s -- and a routine `axl update` failing on a
                    # manifest oddity would be a worse bug than the one this
                    # fixes.
                    #
                    # COLLECTED, NOT PRINTED HERE. §21a.4a puts
                    # AXL_TOOLCHAIN=host ABOVE the override case, and printing
                    # inside this loop inverted that: a host user with an
                    # override got the --prefix advice before the variable was
                    # even consulted. Same outcome, wrong story.
                    # IFS=TAB, not the default whitespace: the fields are
                    # tab-separated for a reason -- a toolchain under
                    # "/home/my dir/..." splits into six on spaces, so $_froot
                    # became "/home/my" and PASSED the absolute-and-not-"/"
                    # guard, printing `--prefix /home`. A wrong path that looks
                    # plausible is worse than an obviously wrong one.
                    while IFS=$'\t' read -r _a _how _fvar _froot _ffound; do
                        case "$_a" in aa64|x64) ;; *) continue ;; esac
                        case "$_how" in
                            default)   _have+=("$_a"); _seen+=("$_a") ;;
                            elsewhere) _seen+=("$_a")
                                       _el_a+=("$_a"); _el_v+=("$_fvar")
                                       _el_r+=("$_froot"); _el_f+=("$_ffound") ;;
                        esac
                    done < <(tc_installed_arches)
                    if [[ "${#_seen[@]}" -eq 0 ]]; then
                        # NOTHING INSTALLED, so nothing to carry -- and nothing
                        # to say. An empty $_tc_arg leaves install.sh's
                        # maybe_toolchain returning at its first line, which is
                        # the behaviour every existing consumer already has.
                        :
                    elif [[ "${AXL_TOOLCHAIN:-}" == "host" || "${AXL_TOOLCHAIN:-}" == "cross" ]]; then
                        # DECLINED, AND SAID SO. The user has stated they build
                        # with another compiler, so a leftover AXL root under
                        # /opt is not a request to refresh it -- downloading
                        # tens of MB onto someone who opted out is exactly the
                        # foisting this feature's hard constraint forbids.
                        # `cross` is the same case: the caller supplies their
                        # own locators and the manifest defaults are
                        # deliberately not consulted.
                        #
                        # Asked AFTER the probe, not before, so this narrates a
                        # real decision instead of announcing one about nothing
                        # on every update of a machine that has no toolchain at
                        # all. The outcome is unchanged either way -- intent
                        # outranks what is on disk.
                        # $_seen, not $_have: an override-located arch is
                        # installed too, and naming only the carryable ones
                        # would print an empty list on a machine where every
                        # arch is override-located.
                        echo "axl: AXL_TOOLCHAIN=$AXL_TOOLCHAIN -- NOT updating the ${_seen[*]} cross"
                        echo "     toolchain, although it is installed: you have said you build"
                        echo "     with another compiler."
                        # THE CARRY-ANYWAY ADVICE IS ONLY TRUE FOR AN ARCH AT
                        # THE PINNED ROOT. Offered unconditionally it told an
                        # override-located consumer to run --toolchain, which
                        # installs a SECOND toolchain under /opt -- the exact
                        # overpromise the override decline was fixed for, on the
                        # other branch. Only reachable with AXL_TOOLCHAIN=host
                        # AND an override, which is why it survived until a test
                        # set both.
                        if [[ "${#_have[@]}" -gt 0 ]]; then
                            echo "     Carry it anyway with:"
                            echo "       axl update --toolchain <aa64|x64|all>"
                        fi
                        if [[ "${#_el_a[@]}" -gt 0 ]]; then
                            echo "     NOTE ${_el_a[*]} is located by an AXL_<ARCH>_GCC/_GXX override,"
                            echo "     outside the root the SDK pins, so --toolchain would install a"
                            echo "     SECOND toolchain under /opt rather than update it. For that:"
                            echo "       axl toolchain install <arch> --prefix <dir>"
                        fi
                    else
                        # THE OVERRIDE DECLINES, printed only now -- below the
                        # variant check, matching §21a.4a.
                        _i=0
                        while [[ "$_i" -lt "${#_el_a[@]}" ]]; do
                            tc_decline_override "${_el_a[$_i]}" "${_el_v[$_i]}" \
                                                "${_el_r[$_i]}" "${_el_f[$_i]}"
                            _i=$((_i + 1))
                        done
                        if [[ "${#_have[@]}" -eq 2 ]]; then
                            _tc_arg=(--toolchain all)
                        elif [[ "${#_have[@]}" -eq 1 ]]; then
                            _tc_arg=(--toolchain "${_have[0]}")
                        fi
                    fi
                fi
                # NOTHING IS ANNOUNCED HERE. install.sh's maybe_toolchain()
                # carries the whole message, because main() returns at
                # already_installed() BEFORE reaching it -- so a line printed
                # here promised a ~55-96 MB download on `axl update` against an
                # already-current install and then did nothing, which is this
                # feature's own "say what you are doing" guarantee inverted on
                # its most common invocation.
                exec sh "$_inst" --prefix "$_root" --bin-dir "$_bin" \
                     ${_tc_arg[@]+"${_tc_arg[@]}"} \
                     ${_upd_args[@]+"${_upd_args[@]}"}
                ;;
        esac
        ;;
    version)
        # `axl --version` is the PROGRAM version, which since §20 M2 is the
        # MANAGER's -- and that is the conventional meaning, so it stays. But
        # on a real install it answers a different question than the one people
        # are usually asking, and the two legitimately diverge: `axl use
        # <older>` moves the SDK and deliberately not the manager. Before this
        # verb the SDK version was reachable only as a PATH, via
        # --print-prefix, which a human then had to read a version out of.
        #
        # A SUBCOMMAND, not another flag: it is a status report, and the flag
        # spelling is already taken by the thing it would be confused with.
        # ONE-WORD LABELS in column 1, so this is greppable without
        # ambiguity: `axl version | awk '$1=="sdk"{print $2}'`. The first
        # draft printed "axl (manager)" and a test asserting the version as a
        # SUBSTRING passed against `unknown`, because the version also appears
        # inside the prefix path on the same line. Substrings lie.
        _root="$(dirname "$PREFIX")"
        _mgr_v="unknown"
        [[ -r "$PREFIX/share/axl/version" ]] && _mgr_v="$(cat "$PREFIX/share/axl/version")"
        [[ -r "$PREFIX/VERSION" ]] && _mgr_v="$(cat "$PREFIX/VERSION")"
        printf '%-9s %-10s %s\n' "manager" "$_mgr_v" "$PREFIX"
        # NOT INSTALLED is a different fact from "installed at this version".
        # sdk_prefix() falls back to $PREFIX when there is no marker, which is
        # right for --print-prefix ("naming your own tree beats naming
        # nothing") but wrong under a row LABELLED sdk: on a host-tools-only
        # install it printed the manager's version and path as the SDK's, and
        # the two then compared equal so nothing flagged it.
        _sdk="$(sdk_prefix)"
        # ASK FOR THE COMPILER, not for the marker. sdk_prefix() falls back to
        # $PREFIX when there is no marker -- right for --print-prefix, wrong
        # under a row LABELLED sdk, because on a host-tools-only install it
        # printed the manager's version and path as the SDK's and the two then
        # compared equal so nothing flagged it. Testing the marker instead
        # over-corrected: a source checkout has no marker either, and it does
        # have an SDK. `bin/axl-cc` is what an SDK prefix has and a manager
        # prefix by definition does not.
        if [[ ! -x "$_sdk/bin/axl-cc" ]]; then
            printf '%-9s %s\n' "sdk" "(not installed)"
            echo ""
            echo "Install one:  axl update"
            exit 0
        fi
        _sdk_v="unknown"
        [[ -r "$_sdk/share/axl/version" ]] && _sdk_v="$(cat "$_sdk/share/axl/version")"
        [[ -r "$_sdk/VERSION" ]] && _sdk_v="$(cat "$_sdk/VERSION")"
        printf '%-9s %-10s %s\n' "sdk" "$_sdk_v" "$_sdk"
        if [[ "$_mgr_v" != "$_sdk_v" ]]; then
            echo ""
            # WHICH WAY ROUND, because the two directions need opposite advice
            # and this used to give one answer to both.
            #
            # Manager NEWER than the SDK is the ordinary state after `axl use
            # <older>`; nothing is wrong and "axl update moves both" is true.
            #
            # Manager OLDER is the state the 4.7.0 release notes tell people to
            # look for -- and for it, "axl update moves both" is exactly wrong:
            # a manager from 4.6.0 or earlier predates the code that updates
            # the manager, so the `axl` being asked cannot carry itself. It
            # needs one bootstrap. Sending that reader to `axl update` sends
            # them to the one command that cannot fix it, which is worse than
            # saying nothing, and it left them comparing two numbers by eye
            # against a web page to find out which case they were in.
            if [[ -n "$_mgr_v" && -n "$_sdk_v" \
                  && "$_mgr_v" != "unknown" && "$_sdk_v" != "unknown" ]] \
               && [[ "$(printf '%s\n%s\n' "$_mgr_v" "$_sdk_v" | sort -V | head -1)" == "$_mgr_v" ]]; then
                echo "The manager is OLDER than the SDK. A manager this old cannot"
                echo "update itself -- it predates the code that does -- so it takes"
                echo "one bootstrap, once per machine:"
                echo ""
                echo "  curl -fsSLO https://github.com/aximcode/axl-sdk-releases/releases/latest/download/install.sh"
                echo "  sh install.sh --host-tools"
                echo ""
                echo "After that, 'axl update' moves both."
            else
                # Not a warning: it is the normal state after `axl use <older>`,
                # and saying so beats leaving the reader to wonder.
                echo "The manager is versioned separately and does not follow"
                echo "'axl use'. 'axl update' moves both."
            fi
        fi
        echo ""
        echo "toolchains:  axl toolchain list"
        exit 0
        ;;
    toolchain)
        # THREE OPERATIONS: list, install, uninstall. This said "TWO, and there
        # is deliberately no third" until x64 defaulted to AXL_TOOLCHAIN=auto,
        # which made the toolchain's PRESENCE the thing that selects the
        # compiler (AXL-Host-Toolchain-Design.md §6.2). Removing it stopped
        # being a tidy-up and became how a user chooses host gcc, so it had to
        # become a managed operation carrying the §21 ownership guard rather
        # than an `rm -rf` typed by hand at a path read out of a manifest.
        #
        # There is still no `update` HERE, and that is the sentence the old
        # comment was really making: the toolchain is not user-versioned, the
        # SDK prefix pins it, so an `axl toolchain update` would be a second,
        # silently divergent way to change what axl-cc compiles with. What
        # moves a toolchain is moving the SDK, and `axl update` now carries
        # along the arches that already have one (AXL-Distribution-Design.md
        # §21a) -- the same fact, spelled by the verb that owns SDK versions.
        # A third operation is not a fourth.
        shift
        _sdk="$(sdk_prefix)"
        # ONE conf check and ONE resolution for the whole program: tc_conf_path
        # and tc_resolve are defined at the top of this file, because `axl
        # update` reads them too. A second copy would not merely disagree in a
        # printout -- `list` would report one root installed while `uninstall`
        # removed a different one, and that command ends in `rm -rf`.
        _conf="$(tc_conf_path "$_sdk")" || _conf=""
        tc_need_conf() {
            [[ -n "$_conf" ]] && return 0
            # BOTH candidates. Naming only the fallback pointed an installed
            # user at a checkout path that never exists.
            echo "axl toolchain: no axl-toolchains.conf. Looked in:" >&2
            echo "     $_sdk/share/axl/axl-toolchains.conf" >&2
            echo "     $_sdk/scripts/axl-toolchains.conf" >&2
            echo "     so there is nothing to report. A host-tools-only" >&2
            echo "     install has no toolchain to pin." >&2
            exit 1
        }
        case "${1-list}" in
            list)
                shift
                # --porcelain: THE MACHINE CONTRACT, and the reason the human
                # layout below could finally be laid out for a human.
                #
                # There was no machine form, so every caller parsed the human
                # one by COLUMN INDEX -- `awk '$1 == "x64" { print $4 }'` for
                # the root, field 3 compared for equality, field 5 for the C
                # locator. Twenty-five such sites across two test files. The
                # cost was not the parsing; it was that the rendering could no
                # longer move. The C state had to be APPENDED as a fifth column
                # rather than placed beside its sibling, so the line read
                # `x64  14.3.0-axl3  g++:installed  /opt/...  gcc:installed`
                # with the PATH sandwiched between the two compiler states, and
                # three paragraphs of comment here defended the positions.
                #
                # TAB-SEPARATED, not JSON. Every consumer of this is a shell
                # script, `awk -F'\t'` needs nothing installed, and jq is not
                # in install.sh's need_cmd set -- test-host-deps-minimal.sh
                # pins exactly that. One field per fact, and the POSITION is
                # the label, so the gcc:/g++: prefixes that disambiguated them
                # in prose are not repeated here:
                #
                #   1 arch      aa64 | x64
                #   2 version   the manifest's pinned version
                #   3 root      absolute path, or the literal (unset)
                #   4 gcc       installed | MISSING
                #   5 g++       installed | MISSING
                #   6 builds    axl | host | cross | unknown
                #   7 reason    free text, never empty, never a tab
                _porcelain=0
                if [[ "${1-}" == "--porcelain" ]]; then
                    _porcelain=1
                    shift
                fi
                if [[ $# -gt 0 ]]; then
                    echo "axl toolchain list: takes no arguments (got '$1')" >&2
                    exit 2
                fi
                tc_need_conf
                # shellcheck source=/dev/null
                . "$_conf"
                [[ "$_porcelain" -eq 1 ]] || printf 'Toolchains pinned by %s\n' "$_sdk"
                _missing=""
                for _a in aa64 x64; do
                    tc_resolve "$_a"
                    # ASK THE COMPILER, do not stat the directory. A partial
                    # extract leaves the directory there and nothing in it,
                    # which is precisely the state worth distinguishing.
                    #
                    # BOTH LOCATORS, separately. `axl update` carries an arch
                    # when EITHER answers, and the "builds with" line below
                    # resolves x64's C-only `auto` off the C compiler -- so a
                    # machine with gcc and no g++ is a real state that three
                    # different readers care about differently. Reporting one
                    # number for both is what made two lines of this command
                    # look like they contradicted each other.
                    #
                    # NOTE tc_have_compiler, not `-x`: a locator holding a bare
                    # name resolved on PATH counts as installed here too, which
                    # is what `axl update` has always meant by installed.
                    if tc_have_compiler "$_gc"; then _cstate="installed"; else _cstate="MISSING"; fi
                    if tc_have_compiler "$_g";  then _gstate="installed"; else _gstate="MISSING"; fi
                    # KEYED ON g++ for the install hint, because what a missing
                    # g++ costs is C++ -- which no amount of gcc replaces.
                    [[ "$_gstate" == "installed" ]] || _missing="$_missing $_a"
                    # A USABLE ROOT, or the placeholder -- and `/` is not a
                    # usable root. tc_resolve derives the root from an override
                    # as dirname(dirname($_g)), so a malformed
                    # AXL_X64_GXX=/nonexistent/g++ resolves to `/`: the listing
                    # printed it as the toolchain location, and the size lookup
                    # below then ran `du -sh /` and walked the entire
                    # filesystem to report 389G as the toolchain-s size. Same
                    # shape the uninstall arm already refuses by name -- an
                    # empty entry, a relative path or `/` -- because there it
                    # ends in `rm -rf`. It is worth refusing here too: naming
                    # `/` as the root is an answer that reads as true.
                    # A WELL-FORMED root is printable; an EXISTING one can
                    # also be measured. Two questions, because a toolchain that
                    # is merely not installed yet has a perfectly good path to
                    # name ("would install to ..."), while "/usr" or "." has
                    # none -- and the porcelain contract promises field 3 is an
                    # absolute path or the (unset) placeholder, never a
                    # relative one.
                    if tc_root_usable "$_d"; then
                        _droot="$_d"
                        if [[ -d "$_d" ]]; then _root_ok=1; else _root_ok=0; fi
                    else
                        _droot="(unset)"
                        _root_ok=0
                    fi

                    # WHICH COMPILER WILL ACTUALLY BUILD -- the question a
                    # reader opens this command to answer. CALLS axl-cc
                    # --print-toolchain rather than re-deriving the resolution
                    # here: axl-cc's own comment at that flag names this verb
                    # as the intended caller, and two programs computing one
                    # fact is the drift check-flag-parity exists for, one layer
                    # up.
                    #
                    # Do NOT read $_g (the g++ locator) for this: x64's C-only
                    # 'auto' resolution probes the GCC locator, and a machine
                    # with a working C compiler and no C++ one would be
                    # reported 'host' here -- wrong, and it looks right,
                    # because $_g really is MISSING on that machine.
                    _tcw=""
                    _tcrc=0
                    _tcerr=""
                    if [[ -x "$_sdk/bin/axl-cc" ]]; then
                        # Capture stderr too, not just the exit status: when
                        # axl-cc refuses a combination (AXL_TOOLCHAIN=host on
                        # aa64, §4.2) it already NAMES the reason on stderr --
                        # discarding it and just saying 'exited 1' would throw
                        # away a remedy §6.3 says to keep. Falls back to
                        # /dev/null if mktemp itself fails, so a probe that
                        # cannot even get a scratch file still degrades to the
                        # plain 'exited N' message instead of erroring out.
                        _tcerrf="$(mktemp 2>/dev/null || echo /dev/null)"
                        _tcw="$("$_sdk/bin/axl-cc" --arch "$_a" --print-toolchain 2>"$_tcerrf")"
                        _tcrc=$?
                        _tcerr="$(head -1 "$_tcerrf" 2>/dev/null)"
                        _tcerr="${_tcerr#ERROR: }"
                        [[ "$_tcerrf" != /dev/null ]] && rm -f "$_tcerrf"
                    fi
                    # An unanswerable probe (no axl-cc, an OLD one that does
                    # not know --print-toolchain, a refused combination such
                    # as AXL_TOOLCHAIN=host on aa64) must read as a NAMED
                    # 'unknown', never as a silent blank or a confident guess
                    # -- guessing here would be the exact failure this line
                    # exists to prevent, just moved one level up.
                    #
                    # ONE decision, TWO renderings. The token and its reason
                    # are computed once into $_builds/$_why and then printed
                    # by whichever format was asked for; the human line used to
                    # BE the decision, which is why nothing else could read it.
                    _cxx_note=""
                    if [[ ! -x "$_sdk/bin/axl-cc" ]]; then
                        _builds="unknown"; _why="no axl-cc at $_sdk/bin/axl-cc"
                    elif [[ $_tcrc -ne 0 ]]; then
                        _builds="unknown"
                        if [[ -n "$_tcerr" ]]; then
                            _why="axl-cc: $_tcerr"
                        else
                            _why="axl-cc --print-toolchain exited $_tcrc"
                        fi
                    elif [[ -z "$_tcw" ]]; then
                        _builds="unknown"; _why="axl-cc --print-toolchain produced no output"
                    elif [[ "$_tcw" != "axl" && "$_tcw" != "host" && "$_tcw" != "cross" ]]; then
                        _builds="unknown"; _why="axl-cc --print-toolchain said $_tcw"
                    elif [[ -n "${AXL_TOOLCHAIN:-}" && "$AXL_TOOLCHAIN" != "auto" ]]; then
                        _builds="$_tcw"
                        # shellcheck disable=SC2016  # the text NAMES the variable
                        _why='pinned by $AXL_TOOLCHAIN'
                    elif [[ "$_a" == "aa64" ]]; then
                        _builds="axl"; _why="aa64 has no host option"
                    elif [[ "$_tcw" == "axl" ]]; then
                        _builds="axl"; _why="auto -> axl: bare-metal toolchain installed"
                    else
                        _builds="host"; _why="auto -> host: no bare-metal toolchain installed"
                        _cxx_note="C++ needs the bare-metal toolchain: axl toolchain install x64"
                    fi

                    # FIELD 7 IS FREE TEXT, so it is the one field that can
                    # carry a tab or a newline and split the row a parser is
                    # promised. Two of its sources are outside this program:
                    # axl-cc's stderr, and -- in the branch entered BECAUSE the
                    # output was not one of the three known words -- axl-cc's
                    # whole stdout. Folded to spaces rather than rejected: the
                    # text is a diagnostic, and a mangled diagnostic beats a
                    # row that does not parse.
                    _why="${_why//$'\t'/ }"
                    _why="${_why//$'\n'/ }"
                    if [[ "$_porcelain" -eq 1 ]]; then
                        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
                               "$_a" "${_v:-(unset)}" "$_droot" \
                               "$_cstate" "$_gstate" "$_builds" "$_why"
                        continue
                    fi

                    # ── the human rendering ───────────────────────────────
                    #
                    # ONE FACT PER LINE, in the order a reader asks for them:
                    # is it there, where is it and how much disk is that, what
                    # exactly is it, and what will actually compile. The path
                    # gets its own line because it is 50-60 characters and was
                    # previously wedged between two status words.
                    case "$_cstate/$_gstate" in
                        installed/installed) _state="gcc + g++" ;;
                        installed/MISSING)   _state="gcc only, no C++" ;;
                        MISSING/installed)   _state="g++ only" ;;
                        *)                   _state="not installed" ;;
                    esac
                    # SIZE, because `axl toolchain uninstall` exists to reclaim
                    # it and this is where the decision gets made. Best-effort:
                    # a du that fails or a root that is not there yet prints
                    # nothing rather than a zero, since "0" is a claim.
                    _size=""
                    if [[ "$_root_ok" -eq 1 ]]; then
                        _size="$(du -sh "$_d" 2>/dev/null | awk '{print $1}')"
                    fi
                    # TWO FORMATS, so an unmeasured size leaves no trailing
                    # blanks on the line rather than a column of them.
                    if [[ -n "$_size" ]]; then
                        printf '\n  %-5s %-14s %-18s %s\n' \
                               "$_a" "${_v:-(unset)}" "$_state" "$_size"
                    else
                        printf '\n  %-5s %-14s %s\n' \
                               "$_a" "${_v:-(unset)}" "$_state"
                    fi
                    if [[ "$_root_ok" -eq 1 ]]; then
                        printf '        %s\n' "$_droot"
                    elif [[ "$_droot" == "(unset)" ]]; then
                        # Neither "here it is" nor "here is where it would go":
                        # there is no path to name. Saying "would install to
                        # (unset)" was a sentence built from a placeholder.
                        printf '        no usable toolchain root -- check the manifest, or an override\n'
                    else
                        # NOT the same sentence as an installed root. An absent
                        # one is a path that does not exist yet, and printing it
                        # bare reads as a location you could go and look at.
                        printf '        would install to %s\n' "$_droot"
                    fi
                    # The compiler's own --version, from whichever locator
                    # answered. g++ first: it is the one that decides whether
                    # C++ is available at all.
                    if [[ "$_gstate" == "installed" ]]; then
                        printf '        %s\n' "$("$_g" --version 2>/dev/null | head -1)"
                    elif [[ "$_cstate" == "installed" ]]; then
                        printf '        %s\n' "$("$_gc" --version 2>/dev/null | head -1)"
                    fi
                    printf '        builds with: %s -- %s\n' "$_builds" "$_why"
                    [[ -z "$_cxx_note" ]] || printf '        %s\n' "$_cxx_note"
                done
                # COLLAPSE TO `all`. install-toolchain.sh parses ONE target
                # and takes the last, so `install aa64 x64` installs x64 only,
                # silently -- and printing the arches side by side advised
                # exactly that, on the fresh-machine path where both are
                # missing and this is the first command anyone runs.
                #
                # HUMAN ONLY: advice is not part of the machine contract, and a
                # trailing line that is sometimes there and sometimes not is
                # exactly what a parser must not have to skip.
                if [[ "$_porcelain" -eq 1 ]]; then
                    :
                elif [[ "$_missing" == " aa64 x64" ]]; then
                    printf '\ninstall with:  axl toolchain install all\n'
                elif [[ -n "$_missing" ]]; then
                    printf '\ninstall with:  axl toolchain install%s\n' "$_missing"
                fi
                exit 0
                ;;
            install)
                shift
                _inst_tc="$_sdk/bin/axl-install-toolchain"
                if [[ ! -x "$_inst_tc" ]]; then
                    echo "axl toolchain: no axl-install-toolchain at $_inst_tc" >&2
                    echo "     That program is SDK content. This looks like a" >&2
                    echo "     host-tools-only install, which has no compiler to" >&2
                    echo "     install a toolchain for." >&2
                    exit 1
                fi
                # NO DEFAULT ARCH HERE. install-toolchain.sh documents its own
                # (aa64), and restating it would be a second spelling that can
                # drift from the one that actually runs.
                exec "$_inst_tc" "$@"
                ;;
            uninstall)
                # THE THIRD OPERATION (AXL-Host-Toolchain-Design.md §6.2). See
                # the block comment at the top of this arm for why it exists;
                # what follows is why it is this cautious. It is the only verb
                # in this file that ends in `rm -rf`, at a path READ OUT OF A
                # CONFIG FILE, so the whole body is a sequence of things that
                # must be true before the removal is reached -- and a root it
                # cannot positively identify is refused rather than guessed at.
                shift
                # --dry-run|-n, same spelling `axl prune` uses (axl-prune.sh),
                # may come before or after the arch. Stripped in one pass so
                # the positional parsing below still sees exactly the single
                # arch argument it always expected.
                _dry=0
                _rest=()
                for _arg in "$@"; do
                    case "$_arg" in
                        --dry-run|-n) _dry=1 ;;
                        *) _rest+=("$_arg") ;;
                    esac
                done
                set -- "${_rest[@]}"
                _a="${1-}"
                case "$_a" in
                    aa64|x64) ;;
                    *)
                        echo "axl toolchain uninstall: needs an arch (aa64|x64)" >&2
                        # ONE ARCH AT A TIME, deliberately unlike `install`,
                        # which takes `all`. `install all` retries a download;
                        # `uninstall all` would delete two trees from one typo.
                        echo "     There is no 'all' here: this removes a directory tree." >&2
                        exit 2 ;;
                esac
                shift
                if [[ $# -gt 0 ]]; then
                    echo "axl toolchain uninstall: takes one arch (got '$1')" >&2
                    exit 2
                fi
                tc_need_conf
                # shellcheck source=/dev/null
                . "$_conf"
                tc_resolve "$_a"
                _d="${_d%/}"
                # The locator that MOVES this target. Named in three messages
                # below rather than spelled out three times.
                _gxxvar="AXL_${_a^^}_GXX"
                # The root remedy, in one place because two branches print it
                # and they must not drift. sudo SCRUBS the environment, so an
                # AXL_<ARCH>_GXX that is moving the target right now will not be
                # set under sudo -- and root would then resolve the MANIFEST's
                # root, not the one the message just named. Say so, but only
                # when an override is actually in play.
                _sudo_hint() {
                    echo "     Re-run as root:" >&2
                    echo "       sudo $_axl_self toolchain uninstall $_a" >&2
                    [[ -n "$_o" ]] || return 0
                    echo "     NOTE: this target comes from $_gxxvar, which sudo" >&2
                    echo "     clears -- pass it through, or root will resolve the" >&2
                    echo "     manifest's root instead:" >&2
                    echo "       sudo $_gxxvar=$_g $_axl_self toolchain uninstall $_a" >&2
                }
                # THE PATH ITSELF, before anything looks inside it. An empty
                # manifest entry, a relative path or `/` are each one
                # substitution away from removing something that is not a
                # toolchain, and `rm -rf --` would carry all three out.
                if [[ -z "$_d" || "$_d" != /?* ]]; then
                    echo "axl toolchain uninstall: the manifest names no usable root" >&2
                    echo "     for $_a (got '${_d:-<empty>}'). Refusing: this removes a" >&2
                    echo "     directory tree and will not act on a path it cannot" >&2
                    echo "     identify. Check $_conf" >&2
                    exit 1
                fi
                if [[ -L "$_d" ]]; then
                    # `rm -rf` on a symlink removes the LINK and leaves the
                    # tree, so `list` would report MISSING while the bytes
                    # stayed on disk -- and on x64 that flips the `auto`
                    # default to host while freeing nothing. An uninstall that
                    # lies is worse than one that refuses.
                    echo "axl toolchain uninstall: $_d is a symlink, not a" >&2
                    echo "     toolchain root. Removing it would delete the link and" >&2
                    echo "     leave the tree it points at. Refusing; remove the link" >&2
                    echo "     yourself if that is what you meant." >&2
                    exit 1
                fi
                if [[ ! -d "$_d" ]]; then
                    # NOT AN ERROR. `uninstall` is asked for an END STATE and
                    # the end state already holds -- the same reason `rm -f`
                    # exists. A non-zero exit here would fail every script that
                    # runs it twice. It still has to SAY so: a silent 0 cannot
                    # be told from a removal.
                    echo "axl toolchain uninstall: nothing to remove -- $_a is not"
                    echo "     installed at $_d"
                    # WHERE A RELOCATED INSTALL LANDS, and it said nothing here
                    # before. install-toolchain.sh --prefix installs under
                    # <prefix>/<manifest basename> while the manifest keeps
                    # naming /opt, so this is exactly the branch that user
                    # arrives at -- and `axl toolchain list` is already
                    # reporting MISSING for the same reason. The installer's own
                    # print_env tells them to export the locator; this says
                    # which one moves the target HERE. Deliberately not a
                    # --prefix flag: that would clone relocated_dir()'s
                    # semantics into the one command that ends in `rm -rf`, and
                    # sharing tc_resolve with `list` is what keeps uninstall
                    # symmetric with the verb a user consults first.
                    if [[ -z "$_o" ]]; then
                        echo "     If you installed it somewhere else"
                        echo "     (axl-install-toolchain --prefix ...), export the"
                        echo "     locator that install printed: $_gxxvar moves this"
                        echo "     target, exactly as it moves 'axl toolchain list'."
                    fi
                    exit 0
                fi
                # OWNERSHIP, NOT A NAME PATTERN (AXL-Distribution-Design.md
                # §21) -- the same file, the same keys and the same remedy
                # `axl prune` uses in axl-prune.sh's prune_family(). A
                # toolchain we did not install is outside the policy, so it is
                # refused rather than removed: the manifest can be pointed at
                # anything, including a developer's own unpacked toolchain, and
                # this is the end of the guard that ends in `rm -rf`. Inventing
                # a second ownership rule here is the drift check-flag-parity
                # exists for, with one of the two copies eventually being the
                # permissive one.
                _rcpt="$_d/.axl-receipt"
                if [[ ! -r "$_rcpt" ]]; then
                    echo "axl toolchain uninstall: $_d carries no .axl-receipt," >&2
                    echo "     so this install did not place it and will not remove" >&2
                    echo "     it. If it IS ours, re-mark it:" >&2
                    echo "       axl-install-toolchain $_a" >&2
                    exit 1
                fi
                # READ it, do not SOURCE it. Whether this directory is ours is
                # the question still being answered, and `. "$_rcpt"` would run
                # whatever is in it to find out -- under sudo, when /opt needs
                # it. It would also overwrite the manifest variables just
                # resolved, including $_d.
                _rk="$(sed -n 's/^AXL_RECEIPT_KIND=//p' "$_rcpt" | head -1)"
                _ra="$(sed -n 's/^AXL_RECEIPT_ARCH=//p' "$_rcpt" | head -1)"
                if [[ "$_rk" != "toolchain" || "$_ra" != "$_a" ]]; then
                    # A RECEIPT IS NOT ENOUGH, THE RIGHT RECEIPT IS. Same file
                    # name, different owner: an SDK root's receipt, or the
                    # other arch's, must not license this deletion.
                    echo "axl toolchain uninstall: $_rcpt is not a receipt for" >&2
                    echo "     this: KIND='${_rk:-<none>}' ARCH='${_ra:-<none>}', expected" >&2
                    echo "     KIND='toolchain' ARCH='$_a'. Refusing." >&2
                    echo "     If it IS ours, re-mark it:" >&2
                    echo "       axl-install-toolchain $_a" >&2
                    exit 1
                fi
                # REMOVING A DIRECTORY ENTRY NEEDS WRITE ON THE PARENT, not on
                # the tree. /opt is root-owned on most machines, and a
                # half-deleted toolchain is worse than one still installed --
                # `list` probes the compiler, so a tree with its bin/ gone
                # reads as MISSING while the bytes remain.
                # A DRY RUN MUST NOT FAIL FOR A CONDITION THAT ONLY AFFECTS
                # THE REAL RUN. This check fires on the ordinary configuration
                # -- /opt root-owned, the toolchain inside it user-owned -- and
                # running it before the report meant `uninstall --dry-run`
                # exited 1 with "cannot remove" and answered none of what was
                # asked: what would go, how big, how many files. That is the
                # moment the answer is worth most, because it is what you read
                # before deciding to type sudo. `axl prune --dry-run` on the
                # same box previews and exits 0; two dry runs in one program
                # with opposite contracts is a coin flip for the reader.
                #
                # So under --dry-run this becomes part of the REPORT. Every
                # other guard still refuses a dry run, because each says the
                # TARGET is wrong (bad arch, unusable path, symlink, missing,
                # wrong receipt) rather than that the caller lacks a privilege.
                _parent="$(dirname "$_d")"
                _needs_root=0
                if [[ ! -w "$_parent" ]]; then
                    if [[ "$_dry" -eq 1 ]]; then
                        _needs_root=1
                    else
                        echo "axl toolchain uninstall: cannot remove $_d --" >&2
                        echo "     $_parent is not writable by $(id -un)." >&2
                        _sudo_hint
                        exit 1
                    fi
                fi
                # EVERY GUARD ABOVE HAS RUN -- arch, path shape, symlink,
                # not-installed, receipt KIND+ARCH -- and nothing has been
                # renamed or removed yet. This is the last point that is true,
                # so it is where --dry-run reports and stops, same spelling and
                # style as `axl prune --dry-run`.
                if [[ "$_dry" -eq 1 ]]; then
                    _sz="$(du -sh "$_d" 2>/dev/null | awk '{print $1}')"
                    _nf="$(find "$_d" -type f 2>/dev/null | wc -l | tr -d ' ')"
                    echo "axl toolchain uninstall: would remove $_d"
                    if [[ -n "$_sz" ]]; then
                        echo "     ${_sz}, ${_nf} file(s) -- dry run, nothing removed"
                    else
                        echo "     ${_nf} file(s) -- dry run, nothing removed"
                    fi
                    if [[ "$_needs_root" -eq 1 ]]; then
                        # ON STDOUT, via the hint's own stderr redirected here:
                        # the same words are an ERROR's remedy in the refusal
                        # above and part of the ANSWER inside a preview the
                        # caller asked for, and a preview split across two
                        # streams reads as half a report plus a warning.
                        echo "     the real run needs root: $_parent is not writable" \
                             "by $(id -un)"
                        _sudo_hint 2>&1
                    fi
                    exit 0
                fi
                # RENAME FIRST, then remove the renamed path. Moving an entry
                # out of a directory needs exactly the permission unlinking it
                # needs, so this is refused in every case the unlink would be --
                # but it is refused HAVING DESTROYED NOTHING, whereas `rm -rf`
                # in place descends first and delivers the same refusal only
                # after the compiler is already gone.
                #
                # That is what makes the guarantee real, because the `-w` check
                # above is ADVISORY. Measured: a sticky, world-writable parent
                # holding an entry owned by someone else leaves `-w` TRUE while
                # both the rename and the unlink are refused, and `rm -rf`
                # empties the tree on the way to finding out. (An immutable bit
                # is the same shape. A read-only mount is NOT -- access(2)
                # returns EROFS, so `-w` does see that one, and it sees an ACL
                # too.) Prevention, not a post-hoc detector.
                #
                # $$ in the staging name, and it must not already exist: `mv`
                # onto an EXISTING directory moves the source INSIDE it instead
                # of failing, so a leftover from an interrupted run would nest
                # silently rather than be refused.
                _stage="$_d.axl-removing.$$"
                if [[ -e "$_stage" ]]; then
                    echo "axl toolchain uninstall: $_stage already exists." >&2
                    echo "     Refusing rather than removing through a path this run" >&2
                    echo "     did not create. Delete it by hand and retry." >&2
                    exit 1
                fi
                if ! mv -- "$_d" "$_stage"; then
                    echo "axl toolchain uninstall: could not move $_d aside," >&2
                    echo "     so NOTHING was removed and the toolchain is untouched." >&2
                    echo "     Removing a directory entry needs write permission on" >&2
                    echo "     $_parent, which this user does not effectively have." >&2
                    _sudo_hint
                    exit 1
                fi
                rm -rf -- "$_stage"
                # ASK, do not assume. The rename cleared every parent-side
                # refusal, but something INSIDE the tree can still decline to be
                # deleted, and `rm -rf` reports that on stderr where a caller
                # reading stdout will not see it. Reporting a clean removal over
                # bytes that are still on disk is the one outcome worse than
                # refusing -- and the root is out of the manifest's way by now,
                # so this is a report, not a rollback.
                if [[ -e "$_stage" ]]; then
                    echo "axl toolchain uninstall: $_d was moved aside to" >&2
                    echo "     $_stage but could not be deleted -- something inside" >&2
                    echo "     the tree refused. $_a is uninstalled as far as the" >&2
                    echo "     manifest is concerned; those bytes are still on disk" >&2
                    echo "     and are yours to remove." >&2
                    exit 1
                fi
                echo "axl toolchain uninstall: removed $_d"
                # WHAT CHANGED AS A RESULT, not just what was deleted. On x64
                # the toolchain's presence is exactly what AXL_TOOLCHAIN=auto
                # selects on, so this command has just moved the default
                # compiler -- which is the point, and otherwise invisible until
                # the next build behaves differently.
                #
                # RE-PROBE, do not assume. A fixed "now builds with host" line
                # is true only when the root just removed was the ONLY x64
                # toolchain reachable -- a second one still reachable via
                # AXL_X64_GCC or another manifest root means the removal did
                # not change the answer at all, and a confident wrong line
                # here, from the verb that just ran `rm -rf`, is worse than
                # saying nothing. Same probe `list` uses (axl-cc
                # --print-toolchain), so the two verbs cannot disagree.
                if [[ "$_a" == "x64" ]]; then
                    _postw=""
                    _postrc=0
                    _posterr=""
                    if [[ -x "$_sdk/bin/axl-cc" ]]; then
                        _posterrf="$(mktemp 2>/dev/null || echo /dev/null)"
                        _postw="$("$_sdk/bin/axl-cc" --arch x64 --print-toolchain 2>"$_posterrf")"
                        _postrc=$?
                        _posterr="$(head -1 "$_posterrf" 2>/dev/null)"
                        _posterr="${_posterr#ERROR: }"
                        [[ "$_posterrf" != /dev/null ]] && rm -f "$_posterrf"
                    fi
                    if [[ ! -x "$_sdk/bin/axl-cc" ]]; then
                        echo "     Could not confirm what x64 now builds with:"
                        echo "     no axl-cc at $_sdk/bin/axl-cc."
                    elif [[ $_postrc -ne 0 ]]; then
                        if [[ -n "$_posterr" ]]; then
                            echo "     Could not confirm what x64 now builds with:"
                            echo "     $_posterr"
                        else
                            echo "     Could not confirm what x64 now builds with:"
                            echo "     axl-cc --print-toolchain exited $_postrc."
                        fi
                    elif [[ -z "$_postw" ]]; then
                        echo "     Could not confirm what x64 now builds with:"
                        echo "     axl-cc --print-toolchain produced no output."
                    elif [[ "$_postw" == "host" ]]; then
                        echo "     x64 now builds with the host compiler (auto -> host)."
                        echo "     C++ needs the bare-metal toolchain:"
                        echo "       axl toolchain install x64"
                    elif [[ "$_postw" == "axl" ]]; then
                        echo "     x64 STILL builds with a bare-metal toolchain --"
                        echo "     another one is still reachable (a second"
                        echo "     AXL_X64_GCC, or another manifest root). This"
                        echo "     removal did not change what a build uses."
                    else
                        echo "     x64 now resolves to '$_postw'. Run"
                        echo "       axl toolchain list"
                        echo "     to see the reasoning."
                    fi
                fi
                exit 0
                ;;
            update)
                echo "axl toolchain: there is no 'update' -- the SDK version pins" >&2
                echo "     the toolchain, so moving between toolchains is:" >&2
                echo "       axl use <version>      # then: axl toolchain install" >&2
                exit 2
                ;;
            *)
                echo "axl toolchain: unknown subcommand '$1'" >&2
                echo "Usage: axl toolchain list [--porcelain] | install [aa64|x64|all]" >&2
                echo "                      | uninstall [--dry-run|-n] <aa64|x64>" >&2
                exit 2
                ;;
        esac
        ;;
    --print-prefix)
        # AXL-Distribution-Design.md §6 lists this as MISSING and names the
        # cost: it is why a consumer hardcodes /usr/include/axl-sdk. Bare
        # value, no banner -- it is a machine interface.
        #
        # IT NAMES THE CURRENT SDK, NOT WHERE THIS SCRIPT LIVES. Every path a
        # consumer wants from it -- headers, libs, share/axl/pci-ids.json5 --
        # is SDK content, so it has to follow `axl use`. Answering with $PREFIX
        # was right only while `axl` was always inside the active SDK, and it
        # stopped being true the same day: §20's M1 pins `axl` to the newest
        # prefix carrying an installer, so after `axl use <older>` this
        # reported the NEWER tree. M2 breaks it further by moving `axl` into a
        # manager root that holds no headers at all.
        #
        # Falls back to $PREFIX when there is no `current` marker -- a
        # source-tree stage, an unpacked tarball, or a host-tools-only install
        # all land there, and naming your own tree beats naming nothing.
        printf '%s\n' "$(sdk_prefix)"
        exit 0
        ;;
    --print-version|--version)
        # TWO callers, two shapes. --print-version is a machine interface, like
        # --print-prefix beside it: a bare value, no banner. --version is the
        # human one and matches every other AXL command -- "<prog> <version>",
        # the shape AXL_TOOL_MAIN gives all 37 target tools. Answering both
        # with a bare string made `axl` the one command whose --version output
        # you could not tell from a stray line of build noise.
        # Staged: `cat` the file install.sh wrote from the tree's VERSION, so
        # nothing here can disagree with what was installed. Run from a
        # CHECKOUT there is no such file, and the source copy used to answer
        # "no version file at .../share/axl/version" and exit 1 -- the one AXL
        # command that could not say what it was.
        # CHECKOUT FIRST. A staged prefix has no top-level VERSION file, so
        # this only fires in a source tree -- where it must win, because
        # `install.sh --prefix .` leaves a share/axl/version at the repo root
        # that then answers for whatever build was last installed there. That
        # inversion is the exact wrong answer axl-cc refuses outright, and
        # reading VERSION_FILE first reintroduced it here.
        if [[ -r "$PREFIX/VERSION" ]]; then
            AXL_VER="$(cat "$PREFIX/VERSION")"
        elif [[ -r "$VERSION_FILE" ]]; then
            AXL_VER="$(cat "$VERSION_FILE")"
        else
            echo "axl: no version file at $VERSION_FILE" >&2
            exit 1
        fi
        if [[ "$1" == "--version" ]]; then
            printf 'axl %s\n' "$AXL_VER"
        else
            printf '%s\n' "$AXL_VER"
        fi
        exit 0
        ;;
esac

CMD="$1"; shift

if ! TARGET=$(resolve_command "$CMD"); then
    # Name the command back rather than printing usage: the user typed
    # something specific and the useful information is which word failed.
    echo "axl: unknown command '$CMD'" >&2
    echo "Run 'axl --help' for the list of commands." >&2
    exit 2
fi

# exec, so the subcommand inherits this process: its exit status is ours
# without forwarding, signals reach it directly, and `axl run-qemu` under a
# timeout kills QEMU rather than a shell that is waiting on it.
exec "$TARGET" "$@"

#!/bin/bash
# axl-c++ — convenience wrapper around axl-cc that forces C++ mode
# for every source regardless of extension.  Mirrors the gcc/g++
# convention: scripts that want explicit-C++ semantics use this
# alias; axl-cc itself dispatches by file extension.
set -euo pipefail

# `readlink -f` first, so a symlink INTO this prefix resolves to the real
# file. `cd -P` alone resolves the DIRECTORY physically but never follows a
# symlink on $0 itself, so `ln -s <prefix>/bin/axl ~/.local/bin/axl` made the
# prefix resolve to ~/.local and every lookup under it fail. That is exactly
# the shape a `curl | sh` installer produces.
#
# It still does what `cd -P` was here for: on a usrmerge distro /bin is a
# symlink to /usr/bin, and a `current` symlink (AXL-Distribution-Design.md
# §12.2) still resolves to the versioned root it points at -- readlink -f
# resolves the whole chain, directories included.
_axl_self="$(readlink -f "$0" 2>/dev/null || echo "$0")"
SCRIPT_DIR="$(cd -P "$(dirname "$_axl_self")" && pwd)"
# Pass our own name through: exec leaves $0 as axl-cc's path (a #! script takes
# argv from the kernel, so `exec -a` cannot rename it), and without this the
# help, --version and error messages all name axl-cc instead of what the user
# actually ran.
AXL_CC_PROGNAME="$(basename "$0")" exec "$SCRIPT_DIR/axl-cc" -x c++ "$@"

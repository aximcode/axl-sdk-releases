#!/usr/bin/env python3
# axl-desc: replay a captured hardware fixture under QEMU
# axl-emulate -- replay a captured hardware fixture under QEMU.
#
# Phase HF3 of the Hardware Fixture Capture & Replay design (see
# docs/AXL-Hardware-Fixture-Design.md). Wraps run-qemu.sh: takes a
# fixture directory produced by mkfixture.efi (HF2) or hand-crafted
# from dmidecode/acpidump (HF1), translates each artifact into the
# corresponding low-level run-qemu.sh flag, applies the default-drop
# ACPI denylist, and execs run-qemu.sh.
#
# Layered cleanly on the HF1 primitives in run-qemu.sh — this tool
# never duplicates the QEMU launching machinery; it just decides
# which primitives to invoke.
#
# Future phases land here, NOT in run-qemu.sh:
#   HF4: --usb-shim, --edid, --gpu-rom, --cpu-from-fixture, --mac
#   HF5: TPM event-log → swtpm NVChip seeding
#   HF6: Secure Boot / boot-vars vars.fd injection
#   HF7: Redfish mock spawn (DMTF Redfish-Mockup-Server)
#   HF8: IPMI sim spawn (OpenIPMI ipmi_sim)
from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time
from dataclasses import dataclass, field
from pathlib import Path

# ACPI tables we drop by default on replay. Two categories,
# both for the same underlying reason: replaying them on top of
# OVMF's auto-generated tables breaks the guest. See
# AXL-Hardware-Fixture-Design.md §"ACPI replay caveats" for the
# rationale.
#
# 1. Core singleton tables (FACP/FACS/DSDT): ACPI singletons whose
#    bodies contain absolute physical pointers (FACP→FACS, FACP→DSDT,
#    FACP→PM register blocks, DSDT→AML opregion addresses). QEMU's
#    `-acpitable` APPENDS to the RSDT alongside QEMU's own (verified
#    in hw/i386/acpi-build.c:2594-2600) and does NOT fix up body
#    pointers — only the header is rewritten. OVMF passes the captured
#    table through `EFI_ACPI_TABLE_PROTOCOL.InstallAcpiTable`, which
#    has special semantics for these three signatures (per UEFI ACPI
#    Table Protocol spec): it follows FIRMWARE_CTRL/DSDT/AML
#    references during install, dereferences source-platform addresses
#    that don't exist in QEMU's memory map, and hangs the boot.
#    Verified by per-table bisection against the Proxmox fixture.
#
# 2. Platform-topology: describe the source platform's PCIe
#    layout, NUMA topology, serial console — none of which match
#    QEMU's emulated platform. MCFG is the canonical case (captured
#    ECAM base != QEMU's, every ECAM read returns 0xFF).
#
# Why some tables with absolute pointers are NOT here: BERT (boot
# error region), BGRT (boot graphic image), FPDT (perf records),
# MCHI (BMC interface), etc. all have physical pointers in their
# bodies per ACPI 6.5. They don't hang because OVMF/Linux don't
# DEREFERENCE those pointers on the boot path — BERT is only read
# if there's a logged error, BGRT if the OS chooses to render the
# logo, etc. Stale captured pointers are inert. Add to this list
# only when an actual hang or misbehavior is observed (per
# feedback_verify_before_diverging in memory).
#
# Both categories drop by default. The user can re-enable any
# specific table with --keep-acpi NAME if they have a real reason
# (e.g., axl-acpi parser tests that want to exercise a specific
# captured DSDT). --strict-acpi reduces the denylist to MCFG only,
# matching the design doc's "minimum viable filtering" mode.
CORE_FIRMWARE_DENYLIST = {
    "FACP",  # Fixed ACPI Description Table (FADT) — singleton
    "FACS",  # Firmware ACPI Control Structure — singleton, pointed-to by FACP
    "DSDT",  # Differentiated System Description Table — singleton, AML
}
TOPOLOGY_DENYLIST = {
    "MCFG",  # PCIe ECAM map
    "MPST",  # memory power state
    "PMTT",  # platform memory topology
    "HMAT",  # heterogeneous memory attributes
    "SLIT",  # NUMA proximity distances
    "SRAT",  # NUMA system resource affinity
    "SPCR",  # serial console redirection
    "DBG2",  # debug port table 2
}
DEFAULT_DENYLIST = CORE_FIRMWARE_DENYLIST | TOPOLOGY_DENYLIST
STRICT_DENYLIST = {"MCFG"}


@dataclass
class Artifacts:
    """Typed view of the artifacts found in a fixture directory.
    Replaces dict[str, object] returns so pylance-strict doesn't
    require isinstance() boilerplate at every consumer."""

    smbios: Path | None = None
    acpi: list[Path] = field(default_factory=list)
    spd: list[tuple[str, Path]] = field(default_factory=list)
    tpm_dir: Path | None = None
    manifest: dict[str, object] | None = None
    nic_macs: list[str] = field(default_factory=list)  # net.json permanent MACs
    cpu_spec: str | None = None  # cpu.json → QEMU -cpu override spec


def acpi_signature(path: Path) -> str:
    """Return the 4-byte ASCII signature at the start of an ACPI
    table file. Decoded with 'replace' so non-ASCII bytes don't
    crash the loader. Returns "" for empty / short files (caller
    treats this as 'unknown signature, keep' since malformed blobs
    are surfaced via warn_malformed_acpi)."""
    raw = path.read_bytes()[:4]
    if len(raw) < 4:
        return ""
    return raw.decode("ascii", "replace")


def warn_malformed_acpi(tables: list[Path]) -> None:
    """Surface .dat files that look bogus (too short / non-ASCII
    signature) BEFORE QEMU sees them — QEMU's diagnostic for these
    is cryptic, ours is actionable."""
    for path in tables:
        raw = path.read_bytes()[:4]
        if len(raw) < 4:
            print(
                f"WARN: {path}: too short to contain an ACPI signature "
                f"({len(raw)} bytes); will pass to QEMU unchecked",
                file=sys.stderr,
            )
            continue
        sig = raw.decode("ascii", "replace")
        if any(c == "�" or not c.isprintable() for c in sig):
            print(
                f"WARN: {path}: 4-byte signature is non-ASCII ({raw!r}); "
                f"will pass to QEMU unchecked",
                file=sys.stderr,
            )


def discover_artifacts(fixture: Path) -> Artifacts:
    """Walk the fixture directory and return a typed view of the
    artifacts we know how to replay."""
    smbios = fixture / "smbios.bin"
    acpi_dir = fixture / "acpi"
    spd_dir = fixture / "spd"
    tpm_dir = fixture / "tpm"
    manifest_file = fixture / "manifest.json"

    acpi_tables: list[Path] = []
    if acpi_dir.is_dir():
        acpi_tables = sorted(p for p in acpi_dir.iterdir() if p.is_file() and p.suffix == ".dat")

    # Filename convention: spd/0xNN.bin. The address is recovered
    # from the stem so the user doesn't have to repeat themselves.
    spd_blobs: list[tuple[str, Path]] = []
    if spd_dir.is_dir():
        for p in sorted(spd_dir.iterdir()):
            if not (p.is_file() and p.suffix == ".bin"):
                continue
            addr = p.stem  # "0x50.bin" -> "0x50"
            spd_blobs.append((addr, p))

    manifest: dict[str, object] | None = None
    if manifest_file.is_file():
        try:
            manifest = json.loads(manifest_file.read_text())
        except (OSError, json.JSONDecodeError) as exc:
            # Don't block replay on a corrupt manifest — just warn.
            print(
                f"WARN: manifest.json present but unreadable: {exc}",
                file=sys.stderr,
            )

    nic_macs = read_nic_macs(fixture / "net.json")
    cpu_spec = read_cpu_spec(fixture / "cpu.json")

    return Artifacts(
        smbios=smbios if smbios.is_file() else None,
        acpi=acpi_tables,
        spd=spd_blobs,
        tpm_dir=tpm_dir if tpm_dir.is_dir() else None,
        manifest=manifest,
        nic_macs=nic_macs,
        cpu_spec=cpu_spec,
    )


def read_nic_macs(net_json: Path) -> list[str]:
    """Extract per-NIC hardware addresses from a captured net.json
    (HF2.3 device manifest). Prefers each NIC's permanent_mac, falling
    back to its current mac. Empty / all-zero / unreadable → []. The
    --mac replay knob wires the first of these onto the QEMU NIC."""
    if not net_json.is_file():
        return []
    try:
        data = json.loads(net_json.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        print(f"WARN: net.json present but unreadable: {exc}", file=sys.stderr)
        return []
    # Tolerate a hand-edited net.json whose shape is off (valid JSON but
    # not the expected {nics: [{...}]}) — warn and skip, never traceback.
    if not isinstance(data, dict):
        print("WARN: net.json is not a JSON object — ignoring", file=sys.stderr)
        return []
    nics = data.get("nics", [])
    if not isinstance(nics, list):
        return []
    macs: list[str] = []
    for nic in nics:
        if not isinstance(nic, dict):
            continue
        mac = nic.get("permanent_mac") or nic.get("mac") or ""
        mac = str(mac).strip()
        # Skip empty / all-zero addresses — they can't identify a NIC.
        if mac and set(mac) - {"0", ":"}:
            macs.append(mac)
    return macs


def read_cpu_spec(cpu_json: Path) -> str | None:
    """Translate a captured cpu.json (HF2.2 manifest) into a QEMU -cpu
    spec for the --cpu-from-fixture replay knob. x86_64 → qemu64 with
    vendor/family/model/stepping overrides; aarch64 → `max` with the
    captured MIDR_EL1. Returns None (and warns) when cpu.json is
    missing / malformed / an unsupported arch / carries no usable
    identity, so replay proceeds on the default model."""
    if not cpu_json.is_file():
        return None
    try:
        data = json.loads(cpu_json.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        print(f"WARN: cpu.json present but unreadable: {exc}", file=sys.stderr)
        return None
    if not isinstance(data, dict):
        print("WARN: cpu.json is not a JSON object — ignoring", file=sys.stderr)
        return None

    arch = str(data.get("arch", "")).lower()
    if arch == "x86_64":
        parts = ["qemu64"]
        vendor = data.get("vendor")
        if isinstance(vendor, str) and vendor:
            parts.append(f"vendor={vendor}")
        for key in ("family", "model", "stepping"):
            val = data.get(key)
            if isinstance(val, int):
                parts.append(f"{key}={val}")
        # Only meaningful if at least one identity field was present.
        return ",".join(parts) if len(parts) > 1 else None
    if arch == "aarch64":
        midr = data.get("midr_el1")
        if isinstance(midr, str) and midr:
            return f"max,midr={midr}"
        return None
    print(
        f"WARN: --cpu-from-fixture: unsupported cpu.json arch "
        f"{arch!r} — no -cpu override",
        file=sys.stderr,
    )
    return None


def filter_acpi(
    tables: list[Path],
    denylist: set[str],
    keep: set[str],
) -> tuple[list[Path], list[tuple[Path, str]]]:
    """Partition the ACPI tables into kept and dropped. Returns
    (kept, dropped) where dropped is [(path, signature), ...] for
    diagnostic logging. Signature is the 4-byte ASCII at offset 0
    of each .dat file (NOT the filename — capture tools may write
    lowercase filenames while the spec-defined signature is upper)."""
    kept: list[Path] = []
    dropped: list[tuple[Path, str]] = []
    for path in tables:
        sig = acpi_signature(path).upper()
        if sig in denylist and sig not in keep:
            dropped.append((path, sig))
        else:
            kept.append(path)
    return kept, dropped


def qarg(*tokens: str) -> list[str]:
    """Wrap raw QEMU argv tokens as run-qemu.sh `--qemu-arg` pairs.
    axl-emulate owns the QEMU device-token knowledge for the hardware
    fixture (run-qemu.sh stays a generic launcher), so HF artifacts are
    injected as `--qemu-arg <tok>` passthrough rather than dedicated
    run-qemu.sh flags. e.g. qarg("-smbios", "file=x") -> ["--qemu-arg",
    "-smbios", "--qemu-arg", "file=x"]."""
    out: list[str] = []
    for tok in tokens:
        out.extend(["--qemu-arg", tok])
    return out


def tpm_model_for(arch: str | None) -> str:
    """QEMU TPM device model by arch. tpm-tis is x86-only (ISA bus);
    aarch64's virt machine takes tpm-tis-device (sysbus MMIO)."""
    return "tpm-tis-device" if arch == "AARCH64" else "tpm-tis"


def locate_swtpm() -> str | None:
    """Find the swtpm binary (SWTPM= override, else PATH)."""
    override = os.environ.get("SWTPM")
    if override:
        return override if os.access(override, os.X_OK) else None
    return shutil.which("swtpm")


def spawn_swtpm(
    swtpm: str, state_dir: Path, sock: str, log: str
) -> subprocess.Popen[bytes]:
    """Start a socket-backed swtpm over @state_dir, serving its control
    interface on the unix socket @sock and writing diagnostics to @log
    (surfaced if it fails to come up). Caller waits for the socket and is
    responsible for teardown. Mirrors run-qemu.sh's prior lifecycle."""
    return subprocess.Popen(
        [
            swtpm, "socket",
            "--tpmstate", f"dir={state_dir}",
            "--ctrl", f"type=unixio,path={sock}",
            "--tpm2",
            "--flags", "startup-clear",
            "--log", f"file={log},level=1",
        ],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def _dump_file(path: str) -> None:
    """Echo a log file to stderr (best-effort) for failure diagnostics."""
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            sys.stderr.write(fh.read())
    except OSError:
        pass


def print_manifest_summary(manifest: dict[str, object]) -> None:
    """Print a one-line identity from the captured manifest so the
    user sees which machine the guest is impersonating. Tolerant
    of missing keys — older / hand-crafted fixtures may only have
    a subset."""
    fields = ("vendor", "model", "bios_rev", "capture_date")
    bits = [str(manifest[k]) for k in fields if manifest.get(k)]
    if bits:
        print(f"axl-emulate: replaying {' / '.join(bits)}", file=sys.stderr)


def build_run_qemu_args(
    fixture: Path,
    artifacts: Artifacts,
    arch: str | None,
    keep_acpi: set[str],
    extra_drop_acpi: set[str],
    strict_acpi: bool,
    replay_mac: bool,
    replay_cpu: bool,
    tpm_sock: str | None,
    tpm_model: str | None,
    efi_file: Path | None,
    pass_through: list[str],
) -> list[str]:
    """Translate the artifact manifest into a run-qemu.sh argv.
    Returns the full list of arguments (excluding the run-qemu.sh
    path itself) that will be exec'd."""
    args: list[str] = []

    if arch is not None:
        args.extend(["--arch", arch])

    # HF platform-identity injection is emitted as raw QEMU args via
    # run-qemu.sh's --qemu-arg passthrough — run-qemu.sh is a generic
    # launcher and does not know about fixtures (see the HF design doc's
    # 2026-06-08 architecture decision).
    if artifacts.smbios is not None:
        args += qarg("-smbios", f"file={artifacts.smbios}")

    warn_malformed_acpi(artifacts.acpi)
    denylist = (STRICT_DENYLIST if strict_acpi else DEFAULT_DENYLIST) | extra_drop_acpi
    kept, dropped = filter_acpi(artifacts.acpi, denylist, keep_acpi)
    for path in kept:
        args += qarg("-acpitable", f"file={path}")
    for path, sig in dropped:
        print(
            f"axl-emulate: dropping ACPI {sig} ({path.name}) — see design "
            f"doc §ACPI replay caveats; override with --keep-acpi {sig}",
            file=sys.stderr,
        )

    # SPD EEPROMs need the smbus-eeprom-with-memdev QEMU (x86-only chipset;
    # the patched build). On aarch64 there is no ICH/PIIX4 SMBus to attach
    # them to, so warn and skip rather than emit args QEMU will reject.
    if artifacts.spd:
        if arch == "AARCH64":
            print(
                f"WARN: skipping {len(artifacts.spd)} SPD blob(s) — SMBus "
                "EEPROM replay is x86-only",
                file=sys.stderr,
            )
        else:
            # smbus-eeprom,memdev= is only accepted by a QEMU built with
            # scripts/qemu-patches/0001-smbus-eeprom-add-memdev-link.patch;
            # stock QEMU rejects the property at realize time. We can't
            # probe here (run-qemu.sh owns QEMU discovery), so warn up-front.
            print(
                f"NOTE: wiring {len(artifacts.spd)} SPD EEPROM(s) — requires "
                "a QEMU with the smbus-eeprom memdev patch (QEMU_DIR=...)",
                file=sys.stderr,
            )
            for addr, blob in artifacts.spd:
                # id derives from the address so repeated blobs get
                # distinct memory-backend / device IDs.
                spd_id = f"axl_spd_{addr[2:] if addr.startswith('0x') else addr}"
                args += qarg(
                    "-object",
                    f"memory-backend-file,id={spd_id},mem-path={blob},"
                    "size=4096,share=off,readonly=on",
                    "-device",
                    f"smbus-eeprom,address={addr},memdev={spd_id}",
                )

    # HF4: replay the captured NIC hardware address. Opt-in (--mac),
    # because adding a NIC changes the guest's device tree and most
    # replays don't need one. QEMU takes a single --net NIC, so we wire
    # the first captured MAC and warn if the fixture had more.
    if replay_mac:
        if artifacts.nic_macs:
            args.extend(["--net", "--mac", artifacts.nic_macs[0]])
            if len(artifacts.nic_macs) > 1:
                print(
                    f"WARN: --mac: net.json has {len(artifacts.nic_macs)} NICs; "
                    f"wiring only the first ({artifacts.nic_macs[0]})",
                    file=sys.stderr,
                )
        else:
            print(
                "WARN: --mac requested but no usable MAC in net.json "
                "(missing/empty) — no NIC wired",
                file=sys.stderr,
            )

    # HF4: replay the captured CPU identity (cpu.json → -cpu override).
    if replay_cpu:
        if artifacts.cpu_spec is not None:
            args.extend(["--cpu", artifacts.cpu_spec])
        else:
            print(
                "WARN: --cpu-from-fixture requested but cpu.json had no "
                "usable identity — keeping the default CPU model",
                file=sys.stderr,
            )

    # TPM: axl-emulate spawns swtpm itself (see main) and wires QEMU's
    # emulator-backend TPM to its control socket via --qemu-arg. The
    # tpm/ subdir is the swtpm state dir (empty → clean PCRs; a populated
    # one is assumed already in NVChip format — HF5 scope).
    if artifacts.tpm_dir is not None and tpm_sock is not None:
        args += qarg(
            "-chardev", f"socket,id=axl_tpmsock,path={tpm_sock}",
            "-tpmdev", "emulator,id=axl_tpm,chardev=axl_tpmsock",
            "-device", f"{tpm_model},tpmdev=axl_tpm",
        )

    if efi_file is not None:
        args.append(str(efi_file))

    if pass_through:
        args.extend(pass_through)

    return args


def parse_argv(argv: list[str]) -> tuple[argparse.Namespace, list[str]]:
    """Parse argv with `--` as the pass-through separator. Anything
    after `--` is forwarded to run-qemu.sh verbatim, so axl-emulate
    composes with run-qemu.sh's existing knobs (--background, -i,
    --mount, --gdb, ...) without us having to mirror each one."""
    if "--" in argv:
        idx = argv.index("--")
        ours = argv[:idx]
        pass_through = argv[idx + 1 :]
    else:
        ours = argv
        pass_through = []

    parser = argparse.ArgumentParser(
        prog="axl-emulate",
        description=(
            "Replay a captured hardware fixture under QEMU by translating "
            "the fixture directory into run-qemu.sh primitives. "
            "Wrapper around scripts/run-qemu.sh — see "
            "docs/AXL-Hardware-Fixture-Design.md for the full design."
        ),
        epilog=(
            "Anything after `--` is passed through to run-qemu.sh, e.g.:\n"
            "  axl-emulate fixtures/proxmox-vm/ sysinfo.efi -- --background\n"
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "fixture_dir",
        nargs="?",
        help="Path to a fixture directory (smbios.bin, acpi/*.dat, ...).",
    )
    parser.add_argument(
        "efi_file",
        nargs="?",
        help="Optional .efi binary to run inside the guest.",
    )
    parser.add_argument(
        "--arch",
        choices=("X64", "AARCH64"),
        help="Target architecture (forwarded to run-qemu.sh).",
    )
    parser.add_argument(
        "--keep-acpi",
        action="append",
        default=[],
        metavar="NAME",
        help="Force-keep an ACPI table that the default denylist would drop. Repeatable.",
    )
    parser.add_argument(
        "--drop-acpi",
        action="append",
        default=[],
        metavar="NAME",
        help="Force-drop an ACPI table that the default denylist would keep. Repeatable.",
    )
    parser.add_argument(
        "--strict-acpi",
        action="store_true",
        help="Reduce the denylist to MCFG only (keep everything else, even SPCR/SRAT/...).",
    )
    parser.add_argument(
        "--mac",
        action="store_true",
        help="Replay the captured NIC hardware address from net.json "
             "(wires --net --mac on run-qemu.sh). HF4.",
    )
    parser.add_argument(
        "--cpu-from-fixture",
        action="store_true",
        help="Replay the captured CPU identity from cpu.json "
             "(wires --cpu on run-qemu.sh: x86 vendor/family/model, "
             "aarch64 MIDR). HF4.",
    )
    args = parser.parse_args(ours)

    if args.fixture_dir is None:
        parser.error("a fixture directory is required (try --help)")

    return args, pass_through


def main(argv: list[str]) -> int:
    args, pass_through = parse_argv(argv)

    fixture = Path(args.fixture_dir)
    if not fixture.is_dir():
        print(
            f"ERROR: fixture directory not found: {fixture}",
            file=sys.stderr,
        )
        return 1

    fixture = fixture.resolve()

    artifacts = discover_artifacts(fixture)
    if artifacts.manifest is not None:
        print_manifest_summary(artifacts.manifest)
        if args.arch:
            # Best-effort metadata-vs-arch consistency check: warn
            # rather than block, since fixture metadata is informational.
            arch_hint = artifacts.manifest.get("arch")
            if arch_hint and str(arch_hint).upper() != args.arch:
                print(
                    f"WARN: fixture metadata reports arch={arch_hint} but "
                    f"--arch {args.arch} requested — proceeding anyway",
                    file=sys.stderr,
                )

    efi_file: Path | None = None
    if args.efi_file is not None:
        efi_file = Path(args.efi_file)

    dryrun = os.environ.get("AXL_EMULATE_DRYRUN", "0") == "1"

    # TPM plan: when a tpm/ subdir is present we spawn swtpm and wire its
    # control socket into QEMU. Decide the socket path + model up front so
    # the QEMU args reference the same socket the daemon will create. Under
    # DRYRUN we use a placeholder path and never spawn.
    tpm_sock: str | None = None
    tpm_model: str | None = None
    tpm_sock_dir: str | None = None
    if artifacts.tpm_dir is not None:
        tpm_model = tpm_model_for(args.arch)
        if dryrun:
            tpm_sock = "/tmp/axl-emulate-swtpm.sock"
        else:
            tpm_sock_dir = tempfile.mkdtemp(prefix="axl-emulate-tpm-")
            tpm_sock = os.path.join(tpm_sock_dir, "swtpm-ctrl")

    run_qemu_args = build_run_qemu_args(
        fixture=fixture,
        artifacts=artifacts,
        arch=args.arch,
        keep_acpi={s.upper() for s in args.keep_acpi},
        extra_drop_acpi={s.upper() for s in args.drop_acpi},
        strict_acpi=args.strict_acpi,
        replay_mac=args.mac,
        replay_cpu=args.cpu_from_fixture,
        tpm_sock=tpm_sock,
        tpm_model=tpm_model,
        efi_file=efi_file,
        pass_through=pass_through,
    )

    # Locate run-qemu.sh next to ourselves.
    here = Path(__file__).resolve().parent
    run_qemu = here / "run-qemu.sh"
    if not run_qemu.is_file():
        print(
            f"ERROR: run-qemu.sh not found alongside axl-emulate: {run_qemu}",
            file=sys.stderr,
        )
        return 1

    cmd = [str(run_qemu), *run_qemu_args]

    # AXL_EMULATE_DRYRUN=1 mirrors run-qemu.sh's QEMU_DRYRUN
    # convention: print the constructed argv (one token per line,
    # prefixed with "AXL_EMULATE_DRYRUN: ") and exit without
    # running. Useful for tests and for "what would axl-emulate
    # actually run?" debugging.
    if dryrun:
        for token in cmd:
            print(f"AXL_EMULATE_DRYRUN: {token}")
        return 0

    # No TPM → exec run-qemu.sh directly (no wrapper process needed).
    if artifacts.tpm_dir is None:
        os.execv(str(run_qemu), cmd)
        return 1  # unreachable

    # TPM → spawn swtpm, run run-qemu.sh as a child so we can tear the
    # daemon down afterwards (can't exec — we'd lose the cleanup hook).
    swtpm = locate_swtpm()
    if swtpm is None:
        print(
            "ERROR: fixture has a tpm/ dir but swtpm was not found "
            "(install swtpm, or set SWTPM=/path/to/swtpm)",
            file=sys.stderr,
        )
        if tpm_sock_dir is not None:
            shutil.rmtree(tpm_sock_dir, ignore_errors=True)
        return 1
    assert tpm_sock is not None and tpm_sock_dir is not None  # set with tpm_dir
    swtpm_log = os.path.join(tpm_sock_dir, "swtpm.log")
    proc: subprocess.Popen[bytes] | None = None
    try:
        proc = spawn_swtpm(swtpm, artifacts.tpm_dir, tpm_sock, swtpm_log)
        # Wait for swtpm to create its control socket (~30 ms typical).
        deadline = time.monotonic() + 5.0
        while not os.path.exists(tpm_sock) and time.monotonic() < deadline:
            if proc.poll() is not None:
                print("ERROR: swtpm exited before creating its socket:",
                      file=sys.stderr)
                _dump_file(swtpm_log)
                return 1
            time.sleep(0.05)
        if not os.path.exists(tpm_sock):
            print(f"ERROR: swtpm did not create {tpm_sock} in time:",
                  file=sys.stderr)
            _dump_file(swtpm_log)
            return 1
        return subprocess.run(cmd).returncode
    finally:
        if proc is not None:
            proc.terminate()
            try:
                proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                proc.kill()
        shutil.rmtree(tpm_sock_dir, ignore_errors=True)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

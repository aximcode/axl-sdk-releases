// uefi-manifest.json5
//
// Manifest of UEFI / PI / ACPI definitions to extract from spec HTML
// and emit into include/uefi/generated/. Consumed by
// scripts/generate-uefi-headers.py.
//
// Syntax is JSON5-lite: stdlib JSON plus // and /* */ comments and
// trailing commas. No other JSON5 extensions (single quotes,
// unquoted keys, etc.) are supported — see _strip_json5() in the
// generator for the exact grammar.
//
// Rules:
//   - Keys are output filenames under include/uefi/generated/.
//   - Order within each file IS the emit order IS the dependency
//     order. Function-pointer typedefs MUST appear before the
//     protocol struct that uses them as members.
//   - "kind" is one of: struct, enum, funcptr, define, typedef,
//     union, table. "table" pulls the scalar typedef out of the
//     UEFI spec's Table 2-4 (Common UEFI Data Types) rather than
//     a <pre> block.
//   - Unknown struct members in extracted types are automatically
//     rewritten to `void *`, so you can add a type referencing a
//     UEFI struct we haven't pulled in yet and it will still
//     compile. Running `generate-uefi-headers.py --check src/ ...`
//     warns about genuinely missing types.

{
  "types.h": [
    {"name": "BOOLEAN",                       "kind": "table"},
    {"name": "INT8",                          "kind": "table"},
    {"name": "INT16",                         "kind": "table"},
    {"name": "INT32",                         "kind": "table"},
    {"name": "INT64",                         "kind": "table"},
    {"name": "UINT8",                         "kind": "table"},
    {"name": "UINT16",                        "kind": "table"},
    {"name": "UINT32",                        "kind": "table"},
    {"name": "UINT64",                        "kind": "table"},
    {"name": "CHAR8",                         "kind": "table"},
    {"name": "CHAR16",                        "kind": "table"},
    {"name": "UINTN",                         "kind": "table"},
    {"name": "INTN",                          "kind": "table"},

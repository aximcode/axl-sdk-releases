    {"name": "EFI_DHCP4_TRANSMIT_RECEIVE",          "kind": "funcptr"},
    {"name": "EFI_DHCP4_PARSE",                     "kind": "funcptr"},
    {"name": "EFI_DHCP4_PROTOCOL",                  "kind": "struct"},

    // PXE Base Code — last-resort DHCP fallback (axl_net IP4Config2-free
    // bring-up ladder). Only Start/Dhcp/Stop + Mode->{Started,UsingIpv6,
    // StationIp,SubnetMask} are used; the MODE struct's complex packet/cache
    // tail is void*-substituted (harmless — the fields read precede it), and
    // the unused protocol funcptrs (Discover/Mtftp/...) stay void* too.
    {"name": "EFI_PXE_BASE_CODE_MAX_ARP_ENTRIES",   "kind": "define"},
    {"name": "EFI_PXE_BASE_CODE_MAX_ROUTE_ENTRIES", "kind": "define"},
    {"name": "EFI_PXE_BASE_CODE_MODE",              "kind": "struct"},
    {"name": "EFI_PXE_BASE_CODE_START",             "kind": "funcptr"},
    {"name": "EFI_PXE_BASE_CODE_STOP",              "kind": "funcptr"},
    {"name": "EFI_PXE_BASE_CODE_DHCP",              "kind": "funcptr"},
    {"name": "EFI_PXE_BASE_CODE_PROTOCOL",          "kind": "struct"},

    {"name": "EFI_UDP4_SESSION_DATA",               "kind": "struct"},
    {"name": "EFI_UDP4_FRAGMENT_DATA",               "kind": "struct"},
    {"name": "EFI_UDP4_RECEIVE_DATA",                "kind": "struct"},
    {"name": "EFI_UDP4_TRANSMIT_DATA",               "kind": "struct"},
    {"name": "EFI_UDP4_CONFIG_DATA",                 "kind": "struct"},
    {"name": "EFI_UDP4_COMPLETION_TOKEN",            "kind": "struct"},
    {"name": "EFI_UDP4_GET_MODE_DATA",               "kind": "funcptr"},
    {"name": "EFI_UDP4_CONFIGURE",                   "kind": "funcptr"},
    {"name": "EFI_UDP4_GROUPS",                      "kind": "funcptr"},
    {"name": "EFI_UDP4_ROUTES",                      "kind": "funcptr"},
    {"name": "EFI_UDP4_TRANSMIT",                    "kind": "funcptr"},
    {"name": "EFI_UDP4_RECEIVE",                     "kind": "funcptr"},
    {"name": "EFI_UDP4_CANCEL",                      "kind": "funcptr"},
    {"name": "EFI_UDP4_POLL",                        "kind": "funcptr"},
    {"name": "EFI_UDP4_PROTOCOL",                    "kind": "struct"}
  ],

  "driver-model.h": [
    {"name": "EFI_DRIVER_BINDING_PROTOCOL_SUPPORTED", "kind": "funcptr"},
    {"name": "EFI_DRIVER_BINDING_PROTOCOL_START",     "kind": "funcptr"},
    {"name": "EFI_DRIVER_BINDING_PROTOCOL_STOP",      "kind": "funcptr"},
    {"name": "EFI_DRIVER_BINDING_PROTOCOL",            "kind": "struct"},
    // Component Name 2 — the driver-name protocol AXL installs alongside the
    // binding (the `name` field). The GET_*_NAME funcptrs are shared v1/v2.
    {"name": "EFI_COMPONENT_NAME_GET_DRIVER_NAME",     "kind": "funcptr"},
    {"name": "EFI_COMPONENT_NAME_GET_CONTROLLER_NAME", "kind": "funcptr"},
    {"name": "EFI_COMPONENT_NAME2_PROTOCOL",           "kind": "struct"}
  ],

  "mp-services.h": [
    {"name": "EFI_AP_PROCEDURE",              "kind": "funcptr"},
    {"name": "EFI_CPU_PHYSICAL_LOCATION",     "kind": "struct"},
    {"name": "EFI_CPU_PHYSICAL_LOCATION2",    "kind": "struct"},
    {"name": "PROCESSOR_AS_BSP_BIT",          "kind": "define"},
    {"name": "PROCESSOR_ENABLED_BIT",         "kind": "define"},
    {"name": "PROCESSOR_HEALTH_STATUS_BIT",   "kind": "define"},
    // ExtendedInformation member of EFI_PROCESSOR_INFORMATION. Declaring
    // it gives the struct its full firmware footprint: GetProcessorInfo
    // writes the whole struct, so an undersized one overflows the
    // caller's buffer.
    {"name": "EXTENDED_PROCESSOR_INFORMATION", "kind": "union"},
    {"name": "EFI_PROCESSOR_INFORMATION",     "kind": "struct"},
    {"name": "EFI_MP_SERVICES_GET_NUMBER_OF_PROCESSORS", "kind": "funcptr"},
    {"name": "EFI_MP_SERVICES_GET_PROCESSOR_INFO", "kind": "funcptr"},
    {"name": "EFI_MP_SERVICES_STARTUP_ALL_APS", "kind": "funcptr"},
    {"name": "EFI_MP_SERVICES_STARTUP_THIS_AP", "kind": "funcptr"},
    {"name": "EFI_MP_SERVICES_SWITCH_BSP",    "kind": "funcptr"},
    {"name": "EFI_MP_SERVICES_ENABLEDISABLEAP", "kind": "funcptr"},
    {"name": "EFI_MP_SERVICES_WHOAMI",        "kind": "funcptr"},
    {"name": "EFI_MP_SERVICES_PROTOCOL",      "kind": "struct"}
  ],

  // PI DXE Services — the GCD (Global Coherency Domain) memory-space map.
  // Used by AxlMemRegion to classify the full physical address space
  // (MMIO / non-existent ranges the EFI memory map omits). The DXE_SERVICES
  // table is reached via gEfiDxeServicesTableGuid in the EFI config table
  // (the GUID itself is hand-defined in axl-uefi-extra.h — its spec macro
  // uses a flat initializer the GUID auto-extractor doesn't match).
  "dxe-services.h": [
    {"name": "EFI_GCD_MEMORY_TYPE",             "kind": "enum"},
    {"name": "EFI_GCD_MEMORY_SPACE_DESCRIPTOR", "kind": "struct"},
    {"name": "EFI_GET_MEMORY_SPACE_MAP",        "kind": "funcptr"},
    {"name": "EFI_GCD_IO_TYPE",                 "kind": "enum"},
    {"name": "EFI_GCD_IO_SPACE_DESCRIPTOR",     "kind": "struct"},
    {"name": "EFI_GET_IO_SPACE_MAP",            "kind": "funcptr"},
    {"name": "DXE_SERVICES",                    "kind": "struct"}
  ],

  "smbios.h": [
    {"name": "EFI_SMBIOS_TYPE",              "kind": "typedef"},
    {"name": "EFI_SMBIOS_HANDLE",            "kind": "typedef"},
    {"name": "EFI_SMBIOS_TABLE_HEADER",      "kind": "struct"},
    {"name": "EFI_SMBIOS_ADD",               "kind": "funcptr"},
    {"name": "EFI_SMBIOS_UPDATE_STRING",     "kind": "funcptr"},
    {"name": "EFI_SMBIOS_REMOVE",            "kind": "funcptr"},
    {"name": "EFI_SMBIOS_GET_NEXT",          "kind": "funcptr"},
    {"name": "EFI_SMBIOS_PROTOCOL",          "kind": "struct"}
  ],

  // SMBus host controller — used by AxlIpmi for the SSIF transport
  // (primary backend) and later by AxlSpd for DIMM SPD reads.
  "smbus.h": [
    {"name": "EFI_SMBUS_DEVICE_ADDRESS",              "kind": "struct"},
    {"name": "EFI_SMBUS_DEVICE_COMMAND",              "kind": "typedef"},
    {"name": "EFI_SMBUS_OPERATION",                   "kind": "enum"},
    {"name": "EFI_SMBUS_UDID",                        "kind": "struct"},
    {"name": "EFI_SMBUS_DEVICE_MAP",                  "kind": "struct"},
    {"name": "EFI_SMBUS_NOTIFY_FUNCTION",             "kind": "funcptr"},
    {"name": "EFI_SMBUS_HC_EXECUTE_OPERATION",        "kind": "funcptr"},
    {"name": "EFI_SMBUS_HC_PROTOCOL_ARP_DEVICE",      "kind": "funcptr"},
    {"name": "EFI_SMBUS_HC_PROTOCOL_GET_ARP_MAP",     "kind": "funcptr"},
    {"name": "EFI_SMBUS_HC_PROTOCOL_NOTIFY",          "kind": "funcptr"},
    {"name": "EFI_SMBUS_HC_PROTOCOL",                 "kind": "struct"}
  ],

  // I2C master protocol — used by AxlIpmi for the SSIF transport
  // fallback when EFI_SMBUS_HC_PROTOCOL isn't present on the
  // platform (matches uefi-ipmitool's dual-backend behavior).
  "i2c.h": [
    {"name": "I2C_FLAG_READ",                          "kind": "define"},
    {"name": "I2C_ADDRESSING_10_BIT",                  "kind": "define"},
    {"name": "EFI_I2C_OPERATION",                      "kind": "struct"},
    {"name": "EFI_I2C_REQUEST_PACKET",                 "kind": "struct"},
    {"name": "EFI_I2C_MASTER_PROTOCOL_SET_BUS_FREQUENCY", "kind": "funcptr"},
    {"name": "EFI_I2C_MASTER_PROTOCOL_RESET",          "kind": "funcptr"},
    {"name": "EFI_I2C_MASTER_PROTOCOL_START_REQUEST",  "kind": "funcptr"},
    {"name": "EFI_I2C_MASTER_PROTOCOL",                "kind": "struct"}
  ],

  "cpu-arch.h": [
    {"name": "EFI_EXCEPTION_TYPE",                  "kind": "typedef"},
    {"name": "EXCEPT_X64_DIVIDE_ERROR",             "kind": "define"},
    {"name": "EXCEPT_X64_DEBUG",                    "kind": "define"},
    {"name": "EXCEPT_X64_NMI",                      "kind": "define"},
    {"name": "EXCEPT_X64_BREAKPOINT",               "kind": "define"},
    {"name": "EXCEPT_X64_OVERFLOW",                 "kind": "define"},
    {"name": "EXCEPT_X64_BOUND",                    "kind": "define"},
    {"name": "EXCEPT_X64_INVALID_OPCODE",           "kind": "define"},
    {"name": "EXCEPT_X64_DOUBLE_FAULT",             "kind": "define"},
    {"name": "EXCEPT_X64_INVALID_TSS",              "kind": "define"},
    {"name": "EXCEPT_X64_SEG_NOT_PRESENT",          "kind": "define"},
    {"name": "EXCEPT_X64_STACK_FAULT",              "kind": "define"},
    {"name": "EXCEPT_X64_GP_FAULT",                 "kind": "define"},
    {"name": "EXCEPT_X64_PAGE_FAULT",               "kind": "define"},
    {"name": "EXCEPT_X64_FP_ERROR",                 "kind": "define"},
    {"name": "EXCEPT_X64_ALIGNMENT_CHECK",          "kind": "define"},
    {"name": "EXCEPT_X64_MACHINE_CHECK",            "kind": "define"},
    {"name": "EXCEPT_X64_SIMD",                     "kind": "define"},
    {"name": "EXCEPT_AARCH64_SYNCHRONOUS_EXCEPTIONS", "kind": "define"},
    {"name": "EXCEPT_AARCH64_IRQ",                  "kind": "define"},
    {"name": "EXCEPT_AARCH64_FIQ",                  "kind": "define"},
    {"name": "EXCEPT_AARCH64_SERROR",               "kind": "define"},
    {"name": "MAX_AARCH64_EXCEPTION",               "kind": "define"},
    // MUST precede EFI_SYSTEM_CONTEXT_X64: it is an INLINE 512-byte member of
    // it, not a pointer. Without an entry here the generator substituted
    // `void *FxSaveState`, which put every later field -- Rip, Rsp, Rbp and
    // every GPR -- 504 bytes early, so axl_cpu_register_exception() handed
    // consumers a garbage instruction pointer, zeroed registers and a zero
    // frame pointer that yielded NO backtrace at all.
    {"name": "EFI_FX_SAVE_STATE_X64",              "kind": "struct"},
    {"name": "EFI_SYSTEM_CONTEXT_X64",              "kind": "struct"},
    {"name": "EFI_SYSTEM_CONTEXT_AARCH64",          "kind": "struct"},
    {"name": "EFI_SYSTEM_CONTEXT",                  "kind": "union"},
    {"name": "EFI_CPU_INIT_TYPE",                   "kind": "enum"},
    {"name": "EFI_CPU_INTERRUPT_HANDLER",           "kind": "funcptr"},
    {"name": "EFI_CPU_FLUSH_DATA_CACHE",            "kind": "funcptr"},
    {"name": "EFI_CPU_ENABLE_INTERRUPT",            "kind": "funcptr"},
    {"name": "EFI_CPU_DISABLE_INTERRUPT",           "kind": "funcptr"},
    {"name": "EFI_CPU_GET_INTERRUPT_STATE",         "kind": "funcptr"},
    {"name": "EFI_CPU_INIT",                        "kind": "funcptr"},
    {"name": "EFI_CPU_REGISTER_INTERRUPT_HANDLER",  "kind": "funcptr"},
    {"name": "EFI_CPU_GET_TIMER_VALUE",             "kind": "funcptr"},
    {"name": "EFI_CPU_SET_MEMORY_ATTRIBUTES",       "kind": "funcptr"},
    {"name": "EFI_CPU_ARCH_PROTOCOL",               "kind": "struct"}
  ]

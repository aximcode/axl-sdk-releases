    {"name": "EFI_DHCP4_PACKET_OPTION",             "kind": "struct"},
    {"name": "EFI_DHCP4_HEADER",                    "kind": "struct"},
    {"name": "EFI_DHCP4_PACKET",                    "kind": "struct"},
    {"name": "EFI_DHCP4_STATE",                     "kind": "enum"},
    {"name": "EFI_DHCP4_CONFIG_DATA",               "kind": "struct"},
    {"name": "EFI_DHCP4_MODE_DATA",                 "kind": "struct"},
    {"name": "EFI_DHCP4_GET_MODE_DATA",             "kind": "funcptr"},
    {"name": "EFI_DHCP4_CONFIGURE",                 "kind": "funcptr"},
    {"name": "EFI_DHCP4_START",                     "kind": "funcptr"},
    {"name": "EFI_DHCP4_RENEW_REBIND",              "kind": "funcptr"},
    {"name": "EFI_DHCP4_RELEASE",                   "kind": "funcptr"},
    {"name": "EFI_DHCP4_STOP",                      "kind": "funcptr"},

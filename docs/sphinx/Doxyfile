# Doxyfile for AXL SDK — XML-only output for Sphinx/Breathe
#
# Run from docs/sphinx/:  doxygen Doxyfile

PROJECT_NAME           = "AXL"
PROJECT_BRIEF          = "AximCode Library for UEFI"

# Input
INPUT                  = ../../include/axl
FILE_PATTERNS          = *.h *.hpp
RECURSIVE              = NO
EXCLUDE_PATTERNS       = *-impl.h

# What to extract
EXTRACT_ALL            = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = YES
HIDE_UNDOC_CLASSES     = YES

# C-specific
OPTIMIZE_OUTPUT_FOR_C  = YES
TYPEDEF_HIDES_STRUCT   = YES

# Input filter: strips file-level doc comments (the .rst provides
# intros) and replaces allocation #define macros with typed function
# prototypes so Doxygen renders proper C types.
INPUT_FILTER           = ./doxy-filter.sh

# Preprocessing — expand all macros (AXL_WARN_UNUSED etc.)
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
# AXL_CB_NOEXCEPT is stripped like the other decorators: Breathe hands the
# typedef to Sphinx's C domain, which cannot parse a trailing token after
# the parameter list and emits "Invalid C declaration" for every callback
# that carries it. The contract is documented in prose on the macro itself.
# AXL_DEFINE_NO_HANDLE and the trait emitter are stripped for the same reason:
# left in place Doxygen treats the invocation as part of the declaration that
# FOLLOWS it, so `axl_json_reader_error` and `axl_gfx_buffer_new` arrived at
# Sphinx with a macro call glued to the front and failed to parse. The C++
# ownership rules they express are documented in prose on modules/cxx-handle.
PREDEFINED             = EFIAPI= \
                         __attribute__(x)= \
                         AXL_WARN_UNUSED= \
                         AXL_NORETURN= \
                         AXL_CB_NOEXCEPT= \
                         AXL_DEFINE_NO_HANDLE(x,y)= \
                         AXL_HANDLE_TRAITS_(x,y)=

# Output — XML only (Breathe consumes this)
GENERATE_XML           = YES
XML_OUTPUT             = ../../out/docs/doxygen-xml
XML_PROGRAMLISTING     = YES

GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO

# Exclude internal macros from output
EXCLUDE_SYMBOLS        = AXL_WARN_UNUSED \
                         AXL_NORETURN

# Misc
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_NO_PARAMDOC       = NO
# Zero-warning gate. check-doc-coverage.py catches a header with no
# doxygenfile directive; it cannot see a dangling \ref, a half-documented
# parameter list, or a malformed code span. Those accumulated to 27
# distinct warnings precisely because nothing failed on them.
# FAIL_ON_WARNINGS reports every warning, then exits non-zero.
WARN_AS_ERROR          = FAIL_ON_WARNINGS
SORT_MEMBER_DOCS       = NO
SHOW_INCLUDE_FILES     = NO
FULL_PATH_NAMES        = NO

# Graphs are for the HTML output, which is OFF here (GENERATE_XML only) — but
# doxygen still evaluates the graph limits and reports an ERROR when a header's
# included-by graph exceeds DOT_GRAPH_MAX_NODES. axl-macros.h is included by
# 126 headers, well past the default 50, so the CI docs build failed on a graph
# nothing renders. Raise the ceiling rather than chase the count: this is a
# generated artefact of an umbrella-style public API, not a defect.
DOT_GRAPH_MAX_NODES    = 500

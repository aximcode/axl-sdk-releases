# clangd project config. See https://clangd.llvm.org/config.
#
# AXL intentionally includes umbrella headers like axl-backend.h even
# when the direct .c file only uses types that arrive transitively —
# the include documents the dependency and keeps the .c file self-
# contained if transitive chains change. Disable the include-cleaner
# diagnostics so clangd stops flagging those as unused or missing.
Diagnostics:
  UnusedIncludes: None
  MissingIncludes: None

# Provide the project's -I paths to clangd as a baseline so newly-
# added headers without a parent .c entry in compile_commands.json
# still resolve <axl/...> + <src/backend/...> + deps/* includes.
# Mirrors the INCLUDES variable in Makefile (line 192) plus the TLS
# / net additions (line 199-201). Safe to apply globally — these
# paths don't conflict with any other file group; clangd merges
# them with whatever compile_commands.json provides.
CompileFlags:
  Add:
    - -Iinclude
    - -Isrc/backend
    - -Ideps/mbedtls/include
    - -Isrc/net
    - -Iinclude/compat

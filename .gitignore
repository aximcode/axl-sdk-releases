Build/
Conf/
build/
out/
# Stray SDK staging when install.sh is run with --prefix . (default is ./out).
# Root-anchored so real source dirs (include/axl/, share/*.json5) are unaffected.
/bin/
/lib/
/include/axl-sdk/
/share/axl/
deps/*
!deps/lzma
!deps/mbedtls
!deps/stb
!deps/freetype
!deps/sdefl
!deps/libvterm
*.pyc
__pycache__/
# Per-configuration ratchet baselines. The default (no AXL_TLS) baseline at
# test/integration/.last-pass-count IS tracked -- it is the shared gate. The
# AXL_TLS variant is a local artifact of a non-default build, so it is not.
test/integration/.last-pass-count.tls
*.o
*.dll
*.map
*.efi
# Vendored EDK2 binaries embedded into mkrd.efi at build time —
# tracked despite the *.efi blanket rule above.
!third_party/edk2/*.efi
*.lib
.playwright-mcp/
.wrangler/
.cache/
compile_commands.json
# ctags / etags indexes — per-developer, regenerated on demand
tags
TAGS
*.imp
SCRATCH.md
.vscode/
.env
.envrc
.env.*
.claude/settings.local.json
# Hardware-fixture captures (HF1+) — machine-specific, often contain
# identifying data (serials, MACs, OEM strings). Local-only by default;
# sanitization + public corpus is HF10's scope.
test/fixtures/

# Real-hardware capture data (not for distribution)
DellXE7745/

# Session handoff docs — working notes, not part of the published repo
docs/handoffs/

# Local-only docs (lab access, credentials-adjacent notes) — not distributable
local/
test/integration/.last-pass-count.tls

# libFuzzer artifacts. The seed corpora are hand-written and tracked;
# anything the fuzzer discovers or crashes on is not.
test/fuzz/crash-*
test/fuzz/leak-*
test/fuzz/oom-*
test/fuzz/timeout-*

# libFuzzer artifacts from a harness run started outside test/fuzz. The gate
# passes -artifact_prefix so its own failures land in test/fuzz/, but a manual
# run from the repo root drops them HERE, where `git add -A` would sweep them
# into a commit.
/crash-*
/leak-*
/timeout-*
/oom-*
/slow-unit-*

# Toolchain build artefacts — the recipe is tracked, the output is not.
toolchain/*/work/
toolchain/*/out/
toolchain/*/build.log
